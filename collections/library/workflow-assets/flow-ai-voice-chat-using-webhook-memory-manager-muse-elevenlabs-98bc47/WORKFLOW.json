{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-ai-voice-chat-using-webhook-memory-manager-muse-elevenlabs-98bc47",
  "title": "AI Voice Chat using Webhook, Memory Manager, Muse & ElevenLabs",
  "nodes": [
    {
      "id": "step-1",
      "label": "Get Chat",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Insert Chat",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "mode": "insert",
        "messages": {
          "messageValues": [
            {
              "type": "user",
              "message": {
                "expression": "{{ steps[\"step-11\"].record[\"text\"] }}"
              }
            },
            {
              "type": "ai",
              "message": {
                "expression": "{{ record.text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "context"
      }
    },
    {
      "id": "step-4",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "configuration_input": "step-4-sessionkey"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-5",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Respond to Webhook",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "options": {},
        "respondWith": "binary"
      }
    },
    {
      "id": "step-7",
      "label": "ElevenLabs - Generate Audio",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.elevenlabs.io/v1/text-to-speech/{{voice id}}"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": {
                "expression": "{{ steps[\"step-9\"].record.text }}"
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Limit",
      "operation": "limit",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-9",
      "label": "Basic LLM Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ steps[\"step-11\"].record[\"text\"] }}"
        },
        "messages": {
          "messageValues": [
            {
              "type": "AIMessagePromptTemplate",
              "message": {
                "expression": "To maintain context and fully understand the user's question, always review the previous conversation between you and him before providing an answer.\nThis is the previous conversation:\n{{ steps[\"step-3\"].record[\"context\"].map(m => `\nHuman: ${m.human || 'undefined'}\nAI Assistant: ${m.ai || 'undefined'}\n`).join('') }}"
              }
            }
          ]
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-10",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "voice_message",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "step-11",
      "label": "Model - Speech to Text",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": "voice_message"
      }
    }
  ],
