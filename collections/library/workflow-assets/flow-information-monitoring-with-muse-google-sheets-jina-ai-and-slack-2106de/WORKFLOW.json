              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "RSS Read",
      "operation": "service-read",
      "adapter": "rssfeedread",
      "parameters": {
        "url": {
          "expression": "{{ record.rss_feed_url }}"
        },
        "options": {
          "ignoreSSL": false
        }
      }
    },
    {
      "id": "step-5",
      "label": "Relevance Classification for Topic Monitoring",
      "operation": "classify",
      "adapter": "model",
      "parameters": {
        "options": {
          "fallback": "discard"
        },
        "inputText": {
          "expression": "{{ record.title }}\n{{ record.contentSnippet }}"
        },
        "categories": {
          "categories": [
            {
              "category": "relevant",
              "description": "Articles related to artificial intelligence (AI), data science, machine learning, algorithms, big data, or innovations in these fields."
            },
            {
              "category": "not_relevant",
              "description": "Articles not directly related to artificial intelligence (AI), data science, machine learning, algorithms, big data, or innovations in these fields."
            }
          ]
        }
      }
    },
    {
