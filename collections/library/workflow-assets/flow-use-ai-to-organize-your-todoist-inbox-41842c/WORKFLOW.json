{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-use-ai-to-organize-your-todoist-inbox-41842c",
  "title": "Use AI to organize your Todoist Inbox",
  "nodes": [
    {
      "id": "step-1",
      "label": "Update priority in todoist",
      "operation": "service-write",
      "adapter": "todoist",
      "parameters": {
        "taskId": {
          "expression": "{{ steps[\"step-3\"].record.id }}"
        },
        "operation": "update",
        "updateFields": {
          "priority": {
            "expression": "{{ steps[\"step-4\"].records[0].projects[record.message.content] }}"
          }
        }
      }
    },
    {
      "id": "step-2",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {}
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Get inbox tasks",
      "operation": "service-read",
      "adapter": "todoist",
      "parameters": {
        "filters": {
          "projectId": {
            "configuration_input": "step-3-filters-projectid"
          }
        },
        "operation": "getAll",
        "returnAll": true
      }
    },
    {
      "id": "step-4",
      "label": "Your Projects",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "projects",
              "type": "object",
              "value": {
                "expression": "{{ {\n apartment: 1,\n health: 2,\n german: 3\n} }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Categorize",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-5-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": {
                "expression": "Categorize the user's todo item to a project. Return the project name or just \"other\" if it does not belong to a project."
              }
            },
            {
              "content": {
                "expression": "Projects:\n{{ steps[\"step-4\"].records[0].projects.keys().join('\\n') }}\n\nTodo item:\n{{ steps[\"step-3\"].record.content }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "If task is not a subtask",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.parent_id }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "If other or ai hallucinates",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "array",
                "operation": "contains",
                "rightType": "any"
              },
              "leftValue": {
                "expression": "{{ steps[\"step-4\"].records[0].projects.keys() }}"
              },
              "rightValue": {
                "expression": "{{ record.message.content }}"
              }
            }
          ]
        }
      }
    }
  ],
