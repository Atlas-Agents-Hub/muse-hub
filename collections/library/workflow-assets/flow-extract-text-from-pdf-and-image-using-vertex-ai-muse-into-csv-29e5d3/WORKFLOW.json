{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-extract-text-from-pdf-and-image-using-vertex-ai-muse-into-csv-29e5d3",
  "title": "Extract text from PDF and image using Vertex AI (Gemini) into CSV",
  "nodes": [
    {
      "id": "step-1",
      "label": "Google Gemini Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-2",
      "label": "Get PDF or Images",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "configuration_input": "step-2-foldertowatch"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Route based on PDF or Image",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "application/pdf",
              "outputKey": "pdf"
            },
            {
              "value2": "image/",
              "operation": "contains",
              "outputKey": "image"
            }
          ]
        },
        "value1": {
          "expression": "{{record.mimeType}}"
        },
        "dataType": "string"
      }
    },
    {
      "id": "step-4",
      "label": "Download PDF",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ steps[\"step-2\"].record.id }}"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-5",
      "label": "Download Image",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ steps[\"step-2\"].record.id }}"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-6",
      "label": "Extract data from PDF",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "pdf"
      }
    },
    {
      "id": "step-7",
      "label": "Send data to A.I.",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-7-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"model\": \"meta-llama/llama-3.1-70b-instruct:free\",\n \"messages\": [\n {\n \"role\": \"user\",\n \"content\": \"You are given a bank statement.{{encodeURIComponent(record.text)}}. Read the PDF and export all the transactions as CSV. Add a column called category and based on the information assign a category name. Return only the CSV data starting with the header row.\"\n }\n ]\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-8",
      "label": "Convert to CSV",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Upload to Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "name": {
          "expression": "{{current_date}}"
        },
        "driveId": {
          "configuration_input": "step-9-driveid"
        },
        "options": {},
        "folderId": {
          "configuration_input": "step-9-folderid"
        }
      }
    },
    {
      "id": "step-10",
      "label": "Convert to CSV2",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Upload to Google Drive1",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "name": {
          "expression": "{{current_date}}"
        },
        "driveId": {
          "configuration_input": "step-11-driveid"
        },
        "options": {},
        "folderId": {
          "configuration_input": "step-11-folderid"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Vertex A.I. extract text",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Extract the transactions from the image"
        },
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "You are given a screenshot of payment transactions. Read the image and export all the transactions as CSV. Add a column called category and based on the information assign a category name. Return only the CSV data starting with the header row."
              }
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    }
  ],
