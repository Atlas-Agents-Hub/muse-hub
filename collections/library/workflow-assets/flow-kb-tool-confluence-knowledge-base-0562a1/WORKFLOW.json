            {
              "name": "response",
              "type": "string",
              "value": {
                "expression": "\"Title\": \"{{ record.results[0].content.title }}\"\n\"Link\": \"{{ record._links.base }}{{ record.results[0].content._links.webui }}\"\n\"Content\": {{ record[\"results\"][0][\"excerpt\"] }}\nWhen users request the password, make sure to send them the link above to reset it in markdown."
