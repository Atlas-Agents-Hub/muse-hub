{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-telegram-to-spotify-86fa4d",
  "title": "Telegram to Spotify with OpenAI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "OpenAI - Ask about a track",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-2-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "get artist and song name from '{{ record.message.text }}'. Reply only eg. 'track:song name artist:artist name'"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Search track",
      "operation": "service-read",
      "adapter": "spotify",
      "parameters": {
        "limit": 1,
        "query": {
          "expression": "{{ record.message.content }}"
        },
        "filters": {},
        "resource": "track",
        "operation": "search"
      }
    },
    {
      "id": "step-4",
      "label": "Add song",
      "operation": "service-read",
      "adapter": "spotify",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Next Song",
      "operation": "service-read",
      "adapter": "spotify",
      "parameters": {
        "operation": "nextSong"
      }
    },
    {
      "id": "step-6",
      "label": "Resume play",
      "operation": "service-read",
      "adapter": "spotify",
      "parameters": {
        "operation": "resume"
      }
    },
    {
      "id": "step-7",
      "label": "Currently Playing",
      "operation": "service-read",
      "adapter": "spotify",
      "parameters": {
        "operation": "currentlyPlaying"
      }
    },
    {
      "id": "step-8",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineAll"
      }
    },
    {
      "id": "step-9",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record?.id }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Message parser",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "message",
              "type": "string",
              "value": {
                "expression": "{{ record.error }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Not found error message",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "json": {
            "error": "Song not found"
          }
        }
      }
    },
    {
      "id": "step-12",
      "label": "Return message to Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ steps[\"step-10\"].record.message }}"
        },
        "chatId": {
          "expression": "{{ record.message.chat.id }}"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-13",
      "label": "Define Now Playing",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{\n \"error\": \"Now playing {{ record.item.name }} - {{ record.item.artists[0].name }} - {{ record.item.album.name }}\"\n}"
        }
      }
    }
  ],
