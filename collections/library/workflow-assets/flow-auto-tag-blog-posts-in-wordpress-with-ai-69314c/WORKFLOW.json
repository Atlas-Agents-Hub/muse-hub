        "queryParameters": {
          "parameters": [
            {
              "name": "slug",
              "value": {
                "expression": "{{ record.missing_tag }}"
              }
            },
            {
              "name": "name",
              "value": {
                "expression": "{{ record.missing_tag.replaceAll(\"-\",\" \").toTitleCase() }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "GET updated WP tags",
      "operation": "http",
      "adapter": "http",
      "parameters": {
