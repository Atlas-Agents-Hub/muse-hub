    {
      "id": "step-18",
      "label": "Return missing tags",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const new_ary = steps[\"step-9\"].records[0].tags.map(x => x.toLowerCase().replaceAll(\" \",\"-\")).filter(x => !records[0].json.tags.includes(x))\n\nreturn {\"missing_tags\": new_ary};",
          "inputs": "records, record, and named steps"
        }
      }
    },
