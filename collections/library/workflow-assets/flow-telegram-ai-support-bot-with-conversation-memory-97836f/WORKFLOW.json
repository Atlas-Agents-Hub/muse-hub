{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-telegram-ai-support-bot-with-conversation-memory-97836f",
  "title": "Telegram AI Support Bot with Conversation Memory",
  "nodes": [
    {
      "id": "step-1",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "promptType": "define",
        "text": {
          "expression": "{{ record.message.text }}"
        },
        "options": {
          "systemMessage": "You are a friendly, concise assistant for a small business. Keep answers under 120 words. Reply in the customer's language. If you are not sure about business-specific facts (prices, policies, hours), say you'll check with the team instead of guessing."
        }
      }
    },
    {
      "id": "step-3",
      "label": "Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Chat Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "contextWindowLength": 10
      }
    },
    {
      "id": "step-5",
      "label": "Send Reply",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "text": {
          "expression": "{{ record.output }}"
        },
        "additionalFields": {}
      }
    }
  ],
