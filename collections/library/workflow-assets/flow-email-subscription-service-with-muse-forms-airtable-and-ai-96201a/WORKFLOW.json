{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-email-subscription-service-with-muse-forms-airtable-and-ai-96201a",
  "title": "Email Subscription Service with n8n Forms, Airtable and AI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Search daily",
      "operation": "service-read",
      "adapter": "airtable",
      "parameters": {
        "base": {
          "configuration_input": "step-2-base"
        },
        "table": {
          "configuration_input": "step-2-table"
        },
        "options": {},
        "operation": "search",
        "filterByFormula": "AND({Status} = 'active', {Interval} = 'daily')"
      }
    },
    {
      "id": "step-3",
      "label": "Search weekly",
      "operation": "service-read",
      "adapter": "airtable",
      "parameters": {
        "base": {
          "configuration_input": "step-3-base"
        },
        "table": {
          "configuration_input": "step-3-table"
        },
        "options": {},
        "operation": "search",
        "filterByFormula": {
          "expression": "AND(\n {Status} = 'active', \n {Interval} = 'weekly', \n {Last Sent} <= DATEADD(TODAY(), -7, 'days')\n)"
        }
      }
    },
    {
      "id": "step-4",
      "label": "confirmation email1",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "sendTo": {
          "expression": "{{ steps[\"step-16\"].record.email }}"
        },
        "message": {
          "expression": "This is to confirm your request to subscribe to \"Learn something every day!\" - a free service to send you facts about your favourite topics.\n\nTopic: {{ steps[\"step-16\"].record.topic }}\nSchedule: {{ steps[\"step-16\"].record.frequency }}"
        },
        "options": {
          "appendAttribution": false
        },
        "subject": "Learn something every day confirmation"
      }
    },
    {
      "id": "step-5",
      "label": "Execute Workflow",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "mode": "each",
        "options": {
          "waitForSubWorkflow": false
        },
        "workflowId": {
          "expression": "{{ workflow_id }}"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Create Event",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "type": "string",
              "value": {
                "expression": "{{ record.Email }}"
              }
            },
            {
              "name": "topic",
              "type": "string",
              "value": {
                "expression": "{{ record.Topic }}"
              }
            },
            {
              "name": "interval",
              "type": "string",
              "value": {
                "expression": "{{ record.Interval }}"
              }
            },
            {
              "name": "id",
              "type": "string",
              "value": {
                "expression": "{{ record.id }}"
              }
            },
            {
              "name": "created_at",
              "type": "string",
              "value": {
                "expression": "{{ record.Created }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Unsubscribe Form",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "options": {
          "path": "free-factoids-unsubscribe"
        },
        "formTitle": "Unsubscribe from Learn Something Every Day",
        "formFields": {
          "values": [
            {
              "fieldLabel": "ID",
              "requiredField": true
            },
            {
              "fieldType": "dropdown",
              "fieldLabel": "Reason For Unsubscribe",
              "multiselect": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "Emails not relevant"
                  },
                  {
                    "option": "Too many Emails"
                  },
                  {
                    "option": "I did not sign up to this service"
                  }
                ]
              }
            }
          ]
        },
        "formDescription": "We're sorry to see you go! Please take a moment to help us improve the service."
      }
    },
    {
      "id": "step-9",
      "label": "Set Email Vars",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "to",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-7\"].records[0].email }},[configured contact]"
              }
            },
            {
              "name": "subject",
              "type": "string",
              "value": {
                "expression": "Your {{ steps[\"step-7\"].records[0].interval }} factoid"
              }
            },
            {
              "name": "message",
              "type": "string",
              "value": {
                "expression": "<p>\n<strong>You asked about \"{{ steps[\"step-17\"].records[0].topic.replace('\"','') }}\"</strong>\n</p>\n<p>\n<i>{{ steps[\"step-20\"].records[0].output }}</i>\n</p>"
              }
            },
            {
              "name": "unsubscribe_link",
              "type": "string",
              "value": {
                "expression": "https://<MY_HOST>/form/inspiration-unsubscribe?ID={{ steps[\"step-7\"].records[0].id }}"
              }
            }
          ]
        },
        "includeOtherFields": true
      }
    },
