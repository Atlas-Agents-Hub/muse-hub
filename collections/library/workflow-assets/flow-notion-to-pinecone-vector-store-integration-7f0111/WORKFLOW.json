{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-notion-to-pinecone-vector-store-integration-7f0111",
  "title": "Notion to Pinecone Vector Store Integration",
  "nodes": [
    {
      "id": "step-1",
      "label": "Token Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "chunkSize": 256,
        "chunkOverlap": 30
      }
    },
    {
      "id": "step-2",
      "label": "Notion - Page Added Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": {
          "configuration_input": "step-2-databaseid"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Notion - Retrieve Page Content",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "blockId": {
          "expression": "{{ record.url }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true
      }
    },
    {
      "id": "step-4",
      "label": "Filter Non-Text Content",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.type }}"
              },
              "rightValue": "image"
            },
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.type }}"
              },
              "rightValue": "video"
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Summarize - Concatenate Notion's blocks content",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {
          "outputFormat": "separateItems"
        },
        "fieldsToSummarize": {
          "values": [
            {
              "field": "content",
              "separateBy": "\n",
              "aggregation": "concatenate"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Create metadata and load content",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "pageId",
                "value": {
                  "expression": "{{ steps[\"step-2\"].record.id }}"
                }
              },
              {
                "name": "createdTime",
                "value": {
                  "expression": "{{ steps[\"step-2\"].record.created_time }}"
                }
              },
              {
                "name": "pageTitle",
                "value": {
                  "expression": "{{ steps[\"step-2\"].record.properties.Name.title[0].text.content }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ record.concatenated_content }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-7",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-8",
      "label": "Pinecone Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-8-pineconeindex"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-6",
      "channel": "textSplitter",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-4",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-7",
      "to": "step-8",
      "channel": "embedding",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-6",
      "to": "step-8",
      "channel": "document",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-5",
      "to": "step-8",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-6",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-2"
  ],
