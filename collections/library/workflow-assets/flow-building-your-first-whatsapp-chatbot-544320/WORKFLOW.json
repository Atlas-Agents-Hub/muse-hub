{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-building-your-first-whatsapp-chatbot-544320",
  "title": "Building Your First WhatsApp Chatbot",
  "nodes": [
    {
      "id": "step-1",
      "label": "WhatsApp Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "messages"
        ]
      }
    },
    {
      "id": "step-2",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "whatsapp-75-{{ record.messages[0].from }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-4",
      "label": "Vector Store Tool",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "name": "query_product_brochure",
        "description": "Call this tool to query the product brochure. Valid for the year 2024."
      }
    },
    {
      "id": "step-5",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Model Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Embeddings OpenAI1",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-9",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "jsonData": {
          "expression": "{{ steps[\"step-11\"].record.text }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-10",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 2000,
        "chunkOverlap": {}
      }
    },
    {
      "id": "step-11",
      "label": "Extract from File",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "pdf"
      }
    },
    {
      "id": "step-12",
      "label": "get Product Brochure",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-12-url"
        },
        "options": {}
      }
    },
    {
      "id": "step-13",
      "label": "Reply To User",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "textBody": {
          "expression": "{{ record.output }}"
        },
        "operation": "send",
        "phoneNumberId": {
          "configuration_input": "step-13-phonenumberid"
        },
        "requestOptions": {},
        "additionalFields": {
          "previewUrl": false
        },
        "recipientPhoneNumber": {
          "expression": "{{ steps[\"step-1\"].record.messages[0].from }}"
        }
      }
    },
    {
      "id": "step-14",
      "label": "Reply To User1",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "textBody": {
          "expression": "I'm unable to process non-text messages. Please send only text messages. Thanks!"
        },
        "operation": "send",
        "phoneNumberId": {
          "configuration_input": "step-14-phonenumberid"
        },
        "requestOptions": {},
        "additionalFields": {
          "previewUrl": false
        },
        "recipientPhoneNumber": {
          "expression": "{{ steps[\"step-1\"].record.messages[0].from }}"
        }
      }
    },
    {
      "id": "step-15",
      "label": "Product Catalogue",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "memoryKey": "whatsapp-75"
      }
    },
    {
      "id": "step-16",
      "label": "Create Product Catalogue",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "memoryKey": "whatsapp-75",
        "clearStore": true
      }
    },
    {
      "id": "step-17",
      "label": "Handle Message Types",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Supported",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ record.messages[0].type }}"
                    },
                    "rightValue": "text"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Not Supported",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "notEquals"
                    },
                    "leftValue": {
                      "expression": "{{ record.messages[0].type }}"
                    },
                    "rightValue": "text"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-18",
      "label": "AI Sales Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.messages[0].text.body }}"
        },
        "options": {
          "systemMessage": "You are an assistant working for a company who sells Yamaha Powered Loudspeakers and helping the user navigate the product catalog for the year 2024. Your goal is not to facilitate a sale but if the user enquires, direct them to the appropriate website, url or contact information.\n\nDo your best to answer any questions factually. If you don't know the answer or unable to obtain the information from the datastore, then tell the user so."
        },
        "promptType": "define"
      }
    }
  ],
