{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-summarize-google-sheets-form-feedback-via-muse-s-muse-f2bf24",
  "title": "Summarize Google Sheets form feedback via Muse s Muse",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking \"Test workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Get Google Sheets records",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "sheetName": {
          "configuration_input": "step-2-sheetname"
        },
        "documentId": {
          "configuration_input": "step-2-documentid"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Aggregate responses into arrays",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "['What went great?']"
            },
            {
              "fieldToAggregate": "['How can we improve?']"
            },
            {
              "fieldToAggregate": "['What is the chance of recommending our event?']"
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Summarize via GPT model",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "Your task is to summarize event feedback form responses. You will receive answers on three questions:\n1. What went great?\n2. How can we improve?\n3. What is the chance of recommending our event?\n\nEach questions has several answers separated by | character.\nAnalyze each question and prepare a summary report. It should contain an overall sentiment regarding the event, followed by the constructive ideas of what to improve.\n\nReply in Markdown formatting"
            },
            {
              "content": {
                "expression": "1. What went great: ```{{ record['What went great?'].join(' | ') }}```\n2. How can we improve: ```{{ record['How can we improve?'].join(' | ') }}```\n3. What is the chance of recommending our event: ```{{ record['What is the chance of recommending our event?'].join(' | ') }}```"
              }
            }
          ]
        },
        "options": {
          "temperature": 0.3
        },
        "resource": "chat",
        "chatModel": "gpt-4-turbo-preview"
      }
    },
    {
      "id": "step-5",
      "label": "Convet from Markdown to HTML",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "mode": "markdownToHtml",
        "options": {
          "completeHTMLDocument": false
        },
        "markdown": {
          "expression": "{{ record.message.content }}"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Send via Gmail",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "sendTo": {
          "configuration_input": "step-6-sendto"
        },
        "message": {
          "expression": "{{ record.data }}"
        },
        "options": {
          "appendAttribution": false
        },
        "subject": "Feedback form response"
      }
    }
  ],
  "edges": [
    {
      "from": "step-4",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
