{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-post-new-youtube-videos-to-x-c8322e",
  "title": "Post New YouTube Videos to X",
  "nodes": [
    {
      "id": "step-1",
      "label": "Post to X",
      "operation": "service-write",
      "adapter": "twitter",
      "parameters": {
        "text": {
          "expression": "{{ record.message.content }}"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "Generate Post for X with ChatGPT",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-2-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "Write an engaging post about my latest YouTube video for X (Twitter) of no more than 140 characters in length. Link to the video at https://youtu.be/{{ record.id.videoId }} use this title and description: {{ record.snippet.title }} {{ record.snippet.description }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Fetch Latest Videos",
      "operation": "service-read",
      "adapter": "youtube",
      "parameters": {
        "limit": 1,
        "filters": {
          "channelId": {
            "configuration_input": "step-3-filters-channelid"
          },
          "publishedAfter": {
            "expression": "{{ new Date(new Date().getTime() - 30 * 60000).toISOString() }}"
          }
        },
        "options": {},
        "resource": "video"
      }
    },
    {
      "id": "step-4",
      "label": "Check Every 30 Min",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-4",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-1",
      "channel": "main",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-4"
  ],
  "configuration": [
    {
      "id": "step-2-modelid",
      "purpose": "Select the modelId for this task.",
      "required": true
    },
    {
      "id": "step-3-filters-channelid",
      "purpose": "Select the channelId for step-3.",
      "required": true
    }
  ],
