{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automated-ai-image-analysis-and-response-via-telegram-8e448a",
  "title": "Automated AI image analysis and response via Telegram",
  "nodes": [
    {
      "id": "step-1",
      "label": "Get the Image",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {
          "download": true
        }
      }
    },
    {
      "id": "step-2",
      "label": "Send Content for the Analyzed image",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.content }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-3",
      "label": "Update Telegram Error Message",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": "Please Upload an Image ....",
        "chatId": {
          "expression": "{{ record.message.chat.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-4",
      "label": "Wait",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 3
      }
    },
    {
      "id": "step-5",
      "label": "Analyze image",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "image",
        "inputType": "base64",
        "operation": "analyze"
      }
    },
    {
      "id": "step-6",
      "label": "Switch ( image or not )",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Image",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "array",
                      "operation": "exists",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.message.photo }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Empty",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "array",
                      "operation": "notExists",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.message.photo }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-4",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-5",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-6",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-6",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-6",
      "to": "step-4",
      "channel": "main",
      "branch": 1,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
