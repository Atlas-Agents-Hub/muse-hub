{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-sentiment-analysis-tracking-on-support-issues-with-linear-and-slack-6938ba",
  "title": "Sentiment Analysis Tracking on Support Issues with Linear and Slack",
  "nodes": [
    {
      "id": "step-1",
      "label": "Issues to List",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "data.issues.nodes"
      }
    },
    {
      "id": "step-2",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Combine Sentiment Analysis",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{{\n{\n ...steps[\"step-1\"].record,\n ...record.output\n}\n}}"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Sentiment over Issue Comments",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{\nrecord.comments.nodes.map(node => [\n `${node.user.displayName} commented on ${node.createdAt}:`,\n node.body\n].join('\\n')).join('---\\n')\n}}"
        },
        "options": {},
        "attributes": {
          "attributes": [
            {
              "name": "sentiment",
              "required": true,
              "description": "One of positive, negative or neutral"
            },
            {
              "name": "sentimentSummary",
              "description": "Describe the sentiment of the conversation"
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Copy of Issue",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{{ record }}"
        }
      }
    },
    {
      "id": "step-6",
      "label": "For Each Issue...",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Get Existing Sentiment",
      "operation": "service-read",
      "adapter": "airtable",
      "parameters": {
        "base": {
          "configuration_input": "step-7-base"
        },
        "table": {
          "configuration_input": "step-7-table"
        },
        "options": {
          "fields": [
            "Issue ID",
            "Current Sentiment"
          ]
        },
        "operation": "search",
        "filterByFormula": {
          "expression": "{Issue ID} = '{{ record.identifier || 'XYZ' }}'"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Update Row",
      "operation": "service-write",
      "adapter": "airtable",
      "parameters": {
        "base": {
          "configuration_input": "step-8-base"
        },
        "table": {
          "configuration_input": "step-8-table"
        },
        "columns": {
          "value": {
            "Summary": {
              "expression": "{{ steps[\"step-5\"].record.sentimentSummary || '' }}"
            },
            "Assigned": {
              "expression": "{{ steps[\"step-5\"].record.assignee.name }}"
            },
            "Issue ID": {
              "expression": "{{ steps[\"step-5\"].record.identifier }}"
            },
            "Issue Title": {
              "expression": "{{ steps[\"step-5\"].record.title }}"
            },
            "Issue Created": {
              "expression": "{{ steps[\"step-5\"].record.createdAt }}"
            },
            "Issue Updated": {
              "expression": "{{ steps[\"step-5\"].record.updatedAt }}"
            },
            "Current Sentiment": {
              "expression": "{{ steps[\"step-5\"].record.sentiment.toSentenceCase() }}"
            },
            "Previous Sentiment": {
              "expression": "{{ !record.isEmpty() ? record['Current Sentiment'] : 'N/A' }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "removed": true,
              "readOnly": true,
              "required": false,
              "displayName": "id",
              "defaultMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Issue ID",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "options",
              "display": true,
              "options": [
                {
                  "name": "Positive",
                  "value": "Positive"
                },
                {
                  "name": "Negative",
                  "value": "Negative"
                },
                {
                  "name": "Neutral",
                  "value": "Neutral"
                },
                {
                  "name": "N/A",
                  "value": "N/A"
                }
              ],
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Previous Sentiment",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "options",
              "display": true,
              "options": [
                {
                  "name": "Positive",
                  "value": "Positive"
                },
                {
                  "name": "Negative",
                  "value": "Negative"
                },
                {
                  "name": "Neutral",
                  "value": "Neutral"
                },
                {
                  "name": "N/A",
                  "value": "N/A"
                }
              ],
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Current Sentiment",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Summary",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Issue Title",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "dateTime",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Issue Created",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "dateTime",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Issue Updated",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "readOnly": false,
              "required": false,
              "displayName": "Assigned",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "readOnly": true,
              "required": false,
              "displayName": "Created",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "readOnly": true,
              "required": false,
              "displayName": "Last Modified",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "Issue ID"
          ]
        },
        "options": {},
        "operation": "upsert"
      }
    },
    {
      "id": "step-9",
      "label": "Airtable Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "baseId": {
          "configuration_input": "step-9-baseid"
        },
        "tableId": {
          "configuration_input": "step-9-tableid"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyHour"
            }
          ]
        },
        "triggerField": "Current Sentiment",
        "additionalFields": {}
      }
    },
    {
      "id": "step-10",
      "label": "Sentiment Transition",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "NON-NEGATIVE to NEGATIVE",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.fields[\"Previous Sentiment\"] !== 'Negative' && record.fields[\"Current Sentiment\"] === 'Negative' }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
    {
      "id": "step-11",
      "label": "Fetch Active Linear Issues",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "query": {
          "expression": "query (\n $filter: IssueFilter\n) {\n issues(\n filter: $filter\n ) {\n nodes {\n id\n identifier\n title\n description\n url\n createdAt\n updatedAt\n assignee {\n name\n }\n comments {\n nodes {\n id\n createdAt\n user {\n displayName\n }\n body\n }\n }\n }\n }\n}"
        },
        "endpoint": {
          "configuration_input": "step-11-endpoint"
        },
        "variables": {
          "expression": "{{\n{\n \"filter\": {\n updatedAt: { gte: current_time.minus(30, 'minutes').toISO() }\n }\n}\n}}"
        },
        "requestFormat": "json"
      }
    },
    {
      "id": "step-12",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Deduplicate Notifications",
      "operation": "deduplicate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": {
          "configuration_input": "step-13-operation"
        },
        "dedupeValue": {
          "expression": "{{ record.fields[\"Issue ID\"] }}:{{ record.fields['Last Modified'] }}"
        }
      }
    },
    {
      "id": "step-14",
      "label": "Report Issue Negative Transition",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": "{{ steps[\"step-13\"].all().length }} Issues have transitions to Negative Sentiment"
        },
        "select": "channel",
        "blocksUi": {
          "expression": "{{\n{\n \"blocks\": [\n {\n \"type\": \"section\",\n \"text\": {\n \"type\": \"mrkdwn\",\n \"text\": \":rotating_light: The following Issues transitioned to Negative Sentiment\"\n }\n },\n {\n \"type\": \"divider\"\n },\n ...(steps[\"step-13\"].all().map(item => (\n {\n \"type\": \"section\",\n \"text\": {\n \"type\": \"mrkdwn\",\n \"text\": `*<https://linear.app/myOrg/issue/${record.fields['Issue ID']}|${record.fields['Issue ID']} ${record.fields['Issue Title']}>*\\n${record.fields.Summary}`\n }\n }\n )))\n ]\n}\n}}"
        },
        "channelId": {
          "configuration_input": "step-14-channelid"
        },
        "messageType": "block",
        "otherOptions": {}
      }
    }
  ],
