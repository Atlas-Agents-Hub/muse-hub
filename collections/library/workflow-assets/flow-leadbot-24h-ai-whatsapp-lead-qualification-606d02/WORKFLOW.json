{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-leadbot-24h-ai-whatsapp-lead-qualification-606d02",
  "title": "LeadBot 24h - AI WhatsApp Lead Qualification",
  "nodes": [
    {
      "id": "step-1",
      "label": "WhatsApp Webhook (WAHA)",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "leadbot-24h",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Normalize & Score Lead",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Normalize incoming WhatsApp payload to standard lead format\nconst msg = records[0].json;\nconst lead = {\n  phone: msg.data?.from || msg.from || '',\n  message: msg.data?.body || msg.body || msg.text || '',\n  name: msg.data?.fromName || msg.data?.name || '',\n  timestamp: new Date().toISOString(),\n  source: 'whatsapp'};\n\n// Simple keyword-based urgency detection (no paid API required)\nconst urgentKeywords = ['preço', 'price', 'comprar', 'buy', 'contratar', 'urgente', 'orçamento', 'demissão', 'demissao', 'folha', 'payroll', 'admissão', 'admissao', 'férias'];\nconst msgLower = (lead.message || '').toLowerCase();\nlead.intent_score = urgentKeywords.some(k => msgLower.includes(k)) ? 9 : 5;\nlead.urgency = lead.intent_score >= 8 ? 'HOT' : 'WARM';\n\nreturn [{ json: lead }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Filter Hot Leads",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Route hot leads to CRM / Google Sheets\nconst lead = records[0].json;\nif (lead.urgency === 'HOT') {\n  return [{ json: lead }];\n}\nreturn [];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Save Lead to Google Sheets",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "operation": "append",
        "sheetId": {
          "configuration_input": "step-4-sheetid"
        },
        "range": "Sheet1!A:E",
        "columns": {
          "mappings": [
            {
              "toField": "A",
              "value": {
                "expression": "{{record.phone}}"
              },
              "type": "string"
            },
            {
              "toField": "B",
              "value": {
                "expression": "{{record.name}}"
              },
              "type": "string"
            },
            {
              "toField": "C",
              "value": {
                "expression": "{{record.message}}"
              },
              "type": "string"
            },
            {
              "toField": "D",
              "value": {
                "expression": "{{record.intent_score}}"
              },
              "type": "number"
            },
            {
              "toField": "E",
              "value": {
                "expression": "{{record.urgency}}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Notify Sales Team (Slack/Webhook)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-5-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": {
                "expression": "🔥 HOT LEAD from WhatsApp\\nPhone: {{record.phone}}\nName: {{record.name}}\nMessage: {{record.message}}\nIntent Score: {{record.intent_score}}/10\nUrgency: {{record.urgency}}"
              }
            }
          ]
        },
        "options": {}
      }
    }
  ],
