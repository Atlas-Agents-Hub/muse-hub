{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-respond-to-whatsapp-messages-with-ai-like-a-pro-839097",
  "title": "Respond to WhatsApp Messages with AI Like a Pro!",
  "nodes": [
    {
      "id": "step-1",
      "label": "WhatsApp Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "messages"
        ]
      }
    },
    {
      "id": "step-2",
      "label": "Get Audio URL",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": {
          "expression": "{{ record.audio.id }}"
        },
        "requestOptions": {}
      }
    },
    {
      "id": "step-3",
      "label": "Get Video URL",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": {
          "expression": "{{ record.video.id }}"
        },
        "requestOptions": {}
      }
    },
    {
      "id": "step-4",
      "label": "Get Image URL",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "resource": "media",
        "operation": "mediaUrlGet",
        "mediaGetId": {
          "expression": "{{ record.image.id }}"
        },
        "requestOptions": {}
      }
    },
    {
      "id": "step-5",
      "label": "Download Video",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Download Audio",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Download Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "whatsapp-tutorial-{{ record.from }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-9",
      "label": "Get User's Message",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "message_type",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-10\"].record.type }}"
              }
            },
            {
              "name": "message_text",
              "type": "string",
              "value": {
                "expression": "{{ record.text }}"
              }
            },
            {
              "name": "from",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-1\"].record.messages[0].from }}"
              }
            },
            {
              "name": "message_caption",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-12\"].record.video && steps[\"step-12\"].record.video.caption || '' }}\n{{ steps[\"step-12\"].record.image && steps[\"step-12\"].record.image.caption || ''}}\n{{ steps[\"step-12\"].record.audio && steps[\"step-12\"].record.audio.caption || ''}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Split Out Message Parts",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "messages"
      }
    },
    {
      "id": "step-11",
      "label": "Wikipedia",
      "operation": "service-read",
      "adapter": "toolwikipedia",
      "parameters": {}
    },
    {
      "id": "step-12",
      "label": "Redirect Message Types",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Audio Message",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.type == 'audio' && Boolean(record.audio) }}"
                    },
                    "rightValue": "audio"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Video Message",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.type == 'video' && Boolean(record.video) }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Image Message",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.type == 'image' && Boolean(record.image) }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Text Message"
        }
      }
    },
    {
      "id": "step-13",
      "label": "Get Text",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 0
      }
    },
    {
      "id": "step-14",
      "label": "Respond to User",
      "operation": "service-write",
      "adapter": "whatsapp",
      "parameters": {
        "textBody": {
          "expression": "{{ record.output }}"
        },
        "operation": "send",
        "phoneNumberId": {
          "configuration_input": "step-14-phonenumberid"
        },
        "requestOptions": {},
        "additionalFields": {},
        "recipientPhoneNumber": {
          "expression": "{{ steps[\"step-1\"].record.messages[0].from }}"
        }
      }
    },
    {
      "id": "step-15",
      "label": "Image Explainer",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Here is an image sent by the user. Describe the image and transcribe any text visible in the image.",
        "messages": {
          "messageValues": [
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary"
            }
          ]
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-16",
      "label": "Format Response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "{{ record.candidates[0].content.parts[0].text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-17",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-18",
      "label": "Model Audio",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-18-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"contents\": [{\n \"parts\":[\n {\"text\": \"Transcribe this audio\"},\n {\"inlineData\": {\n \"mimeType\": `audio/${$binary.data.fileExtension}`,\n \"data\": record.binary.data.data }\n }\n ]\n }]\n}\n}}"
        },
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "step-19",
      "label": "Model Video",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-19-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"contents\": [{\n \"parts\":[\n {\"text\": \"Describe this video\"},\n {\"inlineData\": {\n \"mimeType\": `video/${$binary.data.fileExtension}`,\n \"data\": record.binary.data.data }\n }\n ]\n }]\n}\n}}"
        },
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "step-20",
      "label": "Model Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-21",
      "label": "Model Chat Model2",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-22",
      "label": "Format Response1",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "{{ record.candidates[0].content.parts[0].text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-23",
      "label": "Text Summarizer",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.text.body || record.text }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": "Summarize the user's message succinctly."
            }
          ]
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-24",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "The user sent the following message\nmessage type: {{ record.message_type }}\nmessage text or description:\n```{{ record.message_text }}```\n{{ record.message_caption ? `message caption: ${record.message_caption.trim()}` : '' }}"
        },
        "options": {
          "systemMessage": "You are a general knowledge assistant made available to the public via whatsapp. Help answer the user's query succiently and factually."
        },
        "promptType": "define"
      }
    }
  ],
