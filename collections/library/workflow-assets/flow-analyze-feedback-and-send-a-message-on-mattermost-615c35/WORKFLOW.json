  "title": "Analyze feedback and send a message on Mattermost",
  "nodes": [
    {
      "id": "step-1",
      "label": "Typeform Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "formId": ""
      }
    },
    {
      "id": "step-2",
      "label": "Google Cloud Natural Language",
      "operation": "service-read",
      "adapter": "googlecloudnaturallanguage",
      "parameters": {
        "content": {
          "expression": "{{steps[\"step-1\"].json[\"What did you think about the event?\"]}}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": {
                "expression": "{{steps[\"step-2\"].json[\"documentSentiment\"][\"score\"]}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Mattermost",
      "operation": "service-read",
      "adapter": "mattermost",
      "parameters": {
        "message": {
          "expression": "You got a new feedback with a score of {{steps[\"step-2\"].json[\"documentSentiment\"][\"score\"]}}. Here is what it says:{{steps[\"step-1\"].json[\"What did you think about the event?\"]}}"
        },
        "channelId": {
          "configuration_input": "step-4-channelid"
        },
        "attachments": [],
        "otherOptions": {}
      }
    },
    {
      "id": "step-5",
      "label": "NoOp",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    }
  ],
