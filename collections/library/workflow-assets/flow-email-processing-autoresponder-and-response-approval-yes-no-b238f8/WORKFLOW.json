{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-email-processing-autoresponder-and-response-approval-yes-no-b238f8",
  "title": "email processing autoresponder and response approval (Yes No)",
  "nodes": [
    {
      "id": "step-1",
      "label": "Email Trigger (IMAP)",
      "operation": "service-read",
      "adapter": "emailreadimap",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.textHtml }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "DeepSeek R1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Send Email",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
        "html": {
          "expression": "{{ steps[\"step-8\"].record.output }}"
        },
        "options": {},
        "subject": {
          "expression": "Re: {{ steps[\"step-1\"].record.subject }}"
        },
        "toEmail": {
          "expression": "{{ steps[\"step-1\"].record.from }}"
        },
        "fromEmail": {
          "expression": "{{ steps[\"step-1\"].record.to }}"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "retrieve-as-tool",
        "options": {},
        "toolName": "company_knowladge_base",
        "toolDescription": "Extracts information regarding the request made.",
        "qdrantCollection": {
          "expression": "COLLECTION"
        },
        "includeDocumentMetadata": false
      }
    },
    {
      "id": "step-6",
      "label": "Embeddings OpenAI",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "Email Summarization Chain",
      "operation": "summarize",
      "adapter": "model",
      "parameters": {
        "options": {
          "binaryDataKey": {
            "expression": "{{ record.data }}"
          },
          "summarizationMethodAndPrompts": {
            "values": {
              "prompt": {
                "expression": "Write a concise summary of the following in max 100 words :\n\n\"{{ record.data }}\"\n\nDo not enter the total number of words used."
              },
              "combineMapPrompt": {
                "expression": "Write a concise summary of the following in max 100 words:\n\n\"{{ record.data }}\"\n\nDo not enter the total number of words used."
              }
            }
          }
        },
        "operationMode": "nodeInputBinary"
      }
    },
    {
      "id": "step-8",
      "label": "Write email",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Write the text to reply to the following email:\n\n{{ steps[\"step-7\"].record.response.text }}"
        },
        "options": {
          "systemMessage": "You are an expert at answering emails. You need to answer them professionally based on the information you have. This is a business email. Be concise and never exceed 100 words. Only the body of the email, not create the subject.\n\nIt must be in HTML format and you can insert (if you think it is appropriate) only HTML characters such as <br>, <b>, <i>, <p> where necessary."
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-9",
      "label": "OpenAI",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Set Email",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "type": "string",
              "value": {
                "expression": "{{ record.response.text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Approve?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {
          "ignoreCase": false
        },
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.data.approved }}"
              },
              "rightValue": "true"
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Send Draft",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "sendTo": {
          "configuration_input": "step-12-sendto"
        },
        "message": {
          "expression": "<h3>MESSAGE</h3>\n{{ steps[\"step-1\"].record.textHtml }}\n\n<h3>AI RESPONSE</h3>\n{{ record.output }}"
        },
        "options": {},
        "subject": {
          "expression": "[Approval Required] {{ steps[\"step-1\"].record.subject }}"
        },
        "operation": "sendAndWait",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        }
      }
    }
  ],
