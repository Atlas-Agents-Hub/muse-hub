{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-tunova-generate-a-song-from-a-form-0f6c42",
  "title": "Tunova - Generate a song from a form",
  "nodes": [
    {
      "id": "step-1",
      "label": "On form submission",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "formTitle": "Make a song with AI",
        "formDescription": "Describe the track you want — Tunova generates it with Suno (v5.5).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Prompt",
              "placeholder": "calm rainy-night lofi, mellow piano, vinyl crackle",
              "requiredField": true
            },
            {
              "fieldLabel": "Instrumental",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "No"
                  },
                  {
                    "option": "Yes"
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Tunova: start generation",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-2-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"prompt\": {{ JSON.stringify(record.Prompt) }},\n  \"instrumental\": {{ record.Instrumental === 'Yes' }}\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Wait for render (~2 min)",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 120,
        "unit": "seconds"
      }
    },
    {
      "id": "step-4",
      "label": "Tunova: get result",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.tunova.ai/api/jobs/{{ steps[\"step-2\"].record.job_id }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Your track",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": {
                "expression": "{{ record.status }}"
              },
              "type": "string"
            },
            {
              "name": "audio_url",
              "value": {
                "expression": "{{ record.clips?.[0]?.audio_url }}"
              },
              "type": "string"
            },
            {
              "name": "title",
              "value": {
                "expression": "{{ record.clips?.[0]?.title }}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-4",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-4",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
  "configuration": [
    {
      "id": "step-2-url",
      "purpose": "Set the url endpoint or source URL for this operation.",
      "required": true,
      "endpoint_template": "https://api.tunova.ai/api/generate"
    }
  ],
