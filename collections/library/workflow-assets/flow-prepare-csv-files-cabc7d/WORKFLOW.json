{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-prepare-csv-files-cabc7d",
  "title": "Prepare CSV files with GPT-4",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking \"Execute Workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "OpenAI",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "model": {
          "configuration_input": "step-2-model"
        },
        "prompt": {
          "messages": [
            {
              "content": {
                "expression": "please create a list of 10 random users. Return back ONLY a JSON array. Character names of famous fiction characters. Make Names and Surnames start with the same letter. Name and Surname can be from different characters. If subscribed is false then make date_subscribed empty. If date_subscribed is not empty then make it random and no later then 2023-10-01. Make JSON in a single line, avoid line breaks. Here's an example: [{\"user_name\": \"Jack Jones\", \"user_email\":\"[configured contact]\",\"subscribed\": true, \"date_subscribed\":\"2023-10-01\" },{\"user_name\": \"Martin Moor\", \"user_email\":\"[configured contact]\",\"subscribed\": false, \"date_subscribed\":\"\" }]"
              }
            }
          ]
        },
        "options": {
          "n": 3,
          "maxTokens": 2500,
          "temperature": 1
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-3",
      "label": "Split In Batches",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "batchSize": 1
      }
    },
    {
      "id": "step-4",
      "label": "Parse JSON",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "content",
              "type": "arrayValue",
              "arrayValue": {
                "expression": "{{JSON.parse(record.message.content)}}"
              }
            }
          ]
        },
        "include": "none",
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Make JSON Table",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "content"
      }
    },
    {
      "id": "step-6",
      "label": "Convert to CSV",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {
          "fileName": {
            "expression": "funny_names_{{ steps[\"step-3\"].record.index+1 }}.{{ $parameter[\"fileFormat\"] }}"
          },
          "headerRow": true
        },
        "operation": "toFile",
        "fileFormat": "csv"
      }
    },
    {
      "id": "step-7",
      "label": "Save to Disk",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fileName": {
          "expression": "./.n8n/{{ $binary.data.fileName }}"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Strip UTF BOM bytes",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {
          "encoding": "utf8",
          "stripBOM": true,
          "jsonParse": false,
          "keepSource": false
        },
        "setAllData": false
      }
    },
    {
      "id": "step-9",
      "label": "Create valid binary",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "mode": "jsonToBinary",
        "options": {
          "addBOM": false,
          "encoding": "utf8",
          "fileName": {
            "expression": "funny_names_{{ steps[\"step-3\"].record.index+1 }}.{{ steps[\"step-6\"].first().binary.data.fileExtension }}"
          },
          "mimeType": "text/csv",
          "keepSource": false,
          "useRawData": true
        },
        "convertAllData": false
      }
    }
  ],
