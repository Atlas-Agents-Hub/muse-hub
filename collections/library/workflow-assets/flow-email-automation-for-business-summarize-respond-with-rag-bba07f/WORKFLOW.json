{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-email-automation-for-business-summarize-respond-with-rag-bba07f",
  "title": "Email Automation for Business Summarize & Respond with RAG",
  "nodes": [
    {
      "id": "step-1",
      "label": "Email Trigger (IMAP)",
      "operation": "service-read",
      "adapter": "emailreadimap",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.textHtml }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "DeepSeek R1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Send Email",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
        "html": {
          "expression": "{{ record.text }}"
        },
        "options": {},
        "subject": {
          "expression": "Re: {{ steps[\"step-1\"].record.subject }}"
        },
        "toEmail": {
          "expression": "{{ steps[\"step-1\"].record.from }}"
        },
        "fromEmail": {
          "expression": "{{ steps[\"step-1\"].record.to }}"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "retrieve-as-tool",
        "options": {},
        "toolName": "company_knowladge_base",
        "toolDescription": "Extracts information regarding the request made.",
        "qdrantCollection": {
          "expression": "COLLECTION"
        },
        "includeDocumentMetadata": false
      }
    },
    {
      "id": "step-6",
      "label": "Embeddings OpenAI",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "Email Classifier",
      "operation": "classify",
      "adapter": "model",
      "parameters": {
        "options": {
          "fallback": "other",
          "multiClass": false,
          "enableAutoFixing": true,
          "systemPromptTemplate": "Please classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json.\n"
        },
        "inputText": {
          "expression": "You must classify the following email::\n\n{{ record.response.text }}"
        },
        "categories": {
          "categories": [
            {
              "category": "Company info request",
              "description": "Company info request"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Email Summarization Chain",
      "operation": "summarize",
      "adapter": "model",
      "parameters": {
        "options": {
          "binaryDataKey": {
            "expression": "{{ record.data }}"
          },
          "summarizationMethodAndPrompts": {
            "values": {
              "prompt": {
                "expression": "Write a concise summary of the following in max 100 words:\n\n\"{{ record.data }}\"\n\nDo not enter the total number of words used."
              },
              "combineMapPrompt": {
                "expression": "Write a concise summary of the following in max 100 words:\n\n\"{{ record.data }}\""
              }
            }
          }
        },
        "operationMode": "nodeInputBinary"
      }
    },
    {
      "id": "step-9",
      "label": "Write email",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Write the text to reply to the following email:\n\n{{ record.response.text }}"
        },
        "options": {
          "systemMessage": "You are an expert at answering emails. You need to answer them professionally based on the information you have. This is a business email. Be concise and never exceed 100 words."
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-10",
      "label": "Review email",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Review at the following email:\n\n{{ record.output }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "If you are an expert in reviewing emails before sending them. You need to review and structure them in such a way that you can send them. It must be in HTML format and you can insert (if you think it is appropriate) only HTML characters such as <br>, <b>, <i>, <p> where necessary.\n\nNon superare le 100 parole."
              }
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-11",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
