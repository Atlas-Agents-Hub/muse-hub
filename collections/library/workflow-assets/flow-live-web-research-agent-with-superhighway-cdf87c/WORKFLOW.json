    {
      "id": "step-5",
      "label": "Format Results",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Superhighway returns an array of results (commonly under `results`).\n// Normalize to a clean list of { title, url, snippet } items.\nconst body = records[0].json;\n\nconst raw = Array.isArray(body)\n  ? body\n  : (body.results || body.data || body.items || []);\n\nreturn raw.map((r) => ({\n  json: {\n    title: r.title || r.name || '',\n    url: r.url || r.link || '',\n    snippet: r.snippet || r.description || r.content || r.text || ''\n  }\n}));",
          "inputs": "records, record, and named steps"
        }
      }
    }
