{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-muse-ai-morning-brief-34f8f0",
  "title": "Muse AI Morning Brief",
  "nodes": [
    {
      "id": "step-1",
      "label": "Every Day 8am",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Build Context",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Build today's context for Claude\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('en-US', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\n// Customize: add your tasks/calendar data here\nconst todaysTasks = [\n  'Check emails',\n  'Team standup at 10am',\n  'Review pull requests'\n];\n\nreturn [{\n  json: {\n    date: dateStr,\n    tasks: todaysTasks.join('\\n- '),\n    prompt: `Today is ${dateStr}.\\n\\nMy tasks for today:\\n- ${todaysTasks.join('\\n- ')}\\n\\nPlease give me a motivating, concise morning brief (3-5 sentences) that:\\n1. Acknowledges today's date/day\\n2. Highlights the key priorities\\n3. Ends with one actionable focus tip`\n  }\n}];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Generate Brief",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": {
                "configuration_input": "step-3-parameters-0-value"
              }
            },
            {
              "name": "anthropic-version",
              "value": {
                "configuration_input": "step-3-parameters-1-value"
              }
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ record.prompt }}\"\n    }\n  ]\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Send via LINE",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-4-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": {
                "configuration_input": "step-4-parameters-0-value"
              }
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"to\": \"{{ $env.LINE_USER_ID }}\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"🌅 Morning Brief\\n\\n{{ record.content[0].text }}\"\n    }\n  ]\n}"
        },
        "options": {}
      }
    }
  ],
