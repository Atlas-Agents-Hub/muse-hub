{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-send-specific-pdf-attachments-from-gmail-to-google-drive-64105e",
  "title": "Send specific PDF attachments from Gmail to Google Drive using OpenAI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Read PDF",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Configure",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "number": [
            {
              "name": "maxTokenSize",
              "value": 4000
            },
            {
              "name": "replyTokenSize",
              "value": 50
            }
          ],
          "string": [
            {
              "name": "Match on",
              "value": "payslip"
            },
            {
              "name": "Google Drive folder to upload matched PDFs",
              "value": {
                "configuration_input": "step-2-string-1-value"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Is PDF",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": {
                "expression": "{{ $binary.data.fileExtension }}"
              },
              "value2": "pdf"
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Not a PDF",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Is matched",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": {
                "expression": "{{ record[\"text\"] }}"
              },
              "value2": "true"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "This is a matched PDF",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-7",
      "label": "This is not a matched PDF",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Iterate over email attachments",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// https://community.n8n.io/t/iterating-over-email-attachments/13588/3\nlet results = [];\n\nfor (const item of records) {\n for (key of Object.keys(item.binary)) {\n results.push({\n json: {},\n binary: {\n data: item.binary[key],\n }\n });\n }\n}\n\nreturn results;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-9",
      "label": "OpenAI matches PDF textual content",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "Does this PDF file look like a {{ steps[\"step-2\"].records[0][\"Match on\"] }}? Return \"true\" if it is a {{ steps[\"step-2\"].records[0][\"Match on\"] }} and \"false\" if not. Only reply with lowercase letters \"true\" or \"false\".\n\nThis is the PDF filename:\n```\n{{ $binary.data.fileName }}\n```\n\nThis is the PDF text content:\n```\n{{ record.text }}\n```"
        },
        "options": {
          "maxTokens": {
            "expression": "{{ steps[\"step-2\"].records[0].replyTokenSize }}"
          },
          "temperature": 0.1
        }
      }
    },
    {
      "id": "step-10",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {
          "clashHandling": {
            "values": {
              "resolveClash": "preferInput1"
            }
          }
        },
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-11",
      "label": "Upload file to folder",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "name": {
          "expression": "{{ $binary.data.fileName }}"
        },
        "options": {},
        "parents": [
          {
            "expression": "{{ steps[\"step-2\"].records[0][\"Google Drive folder to upload matched PDFs\"].split(\"/\").at(-1) }}"
          }
        ],
        "binaryData": true
      }
    },
    {
      "id": "step-12",
      "label": "On email received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "filters": {},
        "options": {
          "downloadAttachments": true,
          "dataPropertyAttachmentsPrefixName": "attachment_"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Ignore large PDFs",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-14",
      "label": "Is text within token limit?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": {
                "expression": "{{ record.text.length() / 4 <= steps[\"step-2\"].records[0].maxTokenSize - steps[\"step-2\"].records[0].replyTokenSize }}"
              },
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "step-15",
      "label": "Has attachments?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": {
                "expression": "{{ steps[\"step-12\"].item.binary.isNotEmpty() }}"
              },
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "step-16",
      "label": "There are no attachments",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    }
  ],
