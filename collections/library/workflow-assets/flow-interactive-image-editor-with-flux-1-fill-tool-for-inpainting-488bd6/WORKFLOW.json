          "configuration_input": "step-6-url"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": {
                "expression": "{{ record.id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Get Fill Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.result.sample }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Show the image to user",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": {
                  "expression": "{{ $binary.data.mimeType }}"
                }
              }
            ]
          }
        },
        "respondWith": "binary",
        "responseDataSource": "set"
      }
    },
    {
