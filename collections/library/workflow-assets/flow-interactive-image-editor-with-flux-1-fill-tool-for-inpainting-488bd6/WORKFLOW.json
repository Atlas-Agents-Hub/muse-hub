            },
            {
              "name": "steps",
              "value": {
                "expression": "{{ record.body.steps }}"
              }
            },
            {
              "name": "prompt_upsampling",
              "value": {
                "expression": "{{ record.body.prompt_upsampling }}"
              }
            },
            {
              "name": "guidance",
              "value": {
                "expression": "{{ record.body.guidance }}"
              }
            },
            {
              "name": "output_format",
              "value": "png"
            },
            {
              "name": "safety_tolerance",
              "value": "6"
            },
            {
              "name": "image",
              "value": {
                "expression": "{{ record.body.image.split(',')[1] }}"
              }
            },
            {
              "name": "mask",
              "value": {
                "expression": "{{ record.body.mask.split(',')[1] }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Check FLUX status",
