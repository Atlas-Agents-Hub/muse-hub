    {
      "id": "step-10",
      "label": "Route by Priority",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": {
                      "expression": "{{ record.priority }}"
                    },
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": {
                      "expression": "{{ record.priority }}"
                    },
                    "rightValue": "review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
