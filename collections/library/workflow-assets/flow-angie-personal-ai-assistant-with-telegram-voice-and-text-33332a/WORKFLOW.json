{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-angie-personal-ai-assistant-with-telegram-voice-and-text-33332a",
  "title": "Angie, Personal AI Assistant with Telegram Voice and Text",
  "nodes": [
    {
      "id": "step-1",
      "label": "Google Calendar",
      "operation": "service-read",
      "adapter": "googlecalendar",
      "parameters": {
        "options": {
          "fields": {
            "expression": "items(summary, start(dateTime))"
          },
          "timeMin": {
            "expression": "{{$fromAI(\"date\",\"the date after which to fetch the messages in format YYYY-MM-DDTHH:MM:SS\")}}"
          }
        },
        "calendar": {
          "configuration_input": "step-1-calendar"
        },
        "operation": "getAll"
      }
    },
    {
      "id": "step-2",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ steps[\"step-5\"].records[0].message.from.id }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-3",
      "label": "Get Email",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "filters": {
          "labelIds": [
            "INBOX",
            "UNREAD"
          ],
          "readStatus": "unread",
          "receivedAfter": {
            "expression": "{{$fromAI(\"date\",\"the date after which to fetch the messages in format YYYY-MM-DDTHH:MM:SS\")}}"
          }
        },
        "operation": "getAll"
      }
    },
    {
      "id": "step-4",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-5",
      "label": "Listen for incoming events",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-6",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.output }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-5\"].records[0].message.from.id }}"
        },
        "additionalFields": {
          "parse_mode": "Markdown",
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-7",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.message.text }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Speech to Text",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "audio",
        "operation": "transcribe"
      }
    },
    {
      "id": "step-9",
      "label": "Voice or Text",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "text",
              "stringValue": {
                "expression": "{{ record?.message?.text || \"\" }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "Get Voice File",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "fileId": {
          "expression": "{{ steps[\"step-5\"].record.message.voice.file_id }}"
        },
        "resource": "file"
      }
    },
    {
      "id": "step-11",
      "label": "Angie, AI Assistant 👩🏻‍🏫",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.text }}"
        },
        "options": {
          "systemMessage": {
            "expression": "You are a helpful assistant.\n\nToday's date is {{ current_time }}.\n\nGuidelines:\n- When fetching emails, filter out any promotional emails. \n- When summarizing emails, include Sender, Message date, subject, and brief summary of email.\n- if the user did not specify a date in the request assume they are asking for today\n- Use baserow tool to answer questions about tasks\n- When answering questions about calendar events, filter out events that don't apply to the question. For example, the question is about events for today, only reply with events for today. Don't mention future events if it's more than 1 week away"
          }
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-12",
      "label": "Tasks",
      "operation": "service-read",
      "adapter": "baserow",
      "parameters": {
        "tableId": {
          "configuration_input": "step-12-tableid"
        },
        "databaseId": {
          "configuration_input": "step-12-databaseid"
        },
        "additionalOptions": {}
      }
    },
    {
      "id": "step-13",
      "label": "Contacts",
      "operation": "service-read",
      "adapter": "baserow",
      "parameters": {
        "tableId": {
          "configuration_input": "step-13-tableid"
        },
        "databaseId": {
          "configuration_input": "step-13-databaseid"
        },
        "descriptionType": "manual",
        "toolDescription": "Useful for getting contact information. For example emails or phone numbers.",
        "additionalOptions": {}
      }
    }
  ],
