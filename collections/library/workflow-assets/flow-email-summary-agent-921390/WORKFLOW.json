      "channel": "main",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
  "configuration": [
    {
      "id": "step-4-modelid",
      "purpose": "Select the modelId for this task.",
      "required": true
    },
    {
      "id": "step-5-sendto",
      "purpose": "Select the sendTo for step-5.",
      "required": true
    },
    {
      "id": "step-5-options-cclist",
