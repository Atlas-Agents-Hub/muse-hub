    {
      "id": "step-5",
      "label": "Extract and limit Linkedin",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\noutput = []\nmax_posts = 10\nlet counter = 0\nfor (const item of records[0].json.data) {\n let post = {\n title: item.article_title,\n text: item.text\n }\n output.push(post)\n if(counter++ >= max_posts) break;\n}\n\nreturn {\"linkedIn posts\": output};",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Exract and limit X",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\noutput = []\nmax_posts = 10\nlet counter = 0\nfor (const item of records[0].json.tweets) {\n if(!item.content.hasOwnProperty('itemContent')) continue\n let post = {\n text: item.content.itemContent?.tweet_results?.result.legacy?.full_text\n }\n console.log(post)\n output.push(post)\n if(counter++ >= max_posts) break;\n}\n\nreturn {\"Twitter tweets\": output};",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-7",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-8",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "jsonSchemaExample": {
          "json": {
            "subject": "",
            "cover_letter": ""
          }
        }
      }
    },
    {
      "id": "step-9",
      "label": "Generate Subject and cover letter based on match",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "## Me\n- My company name is: {{ steps[\"Set your company\\\\'s variables\"].record.your_company_name }}\n- My company's activity is: {{ steps[\"Set your company\\\\'s variables\"].record.your_company_activity }}\n- My name is: {{ steps[\"Set your company\\\\'s variables\"].record.your_name }}\n- My email is: {{ steps[\"Set your company\\\\'s variables\"].record.your_email }}\n\n## My lead:\nHis name: {{ steps[\"step-11\"].record.name }}\n\n## What I want you to do\n- According to the info about me, and the linkedin posts an twitter post of a user given below, I want you to find a common activity that I could propose to this person and generate a cover letter about it\n- Return ONLY the cover letter and the subject as a json like this:\n{\n \"subject\": \"\",\n \"cover_letter\": \"\"\n}\n\nTHe cover letter should be in HTML format\n\n## The Linkedin Posts:\n{{ JSON.stringify(record[\"linkedIn posts\"])}}\n\n## THe Twitter posts:\n{{ JSON.stringify(steps[\"step-6\"].record['Twitter tweets']) }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": "You are a helpful Marketing assistant"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-10",
      "label": "Send Cover letter and CC me",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
