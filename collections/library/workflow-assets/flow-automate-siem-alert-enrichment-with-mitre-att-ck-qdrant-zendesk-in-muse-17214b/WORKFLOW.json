    {
      "id": "step-16",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "jsonSchemaExample": {
          "json": {
            "ttp_identification": {
              "alert_summary": "The alert indicates a check-in from the NetSupport RAT, a known Remote Access Trojan, suggesting command and control (C2) communication.",
              "mitre_attack_ttps": [
                {
                  "tactic": "Command and Control",
                  "technique": "Protocol or Service Impersonation",
                  "technique_id": "T1001.003",
                  "description": "The RAT's check-in over port 443 implies potential masquerading of its traffic as legitimate SSL/TLS traffic, a tactic often used to blend C2 communications with normal web traffic.",
                  "reference": {
                    "configuration_input": "step-16-mitre-attack-ttps-0-reference"
                  }
                }
              ]
            },
            "remediation_steps": {
              "network_segmentation": {
                "action": "Isolate the affected host",
                "target": "10.11.26.183",
                "reason": "Prevents further C2 communication or lateral movement."
              },
              "endpoint_inspection": {
                "action": "Perform a thorough inspection",
                "target": "Impacted endpoint",
                "method": "Use endpoint detection and response (EDR) tools to check for additional persistence mechanisms."
              },
              "network_traffic_analysis": {
                "action": "Investigate and block unusual traffic",
                "target": "IP 194.180.191.64",
                "method": "Implement blocks for the IP across the firewall or IDS/IPS systems."
              },
              "system_patching": {
                "action": "Ensure all systems are updated",
                "method": "Apply the latest security patches to mitigate vulnerabilities exploited by RAT malware."
              },
              "ioc_hunting": {
                "action": "Search for Indicators of Compromise (IoCs)",
                "method": "Check for NetSupport RAT IoCs across other endpoints within the network."
              }
            },
            "historical_patterns": {
              "network_anomalies": "Past alerts involving similar attempts to use standard web ports (e.g., 80, 443) for non-standard applications could suggest a broader attempt to blend malicious traffic into legitimate streams.",
              "persistence_tactics": "Any detection of anomalies in task scheduling or shortcut modifications may indicate persistence methods similar to those used by RATs."
            },
            "external_resources": [
              {
                "title": "ESET Report on Okrum and Ketrican",
                "description": "Discusses similar tactics involving protocol impersonation and C2.",
                "url": {
                  "configuration_input": "step-16-external-resources-0-url"
                }
              },
              {
                "title": "Malleable C2 Profiles",
                "description": "Document on crafting custom C2 traffic profiles similar to the targeting methods used by NetSupport RAT.",
                "url": {
                  "configuration_input": "step-16-external-resources-1-url"
                }
              },
              {
                "title": "MITRE ATT&CK Technique Overview",
                "description": "Overview of Protocol or Service Impersonation tactics.",
                "url": {
                  "configuration_input": "step-16-external-resources-2-url"
                }
              }
            ]
          }
        }
      }
