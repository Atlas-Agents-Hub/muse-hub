    {
      "id": "step-19",
      "label": "Query Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "retrieve-as-tool",
        "options": {},
        "toolName": "mitre_attack_vector_store",
        "toolDescription": "The mitre_attack_vector_store is a knowledge base trained on the MITRE ATT&CK framework. It is designed to help identify, correlate, and provide context for cybersecurity incidents based on textual descriptions of alerts, events, or behaviors. This tool leverages precomputed embeddings of attack techniques, tactics, and procedures (TTPs) to map user queries (such as SIEM-generated alerts or JIRA ticket titles) to relevant MITRE ATT&CK techniques.\n\nBy analyzing input text, the vector store can:\n\nRetrieve the most relevant MITRE ATT&CK entries (e.g., techniques, tactics, descriptions, external references).\nProvide structured context about potential adversary behaviors.\nSuggest remediation actions or detection methods based on the input.",
        "qdrantCollection": {
          "configuration_input": "step-19-qdrantcollection"
        }
      }
    },
    {
      "id": "step-20",
      "label": "Qdrant Vector Store query",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "retrieve-as-tool",
        "options": {},
        "toolName": "mitre_attack_vector_store",
        "toolDescription": "The mitre_attack_vector_store is a knowledge base trained on the MITRE ATT&CK framework. It is designed to help identify, correlate, and provide context for cybersecurity incidents based on textual descriptions of alerts, events, or behaviors. This tool leverages precomputed embeddings of attack techniques, tactics, and procedures (TTPs) to map user queries (such as SIEM-generated alerts or JIRA ticket titles) to relevant MITRE ATT&CK techniques.\n\nBy analyzing input text, the vector store can:\n\nRetrieve the most relevant MITRE ATT&CK entries (e.g., techniques, tactics, descriptions, external references).\nProvide structured context about potential adversary behaviors.\nSuggest remediation actions or detection methods based on the input.",
        "qdrantCollection": {
          "configuration_input": "step-20-qdrantcollection"
        }
      }
    },
    {
      "id": "step-21",
      "label": "Get all Zendesk Tickets",
      "operation": "service-read",
      "adapter": "zendesk",
      "parameters": {
        "options": {},
        "operation": "getAll"
      }
    },
    {
      "id": "step-22",
      "label": "Update Zendesk with Mitre Data",
      "operation": "service-write",
      "adapter": "zendesk",
      "parameters": {
        "operation": "update",
        "updateFields": {
          "internalNote": {
            "expression": "Summary: {{ record.output.ttp_identification.alert_summary }}"
          },
          "customFieldsUi": {
            "customFieldsValues": [
              {
                "id": {
                  "configuration_input": "step-22-customfieldsvalues-0-id"
                },
                "value": {
                  "expression": "{{ record.output.ttp_identification.mitre_attack_ttps[0].technique_id }}"
                }
              },
              {
                "id": {
                  "configuration_input": "step-22-customfieldsvalues-1-id"
                },
                "value": {
                  "expression": "{{ record.output.ttp_identification.mitre_attack_ttps[0].tactic }}"
                }
              }
            ]
          }
        }
      }
    },
    {
