{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-store-notion-s-pages-as-vector-documents-into-supabase-37f85b",
  "title": "Store Notion s Pages as Vector Documents into Supabase with OpenAI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Embeddings OpenAI",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-2",
      "label": "Token Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "chunkSize": 256,
        "chunkOverlap": 30
      }
    },
    {
      "id": "step-3",
      "label": "Notion - Page Added Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "databaseId": {
          "configuration_input": "step-3-databaseid"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Notion - Retrieve Page Content",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "blockId": {
          "expression": "{{ record.url }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true
      }
    },
    {
      "id": "step-5",
      "label": "Filter Non-Text Content",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.type }}"
              },
              "rightValue": "image"
            },
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.type }}"
              },
              "rightValue": "video"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Summarize - Concatenate Notion's blocks content",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {
          "outputFormat": "separateItems"
        },
        "fieldsToSummarize": {
          "values": [
            {
              "field": "content",
              "separateBy": "\n",
              "aggregation": "concatenate"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Create metadata and load content",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "pageId",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record.id }}"
                }
              },
              {
                "name": "createdTime",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record.created_time }}"
                }
              },
              {
                "name": "pageTitle",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record.properties.Page.title[0].text.content }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ steps[\"step-6\"].record.concatenated_content }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-8",
      "label": "Supabase Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "tableName": {
          "configuration_input": "step-8-tablename"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-2",
      "to": "step-7",
      "channel": "textSplitter",
      "branch": 0,
