{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-dataforge-lite-ai-url-data-extractor-f0f2c6",
  "title": "DataForge Lite - AI URL Data Extractor",
  "nodes": [
    {
      "id": "step-1",
      "label": "Scrape URL",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "dataforge-lite",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Validate",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "try {\n  const b = records[0].json.body || records[0].json;\n  if (!b.url) throw new Error('URL is required.');\n  return [{ json: { url: b.url, extractFields: b.extract_fields || 'price,features,description', name: b.name || '' } }];\n} catch (e) { throw new Error('Invalid input: ' + e.message); }",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Fetch Page",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "GET",
        "url": {
          "expression": "{{ record.url }}"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; DataForge/1.0)"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      }
    },
    {
      "id": "step-4",
      "label": "Extract Text",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "try {\n  const url = steps[\"step-2\"].records[0];\n  const r = records[0].json;\n  const html = typeof r === 'string' ? r : (r.data || r.body || JSON.stringify(r));\n  const text = html.replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi,'').replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi,'').replace(/<[^>]+>/g,' ').replace(/\\s+/g,' ').trim().substring(0,4000);\n  return [{ json: { ...url, pageText: text } }];\n} catch(e) { throw new Error('Extract failed: ' + e.message); }",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-5",
      "label": "AI: Extract Data",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "model": {
          "configuration_input": "step-5-model"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": {
                "expression": "Extract from the page: {{ record.extractFields }}. Also: title, description, stats, sentiment. JSON: { \"title\": \"\", \"description\": \"\", \"extractedData\": {}, \"statistics\": [], \"sentiment\": \"\" }"
              }
            },
            {
              "role": "user",
              "content": {
                "expression": "URL: {{record.url}}\nExtract: {{record.extractFields}}\n\nContent:\n{{record.pageText}}"
              }
            }
          ]
        },
        "options": {
          "temperature": 0.2,
          "maxTokens": 800,
          "responseFormat": "json_object"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Respond",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "expression": "{{ records[0].json.message?.content || records[0].json.content || '{}' }}"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
