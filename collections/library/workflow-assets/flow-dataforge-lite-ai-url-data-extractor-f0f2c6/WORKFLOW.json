      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-5",
      "to": "step-6",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-4",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
