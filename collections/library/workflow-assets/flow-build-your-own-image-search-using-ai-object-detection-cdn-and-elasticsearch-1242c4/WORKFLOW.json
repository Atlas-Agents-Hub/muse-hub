{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-build-your-own-image-search-using-ai-object-detection-cdn-and-elasticsearch-1242c4",
  "title": "Build Your Own Image Search Using AI Object Detection, CDN and ElasticSearch",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking \"Test workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Fetch Source Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.source_image }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Split Out Results Only",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "result"
      }
    },
    {
      "id": "step-4",
      "label": "Filter Score >= 0.9",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": {
                "expression": "{{ record.score }}"
              },
              "rightValue": 0.9
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Crop Object From Image",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "width": {
          "expression": "{{ record.box.xmax - record.box.xmin }}"
        },
        "height": {
          "expression": "{{ record.box.ymax - record.box.ymin }}"
        },
        "options": {
          "format": "jpeg",
          "fileName": {
            "expression": "{{ $binary.data.fileName.split('.')[0].urlEncode()+'-'+record.label.urlEncode() + '-' + record_index }}.jpg"
          }
        },
        "operation": "crop",
        "positionX": {
          "expression": "{{ record.box.xmin }}"
        },
        "positionY": {
          "expression": "{{ record.box.ymin }}"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Set Variables",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "CLOUDFLARE_ACCOUNT_ID",
              "type": "string",
              "value": ""
            },
            {
              "name": "model",
              "type": "string",
              "value": "@cf/facebook/detr-resnet-50"
            },
            {
              "name": "source_image",
              "type": "string",
              "value": {
                "configuration_input": "step-6-assignments-2-value"
              }
            },
            {
              "name": "elasticsearch_index",
              "type": "string",
              "value": "n8n-image-search"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Use Detr-Resnet-50 Object Classification",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.cloudflare.com/client/v4/accounts/{{ steps[\"step-6\"].record.CLOUDFLARE_ACCOUNT_ID }}/ai/run/{{ steps[\"step-6\"].record.model }}"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data"
      }
    },
    {
      "id": "step-8",
      "label": "Upload to Cloudinary",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-8-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendQuery": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "upload_preset",
              "value": "n8n-workflows-preset"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Create Docs In Elasticsearch",
      "operation": "service-write",
      "adapter": "elasticsearch",
      "parameters": {
        "indexId": {
          "expression": "{{ steps[\"step-6\"].record.elasticsearch_index }}"
        },
        "options": {},
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "image_url",
              "fieldValue": {
                "expression": "{{ record.secure_url.replace('upload','upload/f_auto,q_auto') }}"
              }
            },
            {
              "fieldId": "source_image_url",
              "fieldValue": {
                "expression": "{{ steps[\"step-6\"].record.source_image }}"
              }
            },
            {
              "fieldId": "label",
              "fieldValue": {
                "expression": "{{ steps[\"step-5\"].record.label }}"
              }
            },
            {
              "fieldId": "metadata",
              "fieldValue": {
                "expression": "{{ JSON.stringify(Object.assign(steps[\"step-5\"].record, { filename: record.original_filename })) }}"
              }
            }
          ]
        },
        "operation": "create",
        "additionalFields": {}
      }
    },
    {
      "id": "step-10",
      "label": "Fetch Source Image Again",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-6\"].record.source_image }}"
        },
        "options": {}
      }
    }
  ],
