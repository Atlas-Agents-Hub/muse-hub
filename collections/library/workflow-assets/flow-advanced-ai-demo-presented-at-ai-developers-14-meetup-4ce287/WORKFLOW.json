{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-advanced-ai-demo-presented-at-ai-developers-14-meetup-4ce287",
  "title": "Advanced AI Demo (Presented at AI Developers #14 meetup)",
  "nodes": [
    {
      "id": "step-1",
      "label": "Send message",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": "Data from webhook: {{ record.query.email }}"
        },
        "select": "channel",
        "channelId": {
          "configuration_input": "step-1-channelid"
        },
        "otherOptions": {}
      }
    },
    {
      "id": "step-2",
      "label": "Execute JavaScript",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of records) {\n item.json.myNewField = 1;\n}\n\nreturn records;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 3000,
        "chunkOverlap": 200
      }
    },
    {
      "id": "step-4",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-5",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "loader": "pdfLoader",
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "document-title",
                "value": {
                  "expression": "{{ steps[\"step-10\"].record.whitepaper_title }}"
                }
              },
              {
                "name": "document-publish-year",
                "value": {
                  "expression": "{{ steps[\"step-10\"].record.publish_year }}"
                }
              },
              {
                "name": "document-author",
                "value": {
                  "expression": "{{ steps[\"step-10\"].record.author }}"
                }
              }
            ]
          }
        },
        "dataType": "binary"
      }
    },
    {
      "id": "step-6",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "step-7",
      "label": "Embeddings OpenAI2",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-8",
      "label": "Vector Store Retriever",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {}
    },
    {
      "id": "step-9",
      "label": "Download PDF",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.file_url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "PDFs to download",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-11",
      "label": "Read Pinecone Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "options": {
          "pineconeNamespace": "whitepaper"
        },
        "pineconeIndex": {
          "configuration_input": "step-11-pineconeindex"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Question and Answer Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.chatInput }}. \nOnly use vector store knowledge to answer the question. Don't make anything up. If you don't know the answer, tell the user that you don't know."
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-13",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.4
        }
      }
    },
    {
      "id": "step-14",
      "label": "Get calendar availability",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-14-url"
        },
        "method": "POST",
        "jsonBody": {
          "expression": "{\n \"timeMin\": \"{timeMin}\",\n \"timeMax\": \"{timeMax}\",\n \"timeZone\": \"Europe/Berlin\",\n \"groupExpansionMax\": 20,\n \"calendarExpansionMax\": 10,\n \"items\": [\n {\n \"id\": \"[configured contact]\"\n }\n ]\n}"
        },
        "sendBody": true,
        "specifyBody": "json",
        "toolDescription": "Call this tool to get the appointment availability for a particular period on the calendar. The tool may refer to availability as \"Free\" or \"Busy\". \n\nUse {timeMin} and {timeMax} to specify the window for the availability query. For example, to get availability for 25 July, 2024 the {timeMin} would be 2024-07-25T09:00:00+02:00 and {timeMax} would be 2024-07-25T17:00:00+02:00.\n\nIf the tool returns an empty response, it means that something went wrong. It does not mean that there is no availability."
      }
    },
    {
      "id": "step-15",
      "label": "Appointment booking agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemMessage": {
            "expression": "You are an efficient and courteous assistant tasked with scheduling appointments with Max Tkacz.\n\nWhen users mention an appointment or meeting, they are referring to a meeting with Max.\nWhen users refer to the calendar or \"your schedule,\" they are referring to Max's calendar. \n\nYou can use various tools to access and manage Max's calendar. Your primary goal is to assist users in successfully booking an appointment with Max, ensuring no scheduling conflicts. Only book an appointment if the requested time slot is available (the tool may refer to this as \"Free\")\n\nToday's date is {{ current_date.format('dd LLL yyyy') }}.\nAppointments are always 30 minutes in length. \n\n\nProvide accurate information at all times. If the tools are not functioning correctly, inform the user that you are unable to assist them at the moment."
          }
        }
      }
    },
    {
      "id": "step-16",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "contextWindowLength": 10
      }
    },
    {
      "id": "step-17",
      "label": "Insert into Pinecone vector store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {
          "clearNamespace": true,
          "pineconeNamespace": "whitepaper"
        },
        "pineconeIndex": {
          "configuration_input": "step-17-pineconeindex"
        }
      }
    },
    {
      "id": "step-18",
      "label": "Book appointment",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-18-url"
        },
        "method": "POST",
        "jsonBody": {
          "expression": "{\n \"summary\": \"Appointment with {userName}\",\n \"start\": {\n \"dateTime\": \"{startTime}\",\n \"timeZone\": \"Europe/Berlin\"\n },\n \"end\": {\n \"dateTime\": \"{endTime}\",\n \"timeZone\": \"Europe/Berlin\"\n },\n \"attendees\": [\n {\"email\": \"[configured contact]\"},\n {\"email\": \"{userEmail}\"}\n ]\n}"
        },
        "sendBody": true,
        "specifyBody": "json",
        "toolDescription": "Call this tool to book an appointment in the calendar. ",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "userName",
              "description": "The full name of the user making the appointment. Like John Doe"
            },
            {
              "name": "startTime",
              "description": "The start time of the event in Europe/Berlin timezone. For example, 2024-07-24T10:00:00+02:00"
            },
            {
              "name": "endTime",
              "description": "The end time of the event in Europe/Berlin timezone. It should always be 30 minutes after the startTime. "
            },
            {
              "name": "userEmail",
              "description": "The email address of the user making the appointment"
            }
          ]
        }
      }
    },
    {
      "id": "step-19",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "public": true,
        "options": {
          "title": "Book an appointment with Max"
        },
        "initialMessages": "Hi there! 👋\nI can help you schedule an appointment with Max Tkacz. On which day would you like to meet?"
      }
    },
    {
      "id": "step-20",
      "label": "Model Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.5
        }
      }
    },
    {
      "id": "step-21",
      "label": "Add automation label",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "labelIds": [
          "Label_4763053241338138112"
        ],
        "messageId": {
          "expression": "{{ record.id }}"
        },
        "operation": "addLabels"
      }
    },
    {
      "id": "step-22",
      "label": "On new email to nathan's inbox",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "bypass": true,
        "instruction": "Pass the incoming records to the next connected operation."
      }
    },
    {
      "id": "step-23",
      "label": "Add music label",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "labelIds": [
          "Label_6822395192337188416"
        ],
        "messageId": {
          "expression": "{{ record.id }}"
        },
        "operation": "addLabels"
      }
    },
    {
      "id": "step-24",
      "label": "Assign label with AI",
      "operation": "classify",
      "adapter": "model",
      "parameters": {
        "options": {},
        "inputText": {
          "expression": "{{ record.text }}"
        },
        "categories": {
          "categories": [
            {
              "category": "automation",
              "description": "email on the topic of automation or workflows and automated processes, includes newsletters on this topic"
            },
            {
              "category": "music",
              "description": "email on the topic of music, for example from an artist "
            }
          ]
        }
      }
    },
    {
      "id": "step-25",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": {
          "configuration_input": "step-25-path"
        },
        "options": {}
      }
    },
    {
      "id": "step-26",
      "label": "Whether email contains n8n",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "contains"
              },
              "leftValue": {
                "expression": "{{ record.query.email }}"
              },
              "rightValue": "@n8n"
            }
          ]
        }
      }
    }
