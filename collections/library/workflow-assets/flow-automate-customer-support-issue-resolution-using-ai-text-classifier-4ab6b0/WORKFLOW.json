    {
      "id": "step-6",
      "label": "Get Issue Comments",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "options": {},
        "issueKey": {
          "expression": "{{ record.key }}"
        },
        "resource": "issueComment",
        "operation": "getAll"
      }
    },
    {
      "id": "step-7",
      "label": "Close Issue",
      "operation": "service-write",
      "adapter": "jira",
      "parameters": {
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "operation": "update",
        "updateFields": {
          "statusId": {
            "configuration_input": "step-7-updatefields-statusid"
          }
        }
      }
    },
    {
      "id": "step-8",
      "label": "Send Reminder",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "comment": {
          "expression": "{{ record.text }}\n(this is an automated message)"
        },
        "options": {},
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "resource": "issueComment"
      }
    },
    {
      "id": "step-9",
      "label": "Join Comments",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData"
      }
    },
    {
      "id": "step-10",
      "label": "Add Autoclose Message",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "comment": {
          "expression": "Autoclosing due to inactivity. Please create a new ticket if you require additional support. Thank you!\n(this is an automated message)"
        },
        "options": {},
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "resource": "issueComment"
      }
    },
    {
      "id": "step-11",
      "label": "Ask For Feedback Message",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "comment": {
          "expression": "[~accountid:{{ steps[\"step-17\"].record.reporter_accountId }}]\n\nWe think the issue is resolved so we're autoclosing it. If you've been satisified with our service, please leave us a 5 start review here: [link](link/to/review_site)\n\nPlease feel free to create another ticket if you need further assistance.\n(this is an automated message)"
        },
        "options": {},
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "resource": "issueComment"
      }
    },
    {
      "id": "step-12",
      "label": "Simplify Thread For AI",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "thread",
              "type": "array",
              "value": {
                "expression": "{{\nrecord.data.map(comment => {\n const { accountId, displayName } = comment.author;\n\n const message = comment.body.content.map(item =>\n `<${item.type}>${item.content\n .filter(c => c.text || c.content)\n .map(c => c.content\n ? c.content\n .filter(cc => c.text || c.content)\n .map(cc => cc.text)\n .join(' ')\n : c.text\n )}</${item.type}>`\n ).join('');\n return `${displayName} (accountId: ${accountId}) says: ${message}`;\n})\n\n}}"
              }
            },
            {
              "name": "topic",
              "type": "string",
              "value": {
                "expression": "{{\n[\n `title: ${steps[\"step-17\"].record.title}`,\n `original message: ${steps[\"step-17\"].record.description.replaceAll(/\\n/g, ' ')}`,\n `reported by: ${steps[\"step-17\"].record.reporter}`\n].join('\\n')\n}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Solution Found?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.output.solution_found }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-14",
      "label": "Reply to Issue",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "comment": {
          "expression": "Hey there!\n{{ steps[\"step-24\"].record.output.response }}\nWe'll close this issue now but feel free to create a new one if needed.\n(this is an automated message)"
        },
        "options": {},
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "resource": "issueComment"
      }
    },
    {
      "id": "step-15",
      "label": "Last Message is Not Bot",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ !steps[\"step-12\"].record.thread.last().includes('this is an automated message') }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-16",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "schemaType": "manual",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "solution_found": {
                "type": "boolean"
              },
              "short_summary_of_issue": {
                "type": "string"
              },
              "response": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "step-17",
      "label": "Get Issue Metadata",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "key",
              "type": "string",
              "value": {
                "expression": "{{ record.key }}"
              }
            },
            {
              "name": "title",
              "type": "string",
              "value": {
                "expression": "{{ record.fields.summary }}"
              }
            },
            {
              "name": "url",
              "type": "string",
              "value": {
                "expression": "{{\n[\n 'https:/',\n record.self.extractDomain(),\n 'browse',\n record.key\n ].join('/')\n}}"
              }
            },
            {
              "name": "date",
              "type": "string",
              "value": {
                "expression": "{{ DateTime.fromISO(record.fields.created).format('yyyy-MM-dd') }}"
              }
            },
            {
              "name": "reporter",
              "type": "string",
              "value": {
                "expression": "{{ record.fields.reporter.displayName }}"
              }
            },
            {
              "name": "reporter_url",
              "type": "string",
              "value": {
                "expression": "{{\n[\n 'https:/',\n record.fields.reporter.self.extractDomain(),\n 'jira',\n 'people',\n record.fields.reporter.accountId\n ].join('/')\n}}"
              }
            },
            {
              "name": "reporter_accountId",
              "type": "string",
              "value": {
                "expression": "{{ record.fields.reporter.accountId }}"
              }
            },
            {
              "name": "description",
              "type": "string",
              "value": {
                "expression": "{{ record.fields.description }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-18",
      "label": "Notify Slack Channel",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "select": "channel",
        "blocksUi": {
          "expression": "{{\n{\n\t\"blocks\": [\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"text\": {\n\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\"text\": \"Hey there 👋\\nI found a zombie ticket that no one has taken a look at yet.\"\n\t\t\t}\n\t\t},\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"text\": {\n\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\"text\": `*[${steps[\"step-17\"].record.key}] ${steps[\"step-17\"].record.title}*\\n${steps[\"step-24\"].record.output.short_summary_of_issue}\\n👤 <${steps[\"step-17\"].record.reporter_url}|${steps[\"step-17\"].record.reporter}> 📅 ${steps[\"step-17\"].record.date} 🔗 <${steps[\"step-17\"].record.url}|Link to Issue>\\n`\n\t\t\t}\n\t\t},\n\t\t{\n\t\t\t\"type\": \"divider\"\n\t\t},\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"text\": {\n\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\"text\": \"I couldn't find an answer in the knowledgebase so I've notified the user and closed the ticket. Thanks!\"\n\t\t\t}\n\t\t}\n\t]\n}\n}}"
        },
        "channelId": {
          "configuration_input": "step-18-channelid"
        },
        "messageType": "block",
        "otherOptions": {}
      }
    },
    {
      "id": "step-19",
      "label": "Close Issue2",
      "operation": "service-write",
      "adapter": "jira",
      "parameters": {
        "issueKey": {
          "expression": "{{ steps[\"step-17\"].record.key }}"
        },
        "operation": "update",
        "updateFields": {
          "statusId": {
            "configuration_input": "step-19-updatefields-statusid"
          }
        }
      }
    },
    {
      "id": "step-20",
      "label": "Get List of Unresolved Long Lived Issues",
      "operation": "service-read",
      "adapter": "jira",
      "parameters": {
        "limit": 10,
        "options": {
          "jql": "status IN (\"To Do\", \"In Progress\") AND created <= -7d"
        },
        "operation": "getAll"
      }
    },
