    {
      "id": "step-4",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 3000,
        "chunkOverlap": 200
      }
    },
    {
      "id": "step-5",
      "label": "Stop and Error",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "errorMessage": "An error occurred"
      }
    },
    {
      "id": "step-6",
      "label": "Question and Answer Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.message.text }}\nSearch the database with the retriever for information for the answer"
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-7",
      "label": "Vector Store Retriever",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {}
