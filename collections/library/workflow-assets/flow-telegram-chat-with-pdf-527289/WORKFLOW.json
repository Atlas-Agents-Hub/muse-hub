          "configuration_input": "step-8-pineconeindex"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Check If is a document",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "object",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.message.document }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Change to application/pdf",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Função para modificar os metadados do arquivo binário\nfunction modifyBinaryMetadata(items) {\n for (const item of items) {\n if (item.binary && item.binary.data) {\n // Modifica o tipo MIME\n item.binary.data.mimeType = 'application/pdf';\n \n // Garante que o nome do arquivo termine com .pdf\n if (!item.binary.data.fileName.toLowerCase().endsWith('.pdf')) {\n item.binary.data.fileName += '.pdf';\n }\n \n // Atualiza o contentType no fileType (se existir)\n if (item.binary.data.fileType) {\n item.binary.data.fileType.contentType = 'application/pdf';\n }\n }\n }\n return items;\n}\n\n// Aplica a modificação e retorna os itens atualizados\nreturn modifyBinaryMetadata(records);",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Telegram get File",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "fileId": {
          "expression": "{{ record.message.document.file_id }}"
        },
        "resource": "file"
      }
    },
    {
      "id": "step-13",
      "label": "Embeddings",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-14",
      "label": "Telegram Response",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.response.text }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-15",
      "label": "Telegram Response about Database",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.metadata.pdf.totalPages }} pages saved on Pinecone"
        },
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-16",
