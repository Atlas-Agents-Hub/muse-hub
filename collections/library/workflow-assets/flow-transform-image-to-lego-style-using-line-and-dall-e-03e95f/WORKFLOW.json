{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-transform-image-to-lego-style-using-line-and-dall-e-03e95f",
  "title": "Transform Image to Lego Style Using Line and Dall-E",
  "nodes": [
    {
      "id": "step-1",
      "label": "Receive a Line Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "lineimage",
        "options": {},
        "httpMethod": "POST"
      }
    },
    {
      "id": "step-2",
      "label": "Receive Line Messages",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api-data.line.me/v2/bot/message/{{ record.body.events[0].message.id }}/content"
        },
        "options": {},
        "jsonHeaders": {
          "expression": "{\n\"Authorization\": \"[configured credential]\",\n\"Content-Type\": \"application/json\"\n}"
        },
        "sendHeaders": true,
        "specifyHeaders": "json"
      }
    },
    {
      "id": "step-3",
      "label": "Creating an Image using Dall-E",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "{{ record.content }}"
        },
        "options": {
          "returnImageUrls": true
        },
        "resource": "image"
      }
    },
    {
      "id": "step-4",
      "label": "Creating a Prompt for Dall-E (Lego Style)",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Creating the DALL·E 3 prompt to transform this kind of image into a isometric LEGO image (Only provide me with a prompt).",
        "modelId": {
          "configuration_input": "step-4-modelid"
        },
        "options": {},
        "resource": "image",
        "inputType": "base64",
        "operation": "analyze",
        "binaryPropertyName": {
          "expression": "data"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Send Back an Image through Line",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"replyToken\": \"{{ steps[\"step-1\"].record.body.events[0].replyToken }}\",\n \"messages\": [\n {\n \"type\": \"image\",\n \"originalContentUrl\": \"{{ record.url }}\",\n \"previewImageUrl\": \"{{ record.url }}\"\n }\n ]\n}"
        },
        "sendBody": true,
        "jsonHeaders": {
          "json": {
            "Authorization": {
              "configuration_input": "step-5-jsonheaders-body-authorization"
            },
            "Content-Type": "application/json"
          }
        },
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "json"
      }
    }
  ],
  "edges": [
    {
      "from": "step-2",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-4",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-5",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
