        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "let savingAttributes = record.json.existingAttributes ? record.json.existingAttributes : [];\nrecord.json.attributes.forEach((attrId)=>{\nif(record.json.existingAttributes.indexOf(attrId) == -1) savingAttributes.push(attrId);\n});\n\nrecord.json.savingAttributes = savingAttributes;\n\nreturn record;",
