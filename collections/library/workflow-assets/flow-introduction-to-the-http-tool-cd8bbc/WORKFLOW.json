    {
      "id": "step-2",
      "label": "Model Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Activity Tool",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "type"
            },
            {
              "name": "participants"
            }
          ]
        },
        "toolDescription": "Call this tool to suggest an activity where:\n* the parameter \"type\" is one of \"education\", \"recreational\",\"social\",\"diy\",\"charity\",\"cooking\",\"relaxation\",\"music\",\"busywork\"\n* the parameter \"participants\" is the number of participants for the activity"
      }
    },
    {
      "id": "step-4",
      "label": "Set ChatInput1",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "chatInput",
              "type": "string",
              "value": "Hi! Please suggest something to do. I feel like learning something new!"
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "AI Agent1",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.chatInput }}"
        },
        "options": {},
        "promptType": "define"
      }
    },
    {
      "id": "step-6",
      "label": "Set ChatInput",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "chatInput",
              "type": "string",
              "value": "Can get the latest 10 issues from https://github.com/n8n-io/n8n/issues?"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.chatInput }}"
        },
        "options": {},
        "promptType": "define"
      }
    },
    {
      "id": "step-9",
      "label": "Webscraper Tool",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-9-url"
        },
        "fields": "markdown",
        "method": "POST",
        "sendBody": true,
        "dataField": "data",
        "parametersBody": {
          "values": [
            {
              "name": "url"
            },
            {
              "name": "pageOptions",
              "value": {
                "expression": "{{ {\n onlyMainContent: true,\n replaceAllPathsWithAbsolutePaths: true,\n removeTags: 'img,svg,video,audio'\n} }}"
              },
              "valueProvider": "fieldValue"
            }
          ]
        },
        "fieldsToInclude": "selected",
        "toolDescription": "Call this tool to fetch a webpage content.",
        "optimizeResponse": true
      }
    }
  ],
