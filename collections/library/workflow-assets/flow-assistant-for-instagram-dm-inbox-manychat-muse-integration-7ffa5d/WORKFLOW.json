{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-assistant-for-instagram-dm-inbox-manychat-muse-integration-7ffa5d",
  "title": "Assistant for Instagram DM inbox. Manychat + Open AI integration",
  "nodes": [
    {
      "id": "step-1",
      "label": "Set your system promt for AI",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "prompt",
              "type": "string",
              "value": {
                "expression": "Persona: You are a instagram influencer.\nContext: You receive a messages from your subscribers\nTask: Answer questions in your writing style and patterns according to your previous posts text. Use your post only for style and patterns reference.\nStyle rules:\nsimple answers"
              }
            },
            {
              "name": "sessionId",
              "type": "string",
              "value": {
                "expression": "{{ record.body.session_id }}"
              }
            },
            {
              "name": "chatInput",
              "type": "string",
              "value": {
                "expression": "{{ record.body.text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Local n8n memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ steps[\"step-1\"].last().json.sessionId }}"
        },
        "sessionIdType": "customKey",
        "contextWindowLength": 20
      }
    },
    {
      "id": "step-3",
      "label": "ChatGPT model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Send respond",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Getting message from Instagram",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "instagram_chat",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "step-6",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.chatInput }}"
        },
        "options": {
          "systemMessage": {
            "expression": "{{ record.prompt }}"
          }
        },
        "promptType": "define"
      }
    }
  ],
  "edges": [
    {
      "from": "step-6",
      "to": "step-4",
