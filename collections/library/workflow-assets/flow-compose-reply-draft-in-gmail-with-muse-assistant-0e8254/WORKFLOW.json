{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-compose-reply-draft-in-gmail-with-muse-assistant-0e8254",
  "title": "Compose reply draft in Gmail with OpenAI Assistant",
  "nodes": [
    {
      "id": "step-1",
      "label": "Convert raw to base64",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "const encoded = Buffer.from(record.raw).toString('base64');\n\nreturn { encoded };",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-2",
      "label": "Add email draft to thread",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-2-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\"message\":{\"raw\":\"{{ record.encoded }}\", \"threadId\": \"{{ steps[\"step-5\"].record[\"threadId\"] }}\"}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-3",
      "label": "Remove AI label from email",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "resource": "thread",
        "threadId": {
          "expression": "{{ steps[\"step-5\"].record[\"threadId\"] }}"
        },
        "operation": "removeLabels"
      }
    },
    {
      "id": "step-4",
      "label": "Schedule trigger (1 min)",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Map fields for further processing",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "string",
              "value": {
                "expression": "{{ record.output }}"
              }
            },
            {
              "name": "threadId",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-13\"].record[\"threadId\"] }}"
              }
            },
            {
              "name": "to",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-13\"].record[\"from\"][\"text\"] }}"
              }
            },
            {
              "name": "subject",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-13\"].record[\"subject\"] }}"
              }
            },
            {
              "name": "messageId",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-8\"].record[\"id\"] }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Convert response to HTML",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "mode": "markdownToHtml",
        "options": {
          "simpleLineBreaks": false
        },
        "markdown": {
          "expression": "{{ record.response }}"
        },
        "destinationKey": "response"
      }
    },
    {
      "id": "step-7",
      "label": "Build email raw",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "raw",
              "type": "string",
              "value": {
                "expression": "To: {{ record.to }}\nSubject: {{ record.subject }}\nContent-Type: text/html; charset=\"utf-8\"\n\n{{ record.response }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Get threads with specific labels",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "filters": {
          "labelIds": []
        },
        "resource": "thread",
        "returnAll": true
      }
    },
    {
      "id": "step-9",
      "label": "Ask OpenAI Assistant",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.text }}"
        },
        "prompt": "define",
        "options": {},
        "resource": "assistant",
        "assistantId": {
          "configuration_input": "step-9-assistantid"
        }
      }
    },
    {
      "id": "step-10",
      "label": "Loop over threads",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Get thread messages",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "options": {
          "returnOnlyMessages": true
        },
        "resource": "thread",
        "threadId": {
          "expression": "{{ record.id }}"
        },
        "operation": "get"
      }
    },
    {
      "id": "step-12",
      "label": "Return last message in thread",
      "operation": "limit",
      "adapter": "local",
      "parameters": {
        "keep": "lastItems"
      }
    },
    {
      "id": "step-13",
      "label": "Get single message content",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "simple": false,
        "options": {},
        "messageId": {
          "expression": "{{ record.id }}"
        },
        "operation": "get"
      }
    }
  ],
