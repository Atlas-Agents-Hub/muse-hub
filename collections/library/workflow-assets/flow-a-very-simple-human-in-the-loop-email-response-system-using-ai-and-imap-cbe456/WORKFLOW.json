{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-a-very-simple-human-in-the-loop-email-response-system-using-ai-and-imap-cbe456",
  "title": "A Very Simple Human in the Loop Email Response System Using AI and IMAP",
  "nodes": [
    {
      "id": "step-1",
      "label": "Email Trigger (IMAP)",
      "operation": "service-read",
      "adapter": "emailreadimap",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.textHtml }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Send Email",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
        "html": {
          "expression": "{{ steps[\"step-9\"].record.email }}"
        },
        "options": {},
        "subject": {
          "expression": "Re: {{ steps[\"step-1\"].record.subject }}"
        },
        "toEmail": {
          "expression": "{{ steps[\"step-1\"].record.from }}"
        },
        "fromEmail": {
          "expression": "{{ steps[\"step-1\"].record.to }}"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Email Summarization Chain",
      "operation": "summarize",
      "adapter": "model",
      "parameters": {
        "options": {
          "binaryDataKey": {
            "expression": "{{ record.data }}"
          },
          "summarizationMethodAndPrompts": {
            "values": {
              "prompt": {
                "expression": "Write a concise summary of the following in max 100 words:\n\n\"{{ record.data }}\"\n\nDo not enter the total number of words used."
              },
              "combineMapPrompt": {
                "expression": "Write a concise summary of the following in max 100 words:\n\n\"{{ record.data }}\"\n\nDo not enter the total number of words used."
              }
            }
          }
        },
        "operationMode": "nodeInputBinary"
      }
    },
    {
      "id": "step-5",
      "label": "Write email",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Write the text to reply to the following email:\n\n{{ record.response.text }}"
        },
        "options": {
          "systemMessage": "You are an expert at answering emails. You need to answer them professionally based on the information you have. This is a business email. Be concise and never exceed 100 words. Only the body of the email, not create the subject"
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-6",
      "label": "Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "Approve Email",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
        "message": {
          "expression": "<h3>MESSAGE</h3>\n{{ steps[\"step-1\"].record.textHtml }}\n\n<h3>AI RESPONSE</h3>\n{{ record.email }}"
        },
        "options": {},
        "subject": {
          "expression": "[Approval Required] {{ steps[\"step-1\"].record.subject }}"
        },
        "toEmail": {
          "configuration_input": "step-7-toemail"
        },
        "fromEmail": {
          "configuration_input": "step-7-fromemail"
        },
        "operation": "sendAndWait"
      }
    },
    {
      "id": "step-8",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-9",
      "label": "Set Email text",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "email",
              "type": "string",
              "value": {
                "expression": "{{ record.output }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Approved?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.data.approved }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    }
  ],
