                    "operator": {
                      "type": "string",
                      "operation": "contains"
                    },
                    "leftValue": {
                      "expression": "{{ record.message.text }}"
                    },
                    "rightValue": "@NCNAI_BOT"
                  }
                ]
              },
              "renameOutput": true
            },
