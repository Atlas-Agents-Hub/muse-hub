{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-ai-chat-with-any-data-source-using-the-muse-workflow-tool-2c7c26",
  "title": "AI chat with any data source (using the Muse workflow tool)",
  "nodes": [
    {
      "id": "step-1",
      "label": "On new manual Chat Message",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-3",
      "label": "Hacker News",
      "operation": "service-read",
      "adapter": "hackernews",
      "parameters": {
        "limit": 50,
        "resource": "all",
        "additionalFields": {}
      }
    },
    {
      "id": "step-4",
      "label": "Clean up data",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "title",
              "stringValue": {
                "expression": "{{ record._highlightResult.title.value }}"
              }
            },
            {
              "name": "points",
              "type": "numberValue",
              "numberValue": {
                "expression": "{{ record.points }}"
              }
            },
            {
              "name": "url",
              "stringValue": {
                "expression": "{{ record.url }}"
              }
            },
            {
              "name": "created_at",
              "stringValue": {
                "expression": "{{ record.created_at }}"
              }
            },
            {
              "name": "author",
              "stringValue": {
                "expression": "{{ record.author }}"
              }
            }
          ]
        },
        "include": "none",
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "maxIterations": 10
        }
      }
    },
    {
      "id": "step-6",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "Stringify",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "return {\n 'response': JSON.stringify(records.map(x => x.json))\n}",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Custom tool to call the wf below",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "hn_tool",
        "workflowId": {
          "expression": "{{ workflow_id }}"
        },
        "description": "Returns a list of the most popular posts ever on Hacker News, in json format"
      }
    }
  ],
  "edges": [
    {
      "from": "step-3",
      "to": "step-4",
