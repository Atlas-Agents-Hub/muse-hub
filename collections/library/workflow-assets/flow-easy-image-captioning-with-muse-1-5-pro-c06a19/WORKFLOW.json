    },
    {
      "id": "step-2",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "jsonSchemaExample": {
          "json": {
            "caption_title": "",
            "caption_text": ""
          }
        }
      }
    },
    {
      "id": "step-4",
      "label": "Get Info",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "operation": "information"
      }
    },
    {
      "id": "step-5",
      "label": "Resize For AI",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "width": 512,
        "height": 512,
        "options": {},
        "operation": "resize"
      }
    },
    {
      "id": "step-6",
      "label": "Calculate Positioning",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "const { size, output } = record.json;\n\nconst lineHeight = 35;\nconst fontSize = Math.round(size.height / lineHeight);\nconst maxLineLength = Math.round(size.width/fontSize) * 2;\nconst text = `\"${output.caption_title}\". ${output.caption_text}`;\nconst numLinesOccupied = Math.round(text.length / maxLineLength);\n\nconst verticalPadding = size.height * 0.02;\nconst horizontalPadding = size.width * 0.02;\nconst rectPosX = 0;\nconst rectPosY = size.height - (verticalPadding * 2.5) - (numLinesOccupied * fontSize);\nconst textPosX = horizontalPadding;\nconst textPosY = size.height - (numLinesOccupied * fontSize) - (verticalPadding/2);\n\nreturn {\n caption: {\n fontSize,\n maxLineLength,\n numLinesOccupied,\n rectPosX,\n rectPosY,\n textPosX,\n textPosY,\n verticalPadding,\n horizontalPadding,\n }\n}",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-7",
      "label": "Apply Caption to Image",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "multiStep",
        "operations": {
          "operations": [
            {
              "color": {
                "expression": "#0000008c"
              },
              "operation": "draw",
              "endPositionX": {
                "expression": "{{ record.size.width }}"
              },
              "endPositionY": {
                "expression": "{{ record.size.height }}"
              },
              "startPositionX": {
                "expression": "{{ record.caption.rectPosX }}"
              },
              "startPositionY": {
                "expression": "{{ record.caption.rectPosY }}"
              }
            },
            {
              "font": "/usr/share/fonts/truetype/msttcorefonts/Arial.ttf",
              "text": {
                "expression": "\"{{ record.output.caption_title }}\". {{ record.output.caption_text }}"
              },
              "fontSize": {
                "expression": "{{ record.caption.fontSize }}"
              },
              "fontColor": "#FFFFFF",
              "operation": "text",
              "positionX": {
                "expression": "{{ record.caption.textPosX }}"
              },
              "positionY": {
                "expression": "{{ record.caption.textPosY }}"
              },
              "lineLength": {
                "expression": "{{ record.caption.maxLineLength }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Merge Image & Caption",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "step-9",
      "label": "Merge Caption & Positions",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "step-10",
      "label": "Get Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-10-url"
        },
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Image Captioning Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Generate a caption for this image.",
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "You role is to provide an appropriate image caption for user provided images.\n\nThe individual components of a caption are as follows: who, when, where, context and miscellaneous. For a really good caption, follow this template: who + when + where + context + miscellaneous\n\nGive the caption a punny title."
              }
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    }
  ],
