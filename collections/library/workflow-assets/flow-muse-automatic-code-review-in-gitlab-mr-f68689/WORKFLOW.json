{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-muse-automatic-code-review-in-gitlab-mr-f68689",
  "title": "ChatGPT Automatic Code Review in Gitlab MR",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": {
          "configuration_input": "step-1-path"
        },
        "options": {},
        "httpMethod": "POST"
      }
    },
    {
      "id": "step-2",
      "label": "Code",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nvar diff = record.json.gitDiff\n\nlet lines = diff.trimEnd().split('\\n');\n\nlet originalCode = '';\nlet newCode = '';\n\nlines.forEach(line => {\n console.log(line)\n if (line.startsWith('-')) {\n originalCode += line + \"\\n\";\n } else if (line.startsWith('+')) {\n newCode += line + \"\\n\";\n } else {\n originalCode += line + \"\\n\";\n newCode += line + \"\\n\";\n }\n});\n\nreturn {\n originalCode:originalCode,\n newCode:newCode\n};",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Split Out1",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "changes"
      }
    },
    {
      "id": "step-4",
      "label": "OpenAI Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-5",
      "label": "Get Changes1",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://gitlab.com/api/v4/projects/{{ record[\"body\"][\"project_id\"] }}/merge_requests/{{ record[\"body\"][\"merge_request\"][\"iid\"] }}/changes"
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Skip File Change1",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.renamed_file }}"
              },
              "rightValue": ""
            },
            {
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.deleted_file }}"
              },
              "rightValue": ""
            },
            {
              "operator": {
                "type": "string",
                "operation": "startsWith"
              },
              "leftValue": {
                "expression": "{{ record.diff }}"
              },
              "rightValue": "@@"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Parse Last Diff Line1",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "const parseLastDiff = (gitDiff) => {\n gitDiff = gitDiff.replace(/\\n\\\\ No newline at end of file/, '')\n \n const diffList = gitDiff.trimEnd().split('\\n').reverse();\n const lastLineFirstChar = diffList?.[0]?.[0];\n const lastDiff =\n diffList.find((item) => {\n return /^@@ \\-\\d+,\\d+ \\+\\d+,\\d+ @@/g.test(item);\n }) || '';\n\n const [lastOldLineCount, lastNewLineCount] = lastDiff\n .replace(/@@ \\-(\\d+),(\\d+) \\+(\\d+),(\\d+) @@.*/g, ($0, $1, $2, $3, $4) => {\n return `${+$1 + +$2},${+$3 + +$4}`;\n })\n .split(',');\n \n if (!/^\\d+$/.test(lastOldLineCount) || !/^\\d+$/.test(lastNewLineCount)) {\n return {\n lastOldLine: -1,\n lastNewLine: -1,\n gitDiff,\n };\n }\n\n\n const lastOldLine = lastLineFirstChar === '+' ? null : (parseInt(lastOldLineCount) || 0) - 1;\n const lastNewLine = lastLineFirstChar === '-' ? null : (parseInt(lastNewLineCount) || 0) - 1;\n\n return {\n lastOldLine,\n lastNewLine,\n gitDiff,\n };\n};\n\nreturn parseLastDiff(record.json.diff)",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Post Discussions1",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://gitlab.com/api/v4/projects/{{ steps[\"step-1\"].record[\"body\"][\"project_id\"] }}/merge_requests/{{ steps[\"step-1\"].record[\"body\"][\"merge_request\"][\"iid\"] }}/discussions"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "body",
              "value": {
                "expression": "{{ steps[\"step-10\"].record[\"text\"] }}"
              }
            },
            {
              "name": "position[position_type]",
              "value": "text"
            },
            {
              "name": "position[old_path]",
              "value": {
                "expression": "{{ steps[\"step-3\"].record.old_path }}"
              }
            },
            {
              "name": "position[new_path]",
              "value": {
                "expression": "{{ steps[\"step-3\"].record.new_path }}"
              }
            },
            {
              "name": "position[start_sha]",
              "value": {
                "expression": "{{ steps[\"step-5\"].record.diff_refs.start_sha }}"
              }
            },
            {
              "name": "position[head_sha]",
              "value": {
                "expression": "{{ steps[\"step-5\"].record.diff_refs.head_sha }}"
              }
            },
            {
              "name": "position[base_sha]",
              "value": {
                "expression": "{{ steps[\"step-5\"].record.diff_refs.base_sha }}"
              }
            },
            {
              "name": "position[new_line]",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.lastNewLine || '' }}"
              }
            },
            {
              "name": "position[old_line]",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.lastOldLine || '' }}"
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "PRIVATE-TOKEN"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Need Review1",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "name": "filter.operator.equals",
                "type": "string",
                "operation": "equals"
              },
              "leftValue": {
                "expression": "{{ record.body.object_attributes.note }}"
              },
              "rightValue": "+0"
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Basic LLM Chain1",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "File path：{{ steps[\"step-6\"].record.new_path }}\n\n```Original code\n {{ record.originalCode }}\n```\nchange to\n```New code\n {{ record.newCode }}\n```\nPlease review the code changes in this section:"
        },
        "messages": {
          "messageValues": [
            {
              "message": "# Overview:\n You are a senior programming expert Bot, responsible for reviewing code changes and providing review recommendations.\n At the beginning of the suggestion, it is necessary to clearly make a decision to \"reject\" or \"accept\" the code change, and rate the change in the format \"Change Score: Actual Score\", with a score range of 0-100 points.\n Then, point out the existing problems in concise language and a stern tone.\n If you feel it is necessary, you can directly provide the modified content.\n Your review proposal must use rigorous Markdown format."
            }
          ]
        }
      }
    }
