  "id": "flow-integrating-ai-with-open-meteo-api-for-enhanced-weather-forecasting-0fa838",
  "title": "Integrating AI with Open-Meteo API for Enhanced Weather Forecasting",
  "nodes": [
    {
      "id": "step-1",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "public": true,
        "options": {
          "title": "N8N 👋",
          "subtitle": "Weather Assistant: Example of Tools Using ChatGPT",
          "allowFileUploads": false,
          "loadPreviousSession": "memory"
        },
        "initialMessages": "Type like this: Weather Forecast for the Next 7 Days in São Paulo"
      }
    },
    {
      "id": "step-2",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Generic AI Tool Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Chat Memory Buffer",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "A tool to get the weather forecast based on geolocation",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "latitude"
            },
            {
              "name": "longitude"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,precipitation_sum",
              "valueProvider": "fieldValue"
            },
            {
              "name": "timezone",
              "value": "GMT",
              "valueProvider": "fieldValue"
            },
            {
              "name": "forecast_days"
            }
          ]
        },
        "toolDescription": "To get forecast of next [forecast_days] input the geolocation of an City",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "longitude",
              "type": "number",
              "description": "longitude"
            },
            {
              "name": "latitude",
              "type": "number",
              "description": "latitude"
            },
            {
              "name": "forecast_days",
              "type": "number",
              "description": "forecast_days number of days ahead"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "A tool for inputting the city and obtaining geolocation",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://geocoding-api.open-meteo.com/v1/search"
        },
        "sendQuery": true,
        "parametersQuery": {
          "values": [
            {
              "name": "name"
            },
            {
              "name": "count",
              "value": "1",
              "valueProvider": "fieldValue"
            },
            {
              "name": "format",
              "value": "json",
              "valueProvider": "fieldValue"
            }
          ]
        },
        "toolDescription": "Input the City and get geolocation, geocode or coordinates from Requested City",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "name",
              "type": "string",
              "description": "Requested City"
            }
          ]
        }
      }
    }
  ],
