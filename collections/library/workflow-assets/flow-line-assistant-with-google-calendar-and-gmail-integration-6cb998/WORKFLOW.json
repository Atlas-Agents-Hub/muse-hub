{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-line-assistant-with-google-calendar-and-gmail-integration-6cb998",
  "title": "LINE Assistant with Google Calendar and Gmail Integration",
  "nodes": [
    {
      "id": "step-1",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.body.events[0].message.text }}"
        },
        "options": {
          "systemMessage": {
            "expression": "You are a helpful assistant.\n\nHere is the current date {{ current_time }}"
          }
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-2",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ record.body.events[0].source.userId }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-3",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Wikipedia",
      "operation": "service-read",
      "adapter": "toolwikipedia",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "OpenAI",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-5-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Your task is to extract and condense the answer into an easily readable format. Don't provide a link or details such as \"ดูเพิ่มเติม\" or \"ดูรายละเอียดได้ที่นี่.\""
            },
            {
              "content": {
                "expression": "{{ record.output }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Switch Between Text and Others",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ steps[\"step-7\"].record.body.events[0].message.type }}"
                    },
                    "rightValue": "text"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "step-7",
      "label": "Line Receiving",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "linechatbotagent",
        "options": {},
        "httpMethod": "POST"
      }
    },
    {
      "id": "step-8",
      "label": "Error Handling from AI Response",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "exists",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.message.content }}"
                    },
                    "rightValue": {
                      "expression": "{{ record.output }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Text Cleansing",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "message.content",
              "type": "string",
              "value": {
                "expression": "{{ record.message.content.replaceAll(\"\\n\",\"\\\\n\").replaceAll(\"\\n\",\"\").removeMarkdown().removeTags().replaceAll('\"',\"\") }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Line Answering (Error Case)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-10-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"replyToken\": \"{{ steps[\"step-7\"].record.body.events[0].replyToken }}\",\n \"messages\": [\n {\n \"type\": \"text\",\n \"text\": \"กรุณาส่งอย่างอื่นเถอะนะเตงอัว\"\n }\n ]}"
        },
        "sendBody": true,
        "jsonHeaders": {
          "json": {
            "Authorization": {
              "configuration_input": "step-10-jsonheaders-body-authorization"
            },
            "Content-Type": "application/json"
          }
        },
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "json"
      }
    },
    {
      "id": "step-11",
      "label": "Line Answering (Ordinary Case)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-11-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"replyToken\": \"{{ steps[\"step-7\"].record.body.events[0].replyToken }}\",\n \"messages\": [\n {\n \"type\": \"text\",\n \"text\": \"{{ record.message.content }}\"\n }\n ]}"
        },
        "sendBody": true,
        "jsonHeaders": {
          "json": {
            "Authorization": {
              "configuration_input": "step-11-jsonheaders-body-authorization"
            },
            "Content-Type": "application/json"
          }
        },
        "sendHeaders": true,
        "specifyBody": "json",
        "specifyHeaders": "json"
      }
    },
    {
      "id": "step-12",
      "label": "Google Calendar Create",
      "operation": "service-read",
      "adapter": "googlecalendar",
      "parameters": {
        "end": {
          "expression": "{{ $fromAI(\"createenddate\",\"end date and time to create event\") }}"
        },
        "start": {
          "expression": "{{ $fromAI(\"createstartdate\",\"start date and time to create event\") }}"
        },
        "calendar": {
          "configuration_input": "step-12-calendar"
        },
        "additionalFields": {
          "summary": {
            "expression": "{{ $fromAI(\"event_name\",\"Name of an Event\") }}"
          }
        }
      }
    },
    {
      "id": "step-13",
      "label": "Google Calendar Read",
      "operation": "service-read",
      "adapter": "googlecalendar",
      "parameters": {
        "limit": 5,
        "options": {
          "timeMax": {
            "expression": "{{ $fromAI(\"enddate\",\"end date user mentioned about\") }}"
          },
          "timeMin": {
            "expression": "{{ $fromAI(\"startdate\",\"start date user mentioned about\") }}"
          }
        },
        "calendar": {
          "configuration_input": "step-13-calendar"
        },
        "operation": "getAll"
      }
    },
    {
      "id": "step-14",
      "label": "Gmail Read",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "limit": 5,
        "filters": {
          "receivedAfter": {
            "expression": "{{ $fromAI(\"receiveddate\",\"the date email received\") }}"
          }
        },
        "operation": "getAll"
      }
    }
  ],
