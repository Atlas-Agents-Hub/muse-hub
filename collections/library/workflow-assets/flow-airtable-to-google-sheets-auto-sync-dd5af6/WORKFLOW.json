{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-airtable-to-google-sheets-auto-sync-dd5af6",
  "title": "Airtable to Google Sheets Auto-Sync",
  "nodes": [
    {
      "id": "step-1",
      "label": "Manual Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Airtable Search",
      "operation": "service-read",
      "adapter": "airtable",
      "parameters": {
        "operation": "search",
        "baseId": {
          "configuration_input": "step-2-baseid"
        },
        "table": "TableName",
        "filterByFormula": "{LastUpdated} >= DATEADD(TODAY(), -1, 'days')"
      }
    },
    {
      "id": "step-3",
      "label": "Google Sheets Upsert",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "operation": "upsert",
        "sheetId": {
          "configuration_input": "step-3-sheetid"
        },
        "range": "A1:E1000",
        "columnHeaderRow": 1,
        "valueInputMode": "RAW",
        "options": {
          "compareColumn": "Email"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    }
  ],
