    {
      "id": "step-5",
      "label": "If contains DHL data",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.tracking }}"
              },
              "rightValue": ""
            }
          ]
        }
