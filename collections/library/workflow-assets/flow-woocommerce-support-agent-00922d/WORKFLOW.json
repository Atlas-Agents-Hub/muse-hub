    },
    {
      "id": "step-6",
      "label": "Extract Tracking Data",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "tracking",
              "type": "array",
              "value": {
                "expression": "{{ record.meta_data.filter(data => data.key === '_wc_shipment_tracking_items').flatMap(data => data.value) }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Merge Orders",
      "operation": "join",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Merge Order and Tracking Data",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-9",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "tracking"
      }
    },
    {
      "id": "step-10",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "tracking"
      }
    },
    {
      "id": "step-11",
      "label": "Merge Tracking Data",
      "operation": "join",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-12",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ steps[\"step-31\"].record.sessionId }}"
        },
        "sessionIdType": "customKey",
        "contextWindowLength": 10
      }
    },
    {
      "id": "step-13",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-14",
      "label": "WooCommerce - Get User",
      "operation": "service-read",
      "adapter": "woocommerce",
      "parameters": {
        "limit": 1,
        "filters": {
          "email": {
            "expression": "{{ record.email }}"
          }
        },
        "resource": "customer",
        "operation": "getAll"
      }
    },
    {
      "id": "step-15",
      "label": "If order found",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": {
                "expression": "{{ Object.keys(record).length }}"
              },
              "rightValue": 0
            }
          ]
        }
      }
    },
    {
      "id": "step-16",
      "label": "WooCommerce Get Orders",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-16-url"
        },
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "customer",
              "value": {
                "expression": "{{ record.id }}"
              }
            },
            {
              "name": "include",
              "value": {
                "expression": "{{ steps[\"step-2\"].record.query.split(',').filter(data => !data.includes('@')).join(',') }}"
              }
            }
          ]
        }
      }
    },
    {
