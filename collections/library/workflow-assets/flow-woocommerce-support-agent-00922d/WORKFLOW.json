  "title": "WooCommerce Support-Agent",
  "nodes": [
    {
      "id": "step-1",
      "label": "No email provided",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "string",
              "value": "No email address got provided."
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "If email provided",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEmpty",
