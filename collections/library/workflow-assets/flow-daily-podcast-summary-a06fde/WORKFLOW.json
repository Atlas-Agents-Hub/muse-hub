{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-daily-podcast-summary-a06fde",
  "title": "Daily Podcast Summary",
  "nodes": [
    {
      "id": "step-1",
      "label": "Gmail",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "message": {
          "expression": "{{ record.html }}"
        },
        "options": {},
        "subject": "Podcast Review"
      }
    },
    {
      "id": "step-2",
      "label": "TaddyTopDaily",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-2-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": {
                "expression": "query { getTopChartsByGenres( limitPerPage:10, filterByCountry:UNITED_STATES_OF_AMERICA, taddyType:PODCASTEPISODE, genres:PODCASTSERIES_{{ record.genre }}){ topChartsId podcastEpisodes{ uuid name audioUrl podcastSeries{ uuid name } } } }"
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-USER-ID"
            },
            {
              "name": "X-API-KEY"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Genre",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "genre",
              "type": "string",
              "value": "TECHNOLOGY"
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "data.getTopChartsByGenres.podcastEpisodes"
      }
    },
    {
      "id": "step-5",
      "label": "Whisper Transcribe Audio",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "whisper-1"
            },
            {
              "name": "file",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Final Data",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{\n\"podcast\": \"{{ steps[\"step-2\"].record.data.getTopChartsByGenres.podcastEpisodes[record_index].podcastSeries.name }}\",\n\"name\": \"{{ steps[\"step-2\"].record.data.getTopChartsByGenres.podcastEpisodes[record_index].name.replace(/\\\"/g,'\\\"') }}\",\n \"url\":\"{{ steps[\"step-2\"].record.data.getTopChartsByGenres.podcastEpisodes[record_index].audioUrl.replace(/\"/g,'') }}\",\n\"summary\":\"{{ record.message.content.replace(/\\\\/g, '\\\\\\\\').replace(/\"/g, '\\\\\"').replace(/\\n/g, '<br/>').replace(/\\r/g, '\\\\r').replace(/\\t/g, '\\\\t') }}\"\n \n}"
        }
      }
    },
    {
      "id": "step-7",
      "label": "Merge Results",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "return [{fields:records.map(x=>x.json)}]",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "HTML",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "<!DOCTYPE html>\n<html>\n<head>\n <meta charset=\"UTF-8\" />\n</head>\n<body>\n <table>\n <tr> \n {{ ['Podcast', 'Episode', 'Summary'].map(propname=>'<td><h4>'+propname+'</h4></td>').join('') }}\n </tr>\n {{ record.fields.map(ep=>{ return `<tr><td>${ep.podcast}</td><td><a href=\"${ep.url}\">${ep.name}</a></td><td>${ep.summary}</td><td></td></tr>`} ) }}\n </table>\n</body>\n</html>\n\n<style>\ntr { \n border: 1px solid #000; \n padding: 8px; \n }\n.container {\n background-color: #ffffff;\n text-align: center;\n padding: 16px;\n border-radius: 8px;\n}\n\nh1 {\n color: #ff6d5a;\n font-size: 24px;\n font-weight: bold;\n padding: 8px;\n}\n\nh2 {\n color: #909399;\n font-size: 18px;\n font-weight: bold;\n padding: 8px;\n}\n</style>"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Summarize Podcast",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "model": {
          "configuration_input": "step-9-model"
        },
        "prompt": {
          "messages": [
            {
              "content": {
                "expression": "Summarize the major points of the following podcast: {{ record.text }}. Start your answer by saying 'This episode focuses on', 'This episode is about', etc. Contain your answer to 3-4 paragraphs max, and focus on only key information."
              }
            }
          ]
        },
        "options": {
          "maxTokens": 500
        },
        "resource": "chat",
        "requestOptions": {}
      }
    },
    {
      "id": "step-10",
      "label": "Schedule",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Request Audio Crop",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-11-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "1",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "data"
            },
            {
              "name": "convertOption",
              "value": {
                "json": {
                  "startTime": "00:08:00",
                  "endTime": "00:24:00",
                  "audioFormat": "mp3"
                }
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "*/*("
            },
            {
              "name": "Connection",
              "value": "keep-alive"
            },
            {
              "name": "Origin",
              "value": {
                "configuration_input": "step-11-parameters-2-value"
              }
            },
            {
              "name": "Referer",
              "value": {
                "configuration_input": "step-11-parameters-3-value"
              }
            },
            {
              "name": "Sec-Fetch-Dest",
              "value": "empty"
            },
            {
              "name": "Sec-Fetch-Mode",
              "value": "cors"
            },
            {
              "name": "Sec-Fetch-Site",
              "value": "same-site"
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Get Download Link",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.products.aspose.app/audio/cutter/api/cutter/HandleStatus?fileRequestId={{ steps[\"step-11\"].record.Data.FileRequestId }}"
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json, text/javascript, */*; q=0.01"
            },
            {
              "name": "Connection",
              "value": "keep-alive"
            },
            {
              "name": "Origin",
              "value": {
                "configuration_input": "step-12-parameters-2-value"
              }
            },
            {
              "name": "Referer",
              "value": {
                "configuration_input": "step-12-parameters-3-value"
              }
            },
            {
              "name": "Sec-Fetch-Dest",
              "value": "empty"
            },
            {
              "name": "Sec-Fetch-Dest",
              "value": "cors"
            },
            {
              "name": "Sec-Fetch-Dest",
              "value": "same-site"
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Download Cut MP3",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.Data.DownloadLink }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-14",
      "label": "Download Podcast",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.audioUrl }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-15",
      "label": "Wait",
      "operation": "wait",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-16",
      "label": "If Downloads Ready",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ records.map(x=>x.json.Data.DownloadLink).reduce((accumulator, currentValue) => accumulator && currentValue, true)\n}}"
              },
              "rightValue": ""
            }
          ]
        },
        "looseTypeValidation": true
      }
    }
  ],
