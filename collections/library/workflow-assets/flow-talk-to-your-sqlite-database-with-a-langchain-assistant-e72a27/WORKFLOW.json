{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-talk-to-your-sqlite-database-with-a-langchain-assistant-e72a27",
  "title": "Talk to your SQLite database with a LangChain Assistant",
  "nodes": [
    {
      "id": "step-1",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "contextWindowLength": 10
      }
    },
    {
      "id": "step-2",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.3
        }
      }
    },
    {
      "id": "step-3",
      "label": "When clicking \"Test workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Get chinook.zip example",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-4-url"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Extract zip file",
      "operation": "file",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-6",
      "label": "Save chinook.db locally",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fileName": "./chinook.db",
        "operation": "write",
        "dataPropertyName": "file_0"
      }
    },
    {
      "id": "step-7",
      "label": "Load local chinook.db",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fileSelector": "./chinook.db"
      }
    },
    {
      "id": "step-8",
      "label": "Combine chat input with the binary",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {
          "includeBinary": true
        },
        "jsonOutput": {
          "expression": "{{ steps[\"step-10\"].record }}"
        }
      }
    },
    {
      "id": "step-9",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "agent": "sqlAgent",
        "options": {},
        "dataSource": "sqlite"
      }
    },
    {
      "id": "step-10",
      "label": "Chat Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    }
  ],
