    },
    {
      "id": "step-7",
      "label": "Expense text to JSON parser",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "convert expense to JSON: \n\n{{ record.input1 }}"
        },
        "options": {},
        "attributes": {
          "attributes": [
            {
              "name": "cost",
              "type": "number",
              "required": true,
              "description": "expense cost"
            },
            {
              "name": "descr",
              "required": true,
              "description": "description of expense"
            },
            {
              "name": "date",
              "type": "date",
              "description": "date in UTC format. "
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Save expense into Google Sheets",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "msg": {
              "expression": "{{ steps[\"step-3\"].record.input1 }}"
            },
            "cost": {
              "expression": "{{ record.output.cost }}"
            },
            "date": {
              "expression": "{{ record.output.date ? record.output.date : current_time }}"
            },
            "descr": {
              "expression": "{{ record.output.descr }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "date",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "cost",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "descr",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "msg",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {
          "useAppend": true
        },
        "operation": "append",
        "sheetName": {
          "configuration_input": "step-8-sheetname"
        },
        "documentId": {
          "configuration_input": "step-8-documentid"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Parse msg and save to Sheets",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "save_expense_in_db",
        "workflowId": {
          "configuration_input": "step-9-workflowid"
        },
        "description": "Call this tool to save expense in db.",
        "workflowInputs": {
          "value": {
