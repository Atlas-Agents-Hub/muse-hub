      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-12\"].records[0].base }}/approvals/log"
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ approval_id: record.request_id, decision: record.decision, by: record.decided_by, comment: record.comment }) }}"
        }
      }
    },
