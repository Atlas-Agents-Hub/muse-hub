        "url": {
          "expression": "{{ steps[\"step-2\"].records[0].base }}/approvals/request"
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ request_id: record.request_id, approver: record.approver, deputy: record.deputy, amount: record.amount, type: record.type, vendor: record.vendor, description: record.description, requester: record.requester, channel: steps[\"step-2\"].records[0].channel, sla_hours: record.sla_hours }) }}"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Notify requester",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-2\"].records[0].base }}/messages/send"
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: \"email\", to: steps[\"step-4\"].records[0].requester, body: \"Request \" + steps[\"step-4\"].records[0].request_id + \": \" + (record.approval_id ? \"sent to \" + record.sent_to + \" for approval (\" + steps[\"step-4\"].records[0].reason + \")\" : \"approved automatically under policy\") }) }}"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Outcome",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const p = steps[\"step-4\"].records[0];\nreturn [{ json: { request_id: p.request_id, type: p.type, amount: p.amount, decision: p.decision, approver: p.approver, deputy: p.deputy, reason: p.reason } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-10",
      "label": "Respond 200 (request routed)",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "expression": "{{ JSON.stringify(record) }}"
        },
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "step-11",
      "label": "Webhook: decision received (Slack button)",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-decision",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-12",
      "label": "Config (decisions)",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-12-assignments-0-value"
              },
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-13",
      "label": "Validate decision",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const b = steps[\"step-11\"].records[0].body;\nconst sd = $getWorkflowStaticData('global'); sd.log = sd.log || [];\nconst prior = sd.log.find(x => x.request_id === b.request_id);\nif (!prior) return [{ json: { request_id: b.request_id, ok: false, error: 'unknown request' } }];\nif (prior.decision !== 'PENDING') return [{ json: { request_id: b.request_id, ok: false, error: 'already decided: ' + prior.decision } }];\nif (b.decided_by !== prior.approver) return [{ json: { request_id: b.request_id, ok: false, error: `decision from ${b.decided_by} but request is with ${prior.approver}` } }];\nprior.decision = b.decision; prior.decided_by = b.decided_by; prior.decided_at = new Date().toISOString();\nreturn [{ json: { request_id: b.request_id, ok: true, decision: b.decision, decided_by: b.decided_by, comment: b.comment || '' } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-14",
      "label": "Decision valid?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.ok }}"
              },
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-15",
