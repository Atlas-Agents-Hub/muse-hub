      "label": "Webhook: run escalation sweep now",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "approval-sweep",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-20",
      "label": "Config (sweep)",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-20-assignments-0-value"
              },
              "type": "string"
            },
            {
              "name": "sla_hours",
              "value": "24",
              "type": "string"
            },
            {
              "name": "force",
              "value": {
                "expression": "{{ record.body && record.body.force ? 'true' : 'false' }}"
              },
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-21",
      "label": "Approvals: pending past SLA",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "GET",
        "url": {
          "expression": "{{ steps[\"step-20\"].records[0].base }}/approvals/pending"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "older_than_sec",
              "value": {
                "expression": "{{ record.force === 'true' ? 0 : Number(record.sla_hours) * 3600 }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-22",
      "label": "Pick overdue requests",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const rows = record.rows || [];\nconst out = rows.map(a => ({ json: { approval_id: a.id, approver: a.request.approver, escalate_to: a.request.deputy || '[configured contact]', amount: a.request.amount, requester: a.request.requester, waited_hours: Math.round((Date.now() / 1000 - a.created) / 36) / 100 } }));\nreturn out.length ? out : [{ json: { none: true } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-23",
      "label": "Anything overdue?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.none === true }}"
              },
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-24",
      "label": "Escalate to deputy or CEO (Slack)",
      "operation": "http",
      "adapter": "http",
