{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-publish-one-video-natively-to-tiktok-instagram-and-youtube-with-postwire-35be2a",
  "title": "Publish one video natively to TikTok Instagram and YouTube with PostWire",
  "nodes": [
    {
      "id": "step-1",
      "label": "When you click Test workflow",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Your idea, video and platforms",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "idea",
              "value": "Announce that our AI meal planner now builds a full week of recipes from one photo of your fridge. Friendly, build-in-public tone.",
              "type": "string"
            },
            {
              "name": "video_url",
              "value": {
                "configuration_input": "step-2-assignments-1-value"
              },
              "type": "string"
            },
            {
              "name": "platforms",
              "value": {
                "expression": "{{ [\"tiktok\", \"instagram\", \"youtube\"] }}"
              },
              "type": "array"
            },
            {
              "name": "brand_voice",
              "value": "Plain language, first person, no hype, at most one emoji.",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Write a native caption per platform",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ prompt: record.idea, platforms: record.platforms, media_url: record.video_url, brand_voice: record.brand_voice }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Publish to every connected account",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-4-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ platforms: steps[\"step-2\"].record.platforms, video_url: steps[\"step-2\"].record.video_url, per_platform: record.drafts, options: { tiktok: { privacy_level: 'SELF_ONLY' } } }) }}"
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
