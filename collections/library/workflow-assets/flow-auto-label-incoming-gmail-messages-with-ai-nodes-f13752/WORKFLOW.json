{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-auto-label-incoming-gmail-messages-with-ai-nodes-f13752",
  "title": "Auto-label incoming Gmail messages with AI nodes",
  "nodes": [
    {
      "id": "step-1",
      "label": "Gmail trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "filters": {},
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Get message content",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "simple": false,
        "options": {},
        "messageId": {
          "expression": "{{ record.id }}"
        },
        "operation": "get"
      }
    },
    {
      "id": "step-3",
      "label": "Set label values",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "labels",
              "type": "arrayValue",
              "arrayValue": {
                "expression": "{{ record.labels }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Get all labels",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "resource": "label",
        "returnAll": true
      }
    },
    {
      "id": "step-5",
      "label": "Split out assigned labels",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "labels"
      }
    },
    {
      "id": "step-6",
      "label": "Merge corresponding labels",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "mergeByFields": {
          "values": [
            {
              "field1": "name",
              "field2": "labels"
            }
          ]
        },
        "outputDataFrom": "input1"
      }
    },
    {
      "id": "step-7",
      "label": "Aggregate label IDs",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "renameField": true,
              "outputFieldName": "label_ids",
              "fieldToAggregate": "id"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Add labels to message",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "labelIds": {
          "expression": "{{ record.label_ids }}"
        },
        "messageId": {
          "expression": "{{ steps[\"step-1\"].record[\"id\"] }}"
        },
        "operation": "addLabels"
      }
    },
    {
      "id": "step-9",
      "label": "Assign labels for message",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "{{ record.text }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": "Your task is to categorize the message according to the following labels.\n\nPartnership - email about sponsored content, cooperation etc.\nInquiry - email about products, services.\nNotification - email that doesn't require response. \n\nOne email can have more than one label. Return only label names in JSON format, nothing else. Do not make things up. "
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "JSON Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "jsonSchema": {
          "json": {
            "type": "object",
            "properties": {
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Inquiry",
                    "Partnership",
                    "Notification"
                  ]
                }
              }
            },
            "required": [
              "labels"
            ]
          }
        }
      }
    },
    {
      "id": "step-11",
      "label": "Model Chat",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0
        }
      }
    }
  ],
  "edges": [
