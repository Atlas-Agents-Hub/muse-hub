{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-share-youtube-videos-with-ai-summaries-on-discord-133af8",
  "title": "Share YouTube Videos with AI Summaries on Discord",
  "nodes": [
    {
      "id": "step-1",
      "label": "YouTube Video Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "feedUrl": {
          "configuration_input": "step-1-feedurl"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Retrieve Caption Data",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-2-url"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "videoId",
              "value": {
                "expression": "{{ record.id.match(/(?:[^:]*:){2}\\s*(.*)/)[1] }}"
              }
            },
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Download Captions",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://www.googleapis.com/youtube/v3/captions/{{ record.caption.id }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Caption File Conversion",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "text",
        "destinationKey": "content"
      }
    },
    {
      "id": "step-5",
      "label": "Caption Summary with ChatGPT",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-5-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "Summarise this transcript into three bullet points to sum up what the video is about and why someone should watch it: {{ record[\"content\"] }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Post to Discord",
      "operation": "service-write",
      "adapter": "discord",
      "parameters": {
        "content": {
          "expression": "🌟 New Video Alert! 🌟\n\n**{{ steps[\"step-1\"].record[\"title\"] }}**\n\n*What’s it about?*\n\n{{ record[\"message\"][\"content\"] }}\n\n[Watch NOW]({{ steps[\"step-1\"].record[\"link\"] }}) and remember to share your thoughts!"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Find English Captions",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "caption",
              "type": "object",
              "value": {
                "expression": "{{ $jmespath( record.items, \"[?snippet.language == 'en'] | [0]\" ) }}"
              }
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-7",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-7",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-4",
      "to": "step-5",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-5",
      "to": "step-6",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-6",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
  "configuration": [
    {
      "id": "step-1-feedurl",
      "purpose": "Set the feedUrl endpoint or source URL for this operation.",
      "required": true,
      "endpoint_template": "https://www.youtube.com/feeds/videos.xml?channel_id={value}"
    },
    {
      "id": "step-2-url",
      "purpose": "Set the url endpoint or source URL for this operation.",
      "required": true,
      "endpoint_template": "https://www.googleapis.com/youtube/v3/captions"
    },
    {
      "id": "step-5-modelid",
      "purpose": "Select the modelId for this task.",
      "required": true
    }
  ],
