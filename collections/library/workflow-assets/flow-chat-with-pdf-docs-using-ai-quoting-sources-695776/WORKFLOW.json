{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-chat-with-pdf-docs-using-ai-quoting-sources-695776",
  "title": "Chat with PDF docs using AI (quoting sources)",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking \"Execute Workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "file_url",
                "value": {
                  "expression": "{{ record.file_url }}"
                }
              },
              {
                "name": "file_name",
                "value": {
                  "expression": "{{ steps[\"step-5\"].record.file_name }}"
                }
              }
            ]
          }
        },
        "dataType": "binary"
      }
    },
    {
      "id": "step-4",
      "label": "Set file URL in Google Drive",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "file_url",
              "type": "string",
              "value": {
                "configuration_input": "step-4-assignments-0-value"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Add in metadata",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "// Add a new field called 'myNewField' to the JSON of the item\nrecord.json.file_name = record.binary.data.fileName;\nrecord.json.file_ext = record.binary.data.fileExtension;\nrecord.json.file_url = steps[\"step-4\"].record.file_url\n\nreturn record;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Download file",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ record.file_url }}"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-7",
      "label": "Chat Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Prepare chunks",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "let out = \"\"\nfor (const i in records) {\n let itemText = \"--- CHUNK \" + i + \" ---\\n\"\n itemText += records[i].json.document.pageContent + \"\\n\"\n itemText += \"\\n\"\n out += itemText\n}\n\nreturn {\n 'context': out\n};",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Embeddings OpenAI2",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-11",
      "label": "Set max chunks to send to model",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "chunks",
              "type": "number",
              "value": 4
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "step-12",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "jsonSchema": {
          "json": {
            "type": "object",
            "properties": {
              "answer": {
                "type": "string"
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "step-13",
      "label": "Compose citations",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "citations",
              "type": "array",
              "value": {
                "expression": "{{ record.citations.map(i => '[' + steps[\"step-16\"].all()[record.citations].json.document.metadata.file_name + ', lines ' + steps[\"step-16\"].all()[record.citations].json.document.metadata['loc.lines.from'] + '-' + steps[\"step-16\"].all()[record.citations].json.document.metadata['loc.lines.to'] + ']') }}"
              }
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "step-14",
      "label": "Generate response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "{{ record.answer }} {{ $if(!record.citations.isEmpty(), \"\\n\" + record.citations.join(\"\"), '') }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-15",
      "label": "Answer the query based on chunks",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Use the following pieces of context to answer the question at the end. If you don't know the answer, just say that you don't know, don't try to make up an answer. Important: In your response, also include the the indexes of the chunks you used to generate the answer.\n\n{{ record.context }}\n\nQuestion: {{ steps[\"step-7\"].records[0].chatInput }}\nHelpful Answer:"
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-16",
      "label": "Get top chunks matching query",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "load",
        "topK": {
          "expression": "{{ record.chunks }}"
        },
        "prompt": {
          "expression": "{{ record.chatInput }}"
        },
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-16-pineconeindex"
        }
      }
    },
    {
      "id": "step-17",
      "label": "Add to Pinecone vector store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-17-pineconeindex"
        }
      }
    },
    {
      "id": "step-18",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "chunkSize": 3000,
        "chunkOverlap": 200
      }
    }
  ],
