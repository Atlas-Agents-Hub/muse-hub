{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-upload-to-instagram-and-tiktok-from-google-drive-42b4fb",
  "title": "Upload to Instagram and Tiktok from Google Drive",
  "nodes": [
    {
      "id": "step-1",
      "label": "Google Drive Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "configuration_input": "step-1-foldertowatch"
        }
      }
    },
    {
      "id": "step-2",
      "label": "Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ record.id || record.data[0].id }}"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-3",
      "label": "Error Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "🔔 ERROR SUBIENDO VIDEOS"
        },
        "chatId": {
          "configuration_input": "step-4-chatid"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-5",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 1,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notContains"
              },
              "leftValue": {
                "expression": "{{ record.trigger.error.message }}"
              },
              "rightValue": "The DNS server returned an error, perhaps the server is offline"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Get Audio from Video",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "audio",
        "operation": "transcribe"
      }
    },
    {
      "id": "step-7",
      "label": "Read video from Google Drive",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fileName": {
          "expression": "{{ record.originalFilename.replaceAll(\" \", \"_\") }}"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Generate Description for Videos in Tiktok and Instagram",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-8-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert assistant in creating engaging social media video titles."
            },
            {
              "content": {
                "expression": "I'm going to upload a video to social media. Here are some examples of descriptions that have worked well on Instagram:\n\nFollow and save for later. Discover InfluencersDe, the AI tool that automates TikTok creation and publishing to drive traffic to your website. Perfect for entrepreneurs and brands.\n#digitalmarketing #ugc #tiktok #ai #influencersde #contentcreation\n\nDiscover the video marketing revolution with InfluencersDe!\n.\n.\n.\n#socialmedia #videomarketing #ai #tiktok #influencersde #growthhacking\n\nDon't miss InfluencersDe, the tool that transforms your marketing strategy with just one click!\n.\n.\n.\n#ugc #ai #tiktok #digitalmarketing #influencersde #branding\n\nCan you create another title for the Instagram post based on this recognized audio from the video?\n\nAudio: {{ steps[\"step-6\"].record.text }}\n\nIMPORTANT: Reply only with the description, don't add anything else."
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Read Video from Google Drive",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "filePath": {
          "expression": "{{ steps[\"step-7\"].record.originalFilename.replaceAll(\" \", \"_\") }}"
        },
        "dataPropertyName": "datavideo"
      }
    },
    {
      "id": "step-10",
      "label": "Read Video from Google Drive2",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "filePath": {
          "expression": "{{ steps[\"step-7\"].record.originalFilename.replaceAll(\" \", \"_\") }}"
        },
        "dataPropertyName": "datavideo"
      }
    },
    {
      "id": "step-11",
      "label": "Upload Video and Description to Tiktok",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-11-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.message.content.replaceAll(\"\\\"\", \"\") }}"
              }
            },
            {
              "name": "platform[]",
              "value": "tiktok"
            },
            {
              "name": "video",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "datavideo"
            },
            {
              "name": "user",
              "value": "Add user generated in upload-post"
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Upload Video and Description to Instagram",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-12-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "title",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.message.content.replaceAll(\"\\\"\", \"\") }}"
              }
            },
            {
              "name": "platform[]",
              "value": "instagram"
            },
            {
              "name": "video",
              "parameterType": "formBinaryData",
              "inputDataFieldName": "datavideo"
            },
            {
              "name": "user",
              "value": "Add user generated in upload-post"
            }
          ]
        }
      }
    }
  ],
