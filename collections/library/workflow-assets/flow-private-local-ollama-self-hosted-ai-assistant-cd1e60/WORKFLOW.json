{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-private-local-ollama-self-hosted-ai-assistant-cd1e60",
  "title": "🔐🦙🤖 Private & Local Ollama Self-Hosted AI Assistant",
  "nodes": [
    {
      "id": "step-1",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Basic LLM Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Provide the users prompt and response as a JSON object with two fields:\n- Prompt\n- Response\n\nAvoid any preample or further explanation.\n\nThis is the question: {{ record.chatInput }}"
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-3",
      "label": "Ollama Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Structured Response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "Your prompt was: {{ record.response.Prompt }}\n\nMy response is: {{ record.response.Response }}\n\nThis is the JSON object:\n\n{{ steps[\"step-2\"].record.text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Error Response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "There was an error."
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "JSON to Object",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "object",
              "value": {
                "expression": "{{ record.text }}"
              }
            }
          ]
        }
      }
    }
  ],
