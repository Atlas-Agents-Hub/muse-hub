              },
              "type": "string"
            },
            {
              "name": "invoice_number",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.invoice_number }}"
              },
              "type": "string"
            },
            {
              "name": "amount",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.currency_amount }}"
              },
              "type": "string"
            },
            {
              "name": "customer",
              "value": {
                "expression": "{{ steps[\"step-2\"].record.customer_name }}"
              },
              "type": "string"
            },
            {
              "name": "public_url",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.public_file_url || null }}"
              },
              "type": "string"
            },
            {
              "name": "email_sent",
              "value": {
                "expression": "{{ steps[\"step-2\"].record.send_email }}"
              },
              "type": "boolean"
            }
          ]
