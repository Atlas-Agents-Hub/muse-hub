            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.retry }}"
              },
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
