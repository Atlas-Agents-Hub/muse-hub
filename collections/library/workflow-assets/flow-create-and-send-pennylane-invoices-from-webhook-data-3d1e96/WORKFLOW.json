      "label": "PL Send Invoice Email",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "https://app.pennylane.com/api/external/v2/customer_invoices/{{ steps[\"step-7\"].record.id }}/send_by_email"
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "step-13",
      "label": "Set Email Attempt",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "attempt",
              "value": {
                "expression": "{{ (record.attempt ?? 0) + 1 }}"
              },
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-14",
      "label": "IF Email Sent",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.statusCode }}"
              },
              "rightValue": 204,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-15",
      "label": "Code Evaluate Email Retry",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const statusCode = records[0].json.statusCode;\nconst attempt = steps[\"step-13\"].records[0].attempt;\nreturn [{ json: {\n  attempt,\n  status_code: statusCode,\n  retry: statusCode === 409 && attempt < 5\n} }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
