{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-youtube-video-summarization-analysis-b4ddc1",
  "title": "⚡YouTube Video Summarization & Analysis",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "ytube",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "step-3",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "transcript"
      }
    },
    {
      "id": "step-4",
      "label": "Respond to Webhook",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.title }}\n{{ record.youtubeUrl }}"
        },
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-6",
      "label": "Get YouTube URL",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "youtubeUrl",
              "type": "string",
              "value": {
                "expression": "{{ record.body.youtubeUrl }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "YouTube Video ID",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const extractYoutubeId = (url) => {\n // Regex pattern that matches both youtu.be and youtube.com URLs\n const pattern = /(?:youtube\\.com\\/(?:[^\\/]+\\/.+\\/|(?:v|e(?:mbed)?)\\/|.*[?&]v=)|youtu\\.be\\/)([^\"&?\\/\\s]{11})/;\n const match = url.match(pattern);\n return match ? match[1] : null;\n};\n\n// Input URL from previous node\nconst youtubeUrl = items[0].json.youtubeUrl; // Adjust this based on your workflow\n\n// Process the URL and return the video ID\nreturn [{\n json: {\n videoId: extractYoutubeId(youtubeUrl)\n }\n}];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Get YouTube Video",
      "operation": "service-read",
      "adapter": "youtube",
      "parameters": {
        "options": {},
        "videoId": {
          "expression": "{{ record.videoId }}"
        },
        "resource": "video",
        "operation": "get"
      }
    },
    {
      "id": "step-9",
      "label": "Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Summarize & Analyze Transcript",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Please analyze the given text and create a structured summary following these guidelines:\n\n1. Break down the content into main topics using Level 2 headers (##)\n2. Under each header:\n - List only the most essential concepts and key points\n - Use bullet points for clarity\n - Keep explanations concise\n - Preserve technical accuracy\n - Highlight key terms in bold\n3. Organize the information in this sequence:\n - Definition/Background\n - Main characteristics\n - Implementation details\n - Advantages/Disadvantages\n4. Format requirements:\n - Use markdown formatting\n - Keep bullet points simple (no nesting)\n - Bold important terms using **term**\n - Use tables for comparisons\n - Include relevant technical details\n\nPlease provide a clear, structured summary that captures the core concepts while maintaining technical accuracy.\n\nHere is the text: {{ record.concatenated_text\n }}"
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-11",
      "label": "Concatenate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToSummarize": {
          "values": [
            {
              "field": "text",
              "separateBy": " ",
              "aggregation": "concatenate"
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Response Object",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "summary",
              "type": "string",
              "value": {
                "expression": "{{ record.text }}"
              }
            },
            {
              "name": "topics",
              "type": "array",
              "value": {
                "expression": "[]"
              }
            },
            {
              "name": "title",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.snippet.title }}"
              }
            },
            {
              "name": "description",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.snippet.description }}"
              }
            },
            {
              "name": "id",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.id }}"
              }
            },
            {
              "name": "youtubeUrl",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-1\"].record.body.youtubeUrl }}"
              }
            }
          ]
        }
      }
    }
