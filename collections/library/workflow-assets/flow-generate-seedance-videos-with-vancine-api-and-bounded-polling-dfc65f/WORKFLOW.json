          "conditions": [
            {
              "leftValue": {
                "expression": "{{record.status === 'failed' || record.status === 'FAILURE' || (record.data && (record.data.status === 'failed' || record.data.status === 'FAILURE'))}}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
