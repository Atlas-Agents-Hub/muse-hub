          "expression": "{{'Seedance task ' + record.task_id + ' failed: ' + ((record.error && record.error.message) || (record.data && record.data.fail_reason) || 'unknown')}}"
        }
      }
    },
    {
      "id": "step-14",
      "label": "ifTimeout",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "type": "expression"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{(record.poll_index || 0) >= (record.maxPolls || 120)}}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
