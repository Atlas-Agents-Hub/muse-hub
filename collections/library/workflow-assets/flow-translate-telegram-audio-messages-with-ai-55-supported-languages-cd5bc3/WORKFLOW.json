{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-translate-telegram-audio-messages-with-ai-55-supported-languages-cd5bc3",
  "title": "Translate Telegram audio messages with AI (55 supported languages)",
  "nodes": [
    {
      "id": "step-1",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "*"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "Text reply",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.text }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Telegram1",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "fileId": {
          "expression": "{{ steps[\"step-1\"].record.message.voice.file_id }}"
        },
        "resource": "file"
      }
    },
    {
      "id": "step-4",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-5",
      "label": "Input Error Handling",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "message.text",
              "stringValue": {
                "expression": "{{ record?.message?.text || \"\" }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Settings",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "language_native",
              "type": "string",
              "value": "english"
            },
            {
              "name": "language_translate",
              "type": "string",
              "value": "french"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Auto-detect and translate",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Detect the language of the text that follows. \n- If it is {{ steps[\"step-6\"].record.language_native }} translate to {{ steps[\"step-6\"].record.language_translate }}. \n- If it is in {{ steps[\"step-6\"].record.language_translate }} translate to {{ steps[\"step-6\"].record.language_native }} . \n- In the output just provide the translation and do not explain it. Just provide the translation without anything else.\n\nText:\n {{ record.text }}"
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-8",
      "label": "Audio reply",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "operation": "sendAudio",
        "binaryData": true,
        "additionalFields": {}
      }
    },
    {
      "id": "step-9",
      "label": "OpenAI2",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "audio",
        "operation": "transcribe"
      }
    },
    {
      "id": "step-10",
      "label": "Model",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "input": {
          "expression": "{{ record.text }}"
        },
        "options": {},
        "resource": "audio"
      }
    }
  ],
