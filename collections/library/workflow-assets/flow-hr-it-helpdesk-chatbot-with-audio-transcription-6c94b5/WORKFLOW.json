{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-hr-it-helpdesk-chatbot-with-audio-transcription-6c94b5",
  "title": "HR & IT Helpdesk Chatbot with Audio Transcription",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "HTTP Request",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-2-url"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Extract from File",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "pdf"
      }
    },
    {
      "id": "step-4",
      "label": "Create HR Policies",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "jsonData": {
          "expression": "{{ steps[\"step-3\"].record.text }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-7",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 2000
      }
    },
    {
      "id": "step-8",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-9",
      "label": "Verify Message Type",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Text",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "array",
                      "operation": "contains",
                      "rightType": "any"
                    },
                    "leftValue": {
                      "expression": "{{ record.message.keys()}}"
                    },
                    "rightValue": "text"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Audio",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "array",
                      "operation": "contains",
                      "rightType": "any"
                    },
                    "leftValue": {
                      "expression": "{{ record.message.keys()}}"
                    },
                    "rightValue": "voice"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "step-10",
      "label": "Model",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {},
        "resource": "audio",
        "operation": "transcribe",
        "binaryPropertyName": {
          "expression": "data"
        }
      }
    },
    {
      "id": "step-11",
      "label": "Telegram1",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "fileId": {
          "expression": "{{ record.message.voice.file_id }}"
        },
        "resource": "file"
      }
    },
    {
      "id": "step-12",
      "label": "Unsupported Message Type",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": "I'm not able to process this message type.",
        "chatId": {
          "expression": "{{ record.message.chat.id }}"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-13",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.text }}"
        },
        "options": {
          "systemMessage": "You are a helpful assistant for HR and employee policies"
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-14",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-15",
      "label": "Postgres Chat Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ steps[\"step-8\"].record.message.chat.id }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-16",
      "label": "Answer questions with a vector store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "name": "hr_employee_policies",
        "description": "data for HR and employee policies"
      }
    },
    {
      "id": "step-17",
      "label": "Postgres PGVector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-18",
      "label": "Model Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-19",
      "label": "Embeddings OpenAI1",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-20",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.output }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-8\"].records[0].message.chat.id }}"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-21",
      "label": "Edit Fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "{{ record.message.text }}"
              }
            }
          ]
        },
        "includeOtherFields": true
      }
    }
