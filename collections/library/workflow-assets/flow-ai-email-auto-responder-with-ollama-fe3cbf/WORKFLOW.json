{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-ai-email-auto-responder-with-ollama-fe3cbf",
  "title": "AI Email Auto-Responder with Ollama",
  "nodes": [
    {
      "id": "step-1",
      "label": "Check Every 5 Minutes",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Get Unread Emails (IMAP)",
      "operation": "service-read",
      "adapter": "emailreadimap",
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "filters": {
          "readStatus": "unread"
        }
      }
    },
    {
      "id": "step-3",
      "label": "1. Classify Email (Ollama)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ model: 'llama3:8b', prompt: 'Classify this email into one of these categories: URGENT, QUESTION, FEEDBACK, SPAM, OTHER.\\n\\nFrom: ' + record.from + '\\nSubject: ' + record.subject + '\\nBody: ' + (record.text || '').substring(0, 1000) + '\\n\\nRespond with ONLY the category name, nothing else.', stream: false, options: { temperature: 0.1, num_predict: 20 } }) }}"
        },
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "step-4",
      "label": "Filter Spam",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "combinator": "or",
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ JSON.parse(record.data).response.trim() }}"
              },
              "rightValue": "SPAM",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "2. Draft Reply (Ollama)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ model: 'llama3:8b', prompt: 'Write a professional, helpful email reply to this message. Be concise and friendly.\\n\\nFrom: ' + steps[\"step-2\"].record.from + '\\nSubject: ' + steps[\"step-2\"].record.subject + '\\nBody: ' + (steps[\"step-2\"].record.text || '').substring(0, 2000) + '\\n\\nWrite ONLY the reply body (no subject line, no greeting format instructions). Sign off as the team.', stream: false, options: { temperature: 0.5, num_predict: 1000 } }) }}"
        },
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "step-6",
      "label": "Prepare Draft for Review",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "draft_reply",
              "value": {
                "expression": "{{ JSON.parse(record.data).response }}"
              },
              "type": "string"
            },
            {
              "name": "original_from",
              "value": {
                "expression": "{{ steps[\"step-2\"].record.from }}"
              },
              "type": "string"
            },
            {
              "name": "original_subject",
              "value": {
                "expression": "{{ 'Re: ' + steps[\"step-2\"].record.subject }}"
              },
              "type": "string"
            },
            {
              "name": "category",
              "value": {
                "expression": "{{ JSON.parse(steps[\"step-3\"].record.data).response.trim() }}"
              },
              "type": "string"
            }
          ]
        }
      }
    }
  ],
  "edges": [
