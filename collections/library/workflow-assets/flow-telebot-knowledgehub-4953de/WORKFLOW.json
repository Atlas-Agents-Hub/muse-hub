{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-telebot-knowledgehub-4953de",
  "title": "TeleBot KnowledgeHub",
  "nodes": [
    {
      "id": "step-1",
      "label": "Simple Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": {
          "expression": "{{ steps[\"step-12\"].record.message.chat.id }}"
        }
      }
    },
    {
      "id": "step-2",
      "label": "Retrieve documents",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Use this tool to retrieve any information required.",
        "memoryKey": {
          "configuration_input": "step-2-memorykey"
        },
        "topK": 10
      }
    },
    {
      "id": "step-3",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "chunkSize": 3000,
        "chunkOverlap": 200,
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Simple Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "memoryKey": {
          "configuration_input": "step-4-memorykey"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Default Data Loader1",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Get a chat1",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "resource": "chat",
        "chatId": {
          "expression": "{{ record.message.chat.id }}"
        }
      }
    },
    {
      "id": "step-7",
      "label": "Upload your file here",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "formTitle": "Upload your data to test RAG",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Upload your file(s)",
              "fieldType": "file",
              "acceptFileTypes": ".pdf, .csv"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "AI Agent1",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "promptType": "define",
        "text": {
          "expression": "{{ steps[\"step-12\"].record.message.text }}"
        },
        "options": {
          "systemMessage": {
            "expression": "You are an helplful AI Assistant Provide answers to user query based only on knowledgebase.Do Not provide any edectra knowledge apart from knowledgebase"
          },
          "maxIterations": 10
        }
      }
    },
    {
      "id": "step-9",
      "label": "Groq Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Embeddings HuggingFace Inference",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-11",
      "label": "Reply in Telegram1",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "chatId": {
          "expression": "{{ steps[\"step-12\"].record.message.chat.id }}"
        },
        "text": {
          "expression": "{{ record.output }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-12",
      "label": "Telegram Message Trigger1",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "*"
        ],
        "additionalFields": {
          "download": false
        }
      }
    },
    {
      "id": "step-13",
      "label": "Embeddings HuggingFace Inference1",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    }
  ],
