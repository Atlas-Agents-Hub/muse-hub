      "label": "Model Assistant",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "## Our Previous Conversation:\n{{ record[\"messages\"].map(m => `\nHuman: ${m.human}\nAI Assistant: ${m.ai}\n`) }}\n## Current message:\n{{ steps[\"step-8\"].record.chatInput }}"
        },
        "options": {},
