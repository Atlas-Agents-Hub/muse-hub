      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Chat Memory Manager1",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "mode": "insert",
        "messages": {
          "messageValues": [
            {
              "type": "user",
              "message": {
                "expression": "{{ steps[\"step-8\"].record.chatInput }}"
              }
            },
            {
              "type": "ai",
              "message": {
                "expression": "{{ record.output }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "messages"
      }
    },
    {
      "id": "step-6",
      "label": "Edit Fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "output",
              "stringValue": {
                "expression": "{{ steps[\"step-1\"].record.output }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Limit",
      "operation": "limit",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-8",
      "label": "Chat Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "public": true,
        "options": {
          "loadPreviousSession": "memory"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "{{ steps[\"step-8\"].record.sessionId }}123"
        },
        "contextWindowLength": 20
      }
    }
