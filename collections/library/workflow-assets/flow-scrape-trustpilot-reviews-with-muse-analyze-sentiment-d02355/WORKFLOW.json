{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-scrape-trustpilot-reviews-with-muse-analyze-sentiment-d02355",
  "title": "Scrape Trustpilot Reviews with DeepSeek, Analyze Sentiment with OpenAI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "recensioni"
      }
    },
    {
      "id": "step-2",
      "label": "Information Extractor",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "You need to extract the review from the following HTML: {{ record.recensione }}"
        },
        "options": {
          "systemPromptTemplate": "You are a review expert. You need to extract only the required information and report it without changing anything.\nAll the required information is in the text."
        },
        "attributes": {
          "attributes": [
            {
              "name": "autore",
              "required": true,
              "description": "Extract the name of the review author"
            },
            {
              "name": "valutazione",
              "type": "number",
              "required": true,
              "description": "Extract the rating given to the review (from 1 to 5)"
            },
            {
              "name": "data",
              "required": true,
              "description": "Extract review date in YYYY-MM-DD format"
            },
            {
              "name": "titolo",
              "required": true,
              "description": "Extract the review title"
            },
            {
              "name": "testo",
              "required": true,
              "description": "Extract the review text"
            },
            {
              "name": "n_recensioni",
              "type": "number",
              "required": true,
              "description": "Extract the total number of reviews made by the user"
            },
            {
              "name": "nazione",
              "required": true,
              "description": "Extract the country of the user who wrote the review. Must be two characters"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.Valutazione }}"
              },
              "rightValue": {
                "expression": "{{ steps[\"step-1\"].record.recensioni.replace('/reviews/','') }}"
              }
            }
          ]
        },
        "looseTypeValidation": true
      }
    },
    {
      "id": "step-4",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Limit1",
      "operation": "limit",
      "adapter": "local",
      "parameters": {
        "maxItems": 3
      }
    },
    {
      "id": "step-6",
      "label": "Set Parameters",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "company_id",
              "type": "string",
              "value": "COMPANY"
            },
            {
              "name": "max_page",
              "type": "number",
              "value": 2
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Get reviews",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://it.trustpilot.com/review/{{ record.company_id }}"
        },
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "page",
                    "value": {
                      "expression": "{{ $pageCount + 1 }}"
                    }
                  }
                ]
              },
              "maxRequests": {
                "expression": "{{ record.max_page }}"
              },
              "requestInterval": 5000,
              "limitPagesFetched": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "sort",
              "value": "recency"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Extract",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "recensioni",
              "attribute": "href",
              "cssSelector": "article section a",
              "returnArray": true,
              "returnValue": "attribute"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Get rows",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupValue": {
                "expression": "{{ steps[\"step-1\"].record.recensioni.replace('/reviews/','') }}"
              },
              "lookupColumn": "Id"
            }
          ]
        },
        "sheetName": {
          "configuration_input": "step-9-sheetname"
        },
        "documentId": {
          "configuration_input": "step-9-documentid"
        }
      }
    },
