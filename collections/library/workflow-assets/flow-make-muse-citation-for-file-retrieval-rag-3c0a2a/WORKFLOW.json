{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-make-muse-citation-for-file-retrieval-rag-3c0a2a",
  "title": "Make OpenAI Citation for File Retrieval RAG",
  "nodes": [
    {
      "id": "step-1",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData"
      }
    },
    {
      "id": "step-2",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-3",
      "label": "Create a simple Trigger to have the Chat button within N8N",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "OpenAI Assistant with Vector Store",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "preserveOriginalTools": false
        },
        "resource": "assistant",
        "assistantId": {
          "configuration_input": "step-4-assistantid"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Get ALL Thread Content",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.openai.com/v1/threads/{{ record.threadId }}/messages"
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Beta",
              "value": "assistants=v2"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Split all message iterations from a thread",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "data"
      }
    },
    {
      "id": "step-7",
      "label": "Split all content from a single message",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "content"
      }
    },
    {
      "id": "step-8",
      "label": "Split all citations from a single message",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "text.annotations"
      }
    },
    {
      "id": "step-9",
      "label": "Retrieve file name from a file ID",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.openai.com/v1/files/{{ record.file_citation.file_id }}"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Regularize output",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "id",
              "type": "string",
              "value": {
                "expression": "{{ record.id }}"
              }
            },
            {
              "name": "filename",
              "type": "string",
              "value": {
                "expression": "{{ record.filename }}"
              }
            },
            {
              "name": "text",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-8\"].record.text }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Optional Markdown to HTML",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "bypass": true,
        "instruction": "Pass the incoming records to the next connected operation."
      }
    },
    {
      "id": "step-12",
      "label": "Finnaly format the output",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "let saida = steps[\"step-4\"].record.output;\n\nfor (let i of record.json.data) {\n saida = saida.replaceAll(i.text, \" _(\"+ i.filename+\")_ \");\n}\n\nrecord.json.output = saida;\nreturn record;",
          "inputs": "records, record, and named steps"
        }
      }
    }
  ],
