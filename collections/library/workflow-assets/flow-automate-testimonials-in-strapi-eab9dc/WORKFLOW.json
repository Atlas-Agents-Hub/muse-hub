{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automate-testimonials-in-strapi-eab9dc",
  "title": "Automate testimonials in Strapi with n8n",
  "nodes": [
    {
      "id": "step-1",
      "label": "Simplify Result",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Content",
              "value": {
                "expression": "{{record[\"full_text\"].replace(/(?:https?|ftp):\\/\\/[\\n\\S]+/g, '')}}"
              }
            },
            {
              "name": "Author",
              "value": {
                "expression": "{{record[\"user\"][\"name\"]}} (@{{record[\"user\"][\"screen_name\"]}})"
              }
            },
            {
              "name": "Created",
              "value": {
                "expression": "{{new Date(record[\"created_at\"]).toISOString()}}"
              }
            },
            {
              "name": "URL",
              "value": {
                "expression": "https://twitter.com/{{record[\"user\"][\"screen_name\"]}}/status/{{record[\"id_str\"]}}"
              }
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "step-2",
      "label": "Store in Strapi",
      "operation": "service-write",
      "adapter": "strapi",
      "parameters": {
        "columns": "Content,Author,Created,URL",
        "operation": "create",
        "contentType": "posts"
      }
    },
    {
      "id": "step-3",
      "label": "Every 30 Minutes",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "unit": "minutes",
        "interval": 30
      }
    },
    {
      "id": "step-4",
      "label": "Is Retweet or Old?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": {
                "expression": "{{record[\"Content\"]}}"
              },
              "value2": "RT @",
              "operation": "startsWith"
            }
          ],
          "dateTime": [
            {
              "value1": {
                "expression": "{{record[\"Created\"]}}"
              },
              "value2": {
                "expression": "{{new Date(new Date().getTime() - 30 * 60 * 1000)}}"
              },
              "operation": "before"
            }
          ]
        },
        "combineOperation": "any"
      }
    },
    {
      "id": "step-5",
      "label": "Search Tweets",
      "operation": "service-read",
      "adapter": "twitter",
      "parameters": {
        "operation": "search",
        "searchText": "(strapi OR n8n.io) AND lang:en",
        "additionalFields": {
          "tweetMode": "extended",
          "resultType": "recent"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": {
          "configuration_input": "step-6-path"
        },
        "options": {},
        "httpMethod": "POST"
      }
    },
    {
      "id": "step-7",
      "label": "Simplify Webhook Result",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "Content",
              "value": {
                "expression": "{{record[\"body\"][\"data\"][\"fields\"][1][\"value\"]}}"
              }
            },
            {
              "name": "Author",
              "value": {
                "expression": "{{record[\"body\"][\"data\"][\"fields\"][0][\"value\"]}}"
              }
            },
            {
              "name": "Created",
              "value": {
                "expression": "{{new Date().toISOString()}}"
              }
            },
            {
              "name": "URL"
            }
          ]
        },
        "options": {},
        "keepOnlySet": true
      }
    },
    {
      "id": "step-8",
      "label": "Analyze Form Submission",
      "operation": "service-read",
      "adapter": "googlecloudnaturallanguage",
      "parameters": {
        "content": {
          "expression": "{{record[\"Content\"]}}"
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Analyze Tweet",
      "operation": "service-read",
      "adapter": "googlecloudnaturallanguage",
      "parameters": {
        "content": {
          "expression": "{{record[\"Content\"]}}"
        },
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "Merge Form Sentiment with Source",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "mergeByIndex"
      }
    },
    {
      "id": "step-11",
      "label": "Merge Tweet Sentiment with Source",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "mergeByIndex"
      }
    },
    {
      "id": "step-12",
      "label": "Positive Form Sentiment?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": {
                "expression": "{{record[\"documentSentiment\"][\"score\"]}}"
              },
              "value2": 0.4,
              "operation": "larger"
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Store Form Submission in Strapi",
      "operation": "service-write",
      "adapter": "strapi",
      "parameters": {
        "columns": "Content,Author,Created,URL",
        "operation": "create",
        "contentType": "posts"
      }
    },
    {
      "id": "step-14",
      "label": "Positive Tweet Sentiment?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": {
                "expression": "{{record[\"documentSentiment\"][\"score\"]}}"
              },
              "value2": 0.3,
              "operation": "larger"
            }
          ]
        }
      }
    }
  ],
