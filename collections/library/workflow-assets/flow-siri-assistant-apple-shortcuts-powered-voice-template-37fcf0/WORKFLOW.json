  "title": "Siri Assistant Apple Shortcuts powered voice template",
  "nodes": [
    {
      "id": "step-1",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-2",
      "label": "Respond to Apple Shortcut",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "options": {},
        "respondWith": "text",
        "responseBody": {
          "expression": "{{ record.output }}"
        }
      }
    },
    {
      "id": "step-3",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Here is my request: {{ record.body.input }}"
        },
        "agent": "conversationalAgent",
        "options": {
          "systemMessage": {
            "expression": "## Task\nYou are a helpful assistant. Provide concise replies as the user receives them via voice on their mobile phone. Avoid using symbols like \"\\n\" to prevent them from being narrated.\n\n## Context\n- Today is {{ current_time.format('dd LLL yy') }}.\n- Current time: {{ current_time.format('h:mm a') }} in Berlin, Germany.\n- When asked, you are an AI Agent running as an n8n workflow.\n\n## Output\nKeep responses short and clear, optimized for voice delivery. Don't hallucinate, if you don't know the answer, say you don't know."
          }
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-4",
      "label": "When called by Apple Shortcut",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "assistant",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "responseNode"
      }
    }
