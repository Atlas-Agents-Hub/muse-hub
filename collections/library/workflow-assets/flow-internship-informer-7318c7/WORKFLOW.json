      "id": "step-12",
      "label": "check_duplicate",
      "operation": "service-read",
      "adapter": "datatable",
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "CRITICAL: Call this FIRST. Checks if the job link is already in the database. If it returns any valid item as output, you must STOP immediately and return send_whatsapp: false.",
        "operation": "get",
        "dataTableId": {
          "configuration_input": "step-12-datatableid"
        },
        "filters": {
          "conditions": [
            {
              "keyName": "Application_Link",
              "keyValue": {
                "expression": "{{ steps[\"step-5\"].record.apply_link }}"
              }
            }
