    {
      "id": "step-13",
      "label": "Output Parser",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// 1. Get the raw text output safely\nconst rawText = items[0]?.json?.output;\n\nif (!rawText) {\n  return [{ json: { error: \"No output received from Analyst Agent\" } }];\n}\n\n// 2. Try to find JSON inside markdown blocks\nconst markdownMatch = rawText.match(/```json\\s*([\\s\\S]*?)\\s*```/);\n\n// 3. Robust JSON Extraction\nconst firstOpen = rawText.indexOf('{');\nconst lastClose = rawText.lastIndexOf('}');\n\nlet finalJson = {};\n\ntry {\n  if (markdownMatch) {\n    finalJson = JSON.parse(markdownMatch[1]);\n  } else if (firstOpen !== -1 && lastClose !== -1 && lastClose > firstOpen) {\n    const jsonString = rawText.substring(firstOpen, lastClose + 1);\n    finalJson = JSON.parse(jsonString);\n  } else {\n    throw new Error(\"No JSON structure found\");\n  }\n} catch (error) {\n  finalJson = {\n    send_whatsapp: false,\n    reason: \"JSON Parsing Failed\",\n    org_text: steps[\"step-1\"].records[0].message.text || \"Text unavailable\",\n    error_details: error.message,\n    raw_output: rawText\n  };\n}\n\nreturn [{ json: finalJson }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
