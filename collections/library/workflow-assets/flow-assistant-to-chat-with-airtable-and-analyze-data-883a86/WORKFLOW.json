        "jsonBody": {
          "expression": "{{ \n Object.fromEntries(\n Object.entries({\n sort: steps[\"step-5\"].record.query.sort,\n limit: steps[\"step-5\"].record.query.limit,\nfields: steps[\"step-5\"].record.query.fields,\nfilterByFormula: steps[\"step-10\"].record.choices == undefined ? undefined : JSON.parse(record.choices[0].message.content).filter\n }).filter(([key, value]) => value !== undefined)\n )\n}}"
