{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-etl-pipeline-for-text-processing-265c15",
  "title": "ETL pipeline for text processing",
  "nodes": [
    {
      "id": "step-1",
      "label": "Twitter",
      "operation": "service-read",
      "adapter": "twitter",
      "parameters": {
        "limit": 3,
        "operation": "search",
        "searchText": {
          "expression": "#OnThisDay"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "Postgres",
      "operation": "service-read",
      "adapter": "postgres",
      "parameters": {
        "table": "tweets",
        "columns": "text, score, magnitude",
        "returnFields": {
          "expression": "*"
        }
      }
    },
    {
      "id": "step-3",
      "label": "MongoDB",
      "operation": "service-read",
      "adapter": "mongodb",
      "parameters": {
        "fields": "text",
        "options": {},
        "operation": "insert",
        "collection": "tweets"
      }
    },
    {
      "id": "step-4",
      "label": "Slack",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": "🐦 NEW TWEET with sentiment score {{record[\"score\"]}} and magnitude {{record[\"magnitude\"]}} ⬇️\n{{record[\"text\"]}}"
        },
        "channel": "tweets",
        "attachments": [],
        "otherOptions": {}
      }
    },
    {
      "id": "step-5",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": {
                "expression": "{{record[\"score\"]}}"
              },
              "operation": "larger"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "NoOp",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-7",
      "label": "Google Cloud Natural Language",
      "operation": "service-read",
      "adapter": "googlecloudnaturallanguage",
      "parameters": {
        "content": {
          "expression": "{{steps[\"step-3\"].json[\"text\"]}}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Set",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "number": [
            {
              "name": "score",
              "value": {
                "expression": "{{record[\"documentSentiment\"][\"score\"]}}"
              }
            },
            {
              "name": "magnitude",
              "value": {
                "expression": "{{record[\"documentSentiment\"][\"magnitude\"]}}"
              }
            }
          ],
          "string": [
            {
              "name": "text",
              "value": {
                "expression": "{{steps[\"step-1\"].json[\"text\"]}}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Cron",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 6
            }
          ]
        }
      }
    }
  ],
