{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-open-deep-research-autonomous-research-workflow-9da1b9",
  "title": "Open Deep Research - Autonomous Research Workflow",
  "nodes": [
    {
      "id": "step-1",
      "label": "Chat Message Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Generate Search Queries using LLM",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "User Query: {{ steps[\"step-1\"].record.chatInput }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "You are an expert research assistant. Given a user's query, generate up to four distinct, precise search queries that would help gather comprehensive information on the topic. Return only a JSON list of strings, for example: ['query1', 'query2', 'query3']."
              }
            }
          ]
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-3",
      "label": "LLM Response Provider (OpenRouter)",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Parse and Chunk JSON Data",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Parse the input JSON string and split it into four chunks\nconst rawText = record.text;\n\n// Remove Markdown JSON code blocks if present\nconst cleanedText = rawText.replace(/```json|```/g, '').trim();\n\ntry {\n const jsonArray = JSON.parse(cleanedText);\n if (!Array.isArray(jsonArray)) {\n throw new Error('The JSON is not an array.');\n }\n const chunkSize = Math.ceil(jsonArray.length / 4);\n const chunks = [];\n for (let i = 0; i < jsonArray.length; i += chunkSize) {\n chunks.push(jsonArray.slice(i, i + chunkSize));\n }\n return chunks.map(chunk => ({ json: { chunk } }));\n} catch (error) {\n return [{ json: { error: error.message } }];\n}",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Perform SerpAPI Search Request",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": {
                "expression": "{{ steps[\"step-4\"].record.chunk }}"
              }
            },
            {
              "name": "api_key",
              "value": {
                "configuration_input": "step-5-parameters-1-value"
              }
            },
            {
              "name": "engine",
              "value": "google"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Perform Jina AI Analysis Request",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://r.jina.ai/{{ record.url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Format SerpAPI Organic Results",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Format the organic search results from SerpAPI\nconst results = records[0].json.organic_results;\nif (results.length === 0) {\n return [{ json: { error: 'No search results found.' } }];\n}\nconst formattedResults = results.map(result => ({\n title: result.title || 'No title available',\n url: result.link || 'No link available',\n source: result.source || result.displayed_link || 'Unknown source'\n}));\nreturn formattedResults.map(result => ({ json: result }));",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Extract Relevant Context via LLM",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "User Queries: {{ steps[\"step-4\"].all().map(item => item.json.chunk[0]).join(', ') }}\nWebpage Contents: \n\"\"\"\n{{ record.data }}\n\"\"\""
        },
        "options": {
          "systemMessage": {
            "expression": "You are an expert information extractor. Given the user's query, the search query that led to this page, and the webpage content, extract all relevant pieces of information that are useful to answer the query. Return only the relevant context as plain text without any additional commentary."
          }
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-9",
      "label": "Generate Comprehensive Research Report",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Extracted Contexts (Merged):\n\"\"\"\n{{ record.output }}\n\"\"\""
        },
        "options": {
          "systemMessage": "You are an expert researcher and report writer. Based on the gathered contexts and the original user query, generate a comprehensive, well-structured report. Include all relevant insights and conclusions without unnecessary commentary.\n\nFormat the report in Markdown with clear headings. For example:\n\n# Research Report: [User Query]\n\n## Key Findings\n- Point 1\n- Point 2\n\n## Detailed Analysis\n### Aspect 1\nSummary of findings.\n_Source:_ [Source Name](URL)\n\n### Aspect 2\nSummary of findings.\n_Source:_ [Another Source](URL)\n\nNow, generate the complete report."
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-10",
      "label": "Split Data for SerpAPI Batching",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Split Data for Jina AI Batching",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-12",
      "label": "LLM Memory Buffer (Input Context)",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "configuration_input": "step-12-sessionkey"
        },
        "sessionIdType": "customKey",
        "contextWindowLength": 20
      }
    },
    {
      "id": "step-13",
      "label": "LLM Memory Buffer (Report Context)",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "configuration_input": "step-13-sessionkey"
        },
        "sessionIdType": "customKey",
        "contextWindowLength": 20
      }
    },
    {
      "id": "step-14",
      "label": "Fetch Wikipedia Information",
      "operation": "service-read",
      "adapter": "toolwikipedia",
      "parameters": {}
    }
