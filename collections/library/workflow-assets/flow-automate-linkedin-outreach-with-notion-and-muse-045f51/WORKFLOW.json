      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-6",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-5",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 1
    },
    {
      "from": "step-7",
      "to": "step-8",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-8",
      "to": "step-5",
      "channel": "main",
