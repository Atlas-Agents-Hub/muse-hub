{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automate-linkedin-outreach-with-notion-and-muse-045f51",
  "title": "Automate LinkedIn Outreach with Notion and Muse",
  "nodes": [
    {
      "id": "step-1",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 15
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Set post status to \"Done\"",
      "operation": "service-write",
      "adapter": "notion",
      "parameters": {
        "pageId": {
          "expression": "{{ steps[\"step-9\"].record.url }}"
        },
        "options": {},
        "resource": "databasePage",
        "operation": "update",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Status|status",
              "statusValue": "Done"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Post on LinkedIn",
      "operation": "service-write",
      "adapter": "linkedin",
      "parameters": {
        "text": {
          "expression": "{{ record.output }}"
        },
        "person": "_RmSSZc0jB",
        "additionalFields": {},
        "shareMediaCategory": "IMAGE"
      }
    },
    {
      "id": "step-4",
      "label": "Combine text+image",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-5",
      "label": "Fetch image from post",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.url[0] }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Reformat Post Text",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Thank you kindly for your help, please refer to the following LinkedIn post, and output a reformatted version employing thoroughly thought-out paragraph breaks, and lists if present:\n```\n{{ record.content.join(\" \") }}\n```"
        },
        "prompt": "define",
        "options": {},
        "resource": "assistant",
        "assistantId": {
          "configuration_input": "step-6-assistantid"
        }
      }
    },
    {
      "id": "step-7",
      "label": "get all content from post page",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "blockId": {
          "expression": "{{ record.url }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true
      }
    },
    {
      "id": "step-8",
      "label": "Pull together all text blocks + image",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "content"
            },
            {
              "fieldToAggregate": "image.file.url"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "query entries from Notion table for today",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "filters": {
          "conditions": [
            {
              "key": "Date|date",
              "date": {
                "expression": "{{ current_date.format(\"yyyy/mM/dd\") }}"
              },
              "condition": "equals"
            }
          ]
        },
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "configuration_input": "step-9-databaseid"
        },
        "filterType": "manual"
      }
    }
  ],
  "edges": [
    {
      "from": "step-3",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
