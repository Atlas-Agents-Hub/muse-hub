    {
      "id": "step-5",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "movie_name",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record['Movie Name'] }}"
                }
              },
              {
                "name": "movie_release_date",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record['Year of Release'] }}"
                }
              },
              {
                "name": "movie_description",
                "value": {
                  "expression": "{{ steps[\"step-3\"].record.Description }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ steps[\"step-3\"].record.Description }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-6",
      "label": "Token Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-7",
      "label": "Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "qdrantCollection": {
          "configuration_input": "step-7-qdrantcollection"
        }
      }
    },
    {
      "id": "step-8",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Call n8n Workflow Tool",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "movie_recommender",
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-10-workflowid"
        },
        "description": "Call this tool to get a list of recommended movies from a vector database. ",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "positive_example": {
                "type": "string",
                "description": "A string with a movie description matching the user's positive recommendation request"
              },
              "negative_example": {
                "type": "string",
                "description": "A string with a movie description matching the user's negative anti-recommendation reuqest"
              }
            }
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-11",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-12",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-13",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineAll"
      }
    },
    {
      "id": "step-14",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "result"
      }
    },
    {
      "id": "step-15",
      "label": "Split Out1",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "result.points"
      }
    },
    {
      "id": "step-16",
      "label": "Merge1",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "fieldsToMatchString": "id"
      }
    },
    {
      "id": "step-17",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "response"
      }
    },
    {
      "id": "step-18",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemMessage": "You are a Movie Recommender Tool using a Vector Database under the hood. Provide top-3 movie recommendations returned by the database, ordered by their recommendation score, but not showing the score to the user."
        }
      }
    },
    {
      "id": "step-19",
      "label": "Embedding Recommendation Request with Open AI",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-19-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "input",
              "value": {
                "expression": "{{ record.query.positive_example }}"
              }
            },
            {
              "name": "model",
              "value": "text-embedding-3-small"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": {
                "configuration_input": "step-19-parameters-0-value"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-20",
      "label": "Embedding Anti-Recommendation Request with Open AI",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-20-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "input",
              "value": {
                "expression": "{{ record.query.negative_example }}"
              }
            },
            {
              "name": "model",
              "value": "text-embedding-3-small"
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": {
                "configuration_input": "step-20-parameters-0-value"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-21",
      "label": "Extracting Embedding",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "positive_example",
              "type": "array",
              "value": {
                "expression": "{{ record.data[0].embedding }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-22",
      "label": "Extracting Embedding1",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "negative_example",
              "type": "array",
              "value": {
                "expression": "{{ record.data[0].embedding }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-23",
      "label": "Calling Qdrant Recommendation API",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-23-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"query\": {\n \"recommend\": {\n \"positive\": [[{{ record.positive_example }}]],\n \"negative\": [[{{ record.negative_example }}]],\n \"strategy\": \"average_vector\"\n }\n },\n \"limit\":3\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-24",
      "label": "Retrieving Recommended Movies Meta Data",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-24-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"ids\": [\"{{ record.result.points[0].id }}\", \"{{ record.result.points[1].id }}\", \"{{ record.result.points[2].id }}\"],\n \"with_payload\":true\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-25",
      "label": "Selecting Fields Relevant for Agent",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "movie_recommendation_score",
              "type": "number",
              "value": {
                "expression": "{{ record.score }}"
              }
            },
            {
              "name": "movie_description",
              "type": "string",
              "value": {
                "expression": "{{ record.payload.content }}"
              }
            },
            {
              "name": "movie_name",
              "type": "string",
              "value": {
                "expression": "{{ record.payload.metadata.movie_name }}"
              }
            },
            {
              "name": "movie_release_year",
              "type": "string",
              "value": {
                "expression": "{{ record.payload.metadata.release_year }}"
              }
            }
          ]
        }
      }
    }
