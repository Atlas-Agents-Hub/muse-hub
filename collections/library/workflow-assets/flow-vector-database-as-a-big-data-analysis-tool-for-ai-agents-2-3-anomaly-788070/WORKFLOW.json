{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-vector-database-as-a-big-data-analysis-tool-for-ai-agents-2-3-anomaly-788070",
  "title": "Vector Database as a Big Data Analysis Tool for AI Agents [2 3 - anomaly]",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Total Points in Collection",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].record.qdrantCloudURL }}/collections/{{ steps[\"step-22\"].record.collectionName }}/points/count"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"exact\": true\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-3",
      "label": "Cluster Distance Matrix",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-22\"].records[0].collectionName }}/points/search/matrix/offsets"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"sample\": record.maxClusterSize,\n \"limit\": record.maxClusterSize,\n \"using\": \"voyage\",\n \"filter\": {\n \"must\": {\n \"key\": \"crop_name\",\n \"match\": { \"value\": record.cropName }\n }\n }\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-4",
      "label": "Scipy Sparse Matrix",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "python",
        "pythonCode": {
          "language": "python",
          "reference": "from scipy.sparse import coo_array\n\ncluster = _input.item.json['result']\n\nscores = list(cluster['scores'])\noffsets_row = list(cluster['offsets_row'])\noffsets_col = list(cluster['offsets_col'])\n\ncluster_matrix = coo_array((scores, (offsets_row, offsets_col)))\nthe_most_similar_to_others = cluster_matrix.sum(axis=1).argmax()\n\nreturn {\n \"json\": {\n \"medoid_id\": cluster[\"ids\"][the_most_similar_to_others]\n }\n}",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Set medoid id",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-22\"].records[0].collectionName }}/points/payload"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"payload\": {\"is_medoid\": true},\n \"points\": [record.medoid_id]\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-6",
      "label": "Get Medoid Vector",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-22\"].records[0].collectionName }}/points"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"ids\": [record.medoid_id],\n \"with_vector\": true,\n \"with_payload\": true\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-7",
      "label": "Prepare for Searching Threshold",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "oppositeOfCenterVector",
              "type": "array",
              "value": {
                "expression": "{{ record.result[0].vector.voyage.map(value => value * -1)}}"
              }
            },
            {
              "name": "cropName",
              "type": "string",
              "value": {
                "expression": "{{ record.result[0].payload.crop_name }}"
              }
            },
            {
              "name": "centerId",
              "type": "string",
              "value": {
                "expression": "{{ record.result[0].id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Searching Score",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-22\"].records[0].collectionName }}/points/query"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"query\": record.oppositeOfCenterVector,\n \"using\": \"voyage\",\n \"exact\": true,\n \"filter\": {\n \"must\": [\n {\n \"key\": \"crop_name\",\n \"match\": {\"value\": record.cropName }\n }\n ]\n },\n \"limit\": steps[\"step-20\"].records[0].furthestFromCenter,\n \"with_payload\": true\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-9",
      "label": "Threshold Score",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "thresholdScore",
              "type": "number",
              "value": {
                "expression": "{{ record.result.points.last().score * -1 }}"
              }
            },
            {
              "name": "centerId",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-7\"].record.centerId }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Set medoid threshold score",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-22\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-22\"].records[0].collectionName }}/points/payload"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"payload\": {\"is_medoid_cluster_threshold\": record.thresholdScore },\n \"points\": [record.centerId]\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
