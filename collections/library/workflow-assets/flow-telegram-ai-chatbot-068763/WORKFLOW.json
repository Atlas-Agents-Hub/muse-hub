{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-telegram-ai-chatbot-068763",
  "title": "Telegram AI Chatbot",
  "nodes": [
    {
      "id": "step-1",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "*"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "CheckCommand",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "rules": [
            {
              "value2": "/",
              "operation": "notStartsWith"
            },
            {
              "output": 1,
              "value2": "/start",
              "operation": "startsWith"
            },
            {
              "output": 2,
              "value2": {
                "expression": "/image"
              },
              "operation": "startsWith"
            }
          ]
        },
        "value1": {
          "expression": "{{ record.message?.text }}"
        },
        "dataType": "string",
        "fallbackOutput": 3
      }
    },
    {
      "id": "step-3",
      "label": "Settings",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "number": [
            {
              "name": "model_temperature",
              "value": 0.8
            },
            {
              "name": "token_length",
              "value": 500
            }
          ],
          "string": [
            {
              "name": "system_command",
              "value": {
                "expression": "You are a friendly chatbot. User name is {{ record?.message?.from?.first_name }}. User system language is {{ record?.message?.from?.language_code }}. First, detect user text language. Next, provide your reply in the same language. Include several suitable emojis in your answer."
              }
            },
            {
              "name": "bot_typing",
              "value": {
                "expression": "{{ record?.message?.text.startsWith('/image') ? \"upload_photo\" : \"typing\" }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Chat_mode",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "model": {
          "configuration_input": "step-4-model"
        },
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": {
                "expression": "{{ record.system_command }}"
              }
            },
            {
              "content": {
                "expression": "{{ record.message.text }}"
              }
            }
          ]
        },
        "options": {
          "maxTokens": {
            "expression": "{{ record.token_length }}"
          },
          "temperature": {
            "expression": "{{ record.model_temperature }}"
          }
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-5",
      "label": "Greeting",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": {
                "expression": "{{ record.system_command }}"
              }
            },
            {
              "content": {
                "expression": "This is the first message from a user. Please welcome a new user in `{{ record.message.from.language_code }}` language"
              }
            }
          ]
        },
        "options": {
          "maxTokens": {
            "expression": "{{ record.token_length }}"
          },
          "temperature": {
            "expression": "{{ record.model_temperature }}"
          }
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-6",
      "label": "Text reply",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.message.content }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-3\"].records[0].message.from.id }}"
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "step-7",
      "label": "Send Typing action",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "action": {
          "expression": "{{ record.bot_typing }}"
        },
        "chatId": {
          "expression": "{{ record.message.from.id }}"
        },
        "operation": "sendChatAction"
      }
    },
    {
      "id": "step-8",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "chooseBranch"
      }
    },
    {
      "id": "step-9",
      "label": "Create an image",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "{{ record.message.text.split(' ').slice(1).join(' ') }}"
        },
        "options": {
          "n": 1,
          "size": "512x512"
        },
        "resource": "image",
        "responseFormat": "imageUrl"
      }
    },
    {
      "id": "step-10",
      "label": "Send error message",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "Sorry, {{ record.message.from.first_name }}! This command is not supported yet. Please type some text to a chat bot or try this command:\n/image \\[your prompt]\n\nEnter the command, then space and provide your request. Example:\n\n`/image a picture or a cute little kitten with big eyes. Miyazaki studio ghibli style`"
        },
        "chatId": {
          "expression": "{{ record.message.from.id }}"
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    },
    {
      "id": "step-11",
      "label": "Send image",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "file": {
          "expression": "{{ record.url }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-3\"].records[0].message.from.id }}"
        },
        "operation": "sendPhoto",
        "additionalFields": {}
      }
    },
    {
      "id": "step-12",
      "label": "PreProcessing",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "values": {
          "string": [
            {
              "name": "message.text",
              "value": {
                "expression": "{{ record?.message?.text || \"\" }}"
              }
            }
          ]
        },
        "options": {
          "dotNotation": true
        }
      }
    }
  ],
