{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-create-a-google-analytics-data-report-with-ai-and-sent-it-to-e-mail-and-telegr-81e322",
  "title": "Create a Google Analytics Data Report with AI and sent it to E-Mail and Telegram",
  "nodes": [
    {
      "id": "step-1",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Google Analytics Letzte 7 Tage",
      "operation": "service-read",
      "adapter": "googleanalytics",
      "parameters": {
        "metricsGA4": {
          "metricValues": [
            {
              "listName": "screenPageViews"
            },
            {},
            {
              "listName": "sessions"
            },
            {
              "listName": "sessionsPerUser"
            },
            {
              "name": "averageSessionDuration",
              "listName": "other"
            },
            {
              "name": "ecommercePurchases",
              "listName": "other"
            },
            {
              "name": "averagePurchaseRevenue",
              "listName": "other"
            },
            {
              "name": "purchaseRevenue",
              "listName": "other"
            }
          ]
        },
        "propertyId": {
          "configuration_input": "step-2-propertyid"
        },
        "dimensionsGA4": {
          "dimensionValues": [
            {}
          ]
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-3",
      "label": "Send Email",
      "operation": "service-write",
      "adapter": "emailsend",
      "parameters": {
        "html": {
          "expression": "{{ record.message.content }}"
        },
        "options": {},
        "subject": "Weekly Report: Google Analytics: Last 7 days",
        "toEmail": {
          "configuration_input": "step-3-toemail"
        },
        "fromEmail": {
          "configuration_input": "step-3-fromemail"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.message.content }}"
        },
        "chatId": {
          "configuration_input": "step-4-chatid"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-5",
      "label": "Processing for Telegram",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-5-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "Convert the following text from HTML to normal text:\n\n{{ record.message.content }}\n\nPlease format the table so that each metric is a separate paragraph!\n\nExample:\n\nTotal views: xx.xxx\nTotal views previous year: xx,xxx\nDifference: x.xx %\n\nTotal users: xx,xxx\nTotal users previous year: xx,xxx\nDifference: -x.xx %"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Calculator",
      "operation": "transform",
      "adapter": "local",
      "parameters": {}
    },
    {
