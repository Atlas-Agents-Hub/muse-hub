{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-score-inbound-leads-with-ai-reply-by-sms-or-whatsapp-book-calendar-slots-and-a-7fef5e",
  "title": "Score inbound leads with AI, reply by SMS or WhatsApp, book calendar slots and alert sales",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook: new lead (form / ad / GHL)",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-in",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Webhook: voice agent call ended (Retell / VAPI)",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "call-ended",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Config",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-3-assignments-0-value"
              },
              "type": "string"
            },
            {
              "name": "test_mode",
              "value": true,
              "type": "boolean"
            },
            {
              "name": "hot_threshold",
              "value": 70,
              "type": "number"
            },
            {
              "name": "brand",
              "value": "Your Business Name",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Normalise + dedupe (24h)",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Normalise any lead source into one shape and drop duplicates within 24h (workflow static data).\nconst body = records[0].json.body || records[0].json;\nconst cfg = steps[\"step-3\"].records[0];\nconst lead = {\n  name: body.name || body.full_name || [body.first_name, body.last_name].filter(Boolean).join(' ') || 'Unknown',\n  email: (body.email || '').toLowerCase().trim(),\n  phone: (body.phone || body.phone_number || '').replace(/[^+\\d]/g, ''),\n  service: body.service || body.interest || body.form_name || 'general enquiry',\n  message: body.message || body.notes || body.comments || '',\n  source: body.source || body.utm_source || 'web-form',\n  company: body.company || '', budget: body.budget || '',\n  received_at: new Date().toISOString()\n};\nif (!lead.email && !lead.phone) throw new Error('Lead has neither email nor phone, rejected');\nconst key = lead.email || lead.phone;\nconst seen = $getWorkflowStaticData('global'); seen.leads = seen.leads || {};\nconst last = seen.leads[key];\nlead.duplicate = !!(last && Date.now() - last < 24*3600*1000);\nseen.leads[key] = Date.now();\nreturn [{ json: { ...lead, cfg } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Not a duplicate?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.duplicate }}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "AI: qualify lead",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.cfg.base }}/llm/complete"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ task: 'qualify_lead', input: { name: record.name, service: record.service, message: record.message, company: record.company, budget: record.budget } }) }}"
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "step-7",
      "label": "Merge lead + AI verdict",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const lead = steps[\"step-4\"].records[0];\nconst ai = records[0].json.output || {};\nconst score = Number(ai.score ?? 0);\nreturn [{ json: { ...lead, ai, score, hot: score >= lead.cfg.hot_threshold, usage: records[0].json.usage } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "CRM: upsert contact (HubSpot / GHL)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.cfg.base }}/crm/contacts/upsert"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ email: record.email, phone: record.phone, name: record.name, source: record.source, service: record.service, lead_score: record.score, intent: record.ai.intent, tags: [record.hot ? 'hot-lead' : 'nurture'] }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Attach contact id",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const lead = steps[\"step-7\"].records[0];\nconst crm = records[0].json;\nreturn [{ json: { ...lead, contact_id: crm.id, crm_status: crm.status } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-10",
      "label": "Hot lead?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.hot }}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Reply in < 60 s (SMS / WhatsApp / email)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.cfg.base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: record.phone ? 'sms' : 'email', to: record.phone || record.email, body: record.ai.reply }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-12",
      "label": "Calendar: next open slots",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "GET",
        "url": {
          "expression": "{{ steps[\"step-9\"].records[0].cfg.base }}/calendar/slots"
        },
        "options": {}
      }
    },
    {
      "id": "step-13",
      "label": "Offer 3 slots",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-9\"].records[0].cfg.base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: 'sms', to: steps[\"step-9\"].records[0].phone || steps[\"step-9\"].records[0].email, body: 'Pick a time: ' + record.slots.slice(0,3).map((s,i) => (i+1) + ') ' + s.replace('T',' ')).join('  ') + '. Reply with the number.' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-14",
      "label": "CRM: task for sales rep (15 min SLA)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-9\"].records[0].cfg.base }}/crm/tasks"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ contact_id: steps[\"step-9\"].records[0].contact_id, title: 'HOT lead, call within 15 min: ' + steps[\"step-9\"].records[0].name, due: new Date(Date.now()+15*60000).toISOString() }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-15",
      "label": "Slack alert to sales",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-9\"].records[0].cfg.base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#sales-hot-leads', text: '🔥 ' + steps[\"step-9\"].records[0].name + ' (' + steps[\"step-9\"].records[0].service + ') score ' + steps[\"step-9\"].records[0].score + ', ' + steps[\"step-9\"].records[0].ai.summary }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-16",
      "label": "Nurture: start 5-day sequence",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.cfg.base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: 'email', to: record.email || record.phone, body: 'Thanks ' + record.name.split(' ')[0] + ', here is our guide to ' + record.service + '. I will check in next week.', sequence: 'nurture-5-day' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-17",
      "label": "CRM: note with AI summary",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-9\"].records[0].cfg.base }}/crm/notes"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ contact_id: steps[\"step-9\"].records[0].contact_id, text: 'AI triage: ' + steps[\"step-9\"].records[0].ai.summary + ' | score ' + steps[\"step-9\"].records[0].score + ' | next: ' + steps[\"step-9\"].records[0].ai.next_step }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-18",
      "label": "Respond to webhook",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const l = steps[\"step-9\"].records[0];\nreturn [{ json: { ok: true, lead: l.name, score: l.score, route: l.hot ? 'hot: replied + slots offered + rep task' : 'nurture sequence started', contact_id: l.contact_id, tokens: l.usage } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-19",
      "label": "Skip duplicate",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "return [{ json: { ok: true, skipped: 'duplicate lead within 24h', key: record.email || record.phone } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-20",
      "label": "Config (calls)",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-20-assignments-0-value"
              },
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-21",
      "label": "Parse call payload",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Retell/VAPI-style payload: {call_id, from, to, transcript, duration_s, recording_url}\nconst b = records[0].json.body || records[0].json;\nif (!b.transcript) throw new Error('No transcript in call payload');\nreturn [{ json: { call_id: b.call_id, phone: (b.from || '').replace(/[^+\\d]/g,''), transcript: b.transcript, duration_s: b.duration_s, base: record.base } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-22",
      "label": "AI: summarise call + detect booking intent",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.base }}/llm/complete"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ task: 'summarise_call', input: { transcript: record.transcript } }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-23",
      "label": "CRM: upsert caller",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-21\"].records[0].base }}/crm/contacts/upsert"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ phone: steps[\"step-21\"].records[0].phone, source: 'inbound-call', last_call_outcome: record.output.outcome }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-24",
      "label": "CRM: call summary note",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-21\"].records[0].base }}/crm/notes"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ contact_id: record.id, text: 'Call ' + steps[\"step-21\"].records[0].call_id + ' (' + steps[\"step-21\"].records[0].duration_s + 's): ' + steps[\"step-22\"].records[0].output.summary + ' | follow-up: ' + steps[\"step-22\"].records[0].output.follow_up }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-25",
      "label": "Appointment requested?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ steps[\"step-22\"].records[0].output.outcome }}"
              },
              "rightValue": "appointment_requested",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-26",
      "label": "Calendar: slots",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "GET",
        "url": {
          "expression": "{{ steps[\"step-21\"].records[0].base }}/calendar/slots"
        },
        "options": {}
      }
    },
    {
      "id": "step-27",
      "label": "Book first slot",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-21\"].records[0].base }}/calendar/book"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ slot: record.slots[0], contact: steps[\"step-23\"].records[0].id, reason: 'from call ' + steps[\"step-21\"].records[0].call_id }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-28",
      "label": "SMS confirmation",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-21\"].records[0].base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: 'sms', to: steps[\"step-21\"].records[0].phone, body: 'Booked: technician visit ' + record.slot.replace('T',' ') + '. Reply R to reschedule.' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-29",
      "label": "Respond (call)",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const ai = steps[\"step-22\"].records[0].output;\nlet slot = null; try { slot = steps[\"step-27\"].records[0].slot; } catch (e) {}\nreturn [{ json: { ok: true, call_id: steps[\"step-21\"].records[0].call_id, outcome: ai.outcome, booked: ai.outcome === 'appointment_requested', slot } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-30",
      "label": "Error trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
