          "expression": "{{ JSON.stringify({ channel: '#ops-alerts', text: 'Lead engine failed: ' + (record.execution?.error?.message || 'unknown') + ' (execution ' + (record.execution?.id || '?') + ')' }) }}"
        },
        "options": {}
      }
    },
