      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-3",
      "label": "Add to Messages Stack",
      "operation": "service-read",
      "adapter": "redis",
      "parameters": {
        "list": {
          "expression": "chat-buffer:{{ record.From }}"
        },
        "tail": true,
        "operation": "push",
        "messageData": {
          "expression": "{{ record.Body }}"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Should Continue?",
      "operation": "branch",
