        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-6",
      "label": "Twilio Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "com.twilio.messaging.inbound-message.received"
        ]
      }
    },
    {
      "id": "step-7",
      "label": "Get Latest Message Stack",
      "operation": "service-read",
      "adapter": "redis",
      "parameters": {
        "key": {
          "expression": "chat-buffer:{{ record.From }}"
        },
        "keyType": "list",
        "options": {},
        "operation": "get",
        "propertyName": "messages"
      }
    },
    {
      "id": "step-8",
      "label": "Send Reply",
      "operation": "service-write",
      "adapter": "twilio",
      "parameters": {
        "to": {
          "expression": "{{ steps[\"step-6\"].record.From }}"
        },
        "from": {
          "expression": "{{ steps[\"step-6\"].record.To }}"
        },
        "message": {
          "expression": "{{ record.output }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Wait 5 seconds",
      "operation": "wait",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-10",
      "label": "Get Chat History",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "options": {
          "groupMessages": true
        }
      }
    },
    {
      "id": "step-11",
      "label": "Window Buffer Memory1",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "chat-debouncer:{{ steps[\"step-6\"].record.From }}"
        },
        "sessionIdType": "customKey"
      }
    },
    {
      "id": "step-12",
      "label": "Get Messages Buffer",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "messages",
              "type": "string",
              "value": {
                "expression": "{{\nsteps[\"step-7\"].record.messages\n .slice(\n steps[\"step-7\"].record.messages.lastIndexOf(\n steps[\"step-10\"].record.messages.last().human\n || steps[\"step-6\"].record.chatInput\n ),\n steps[\"step-7\"].record.messages.length\n )\n .join('\\n')\n}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.messages }}"
        },
        "agent": "conversationalAgent",
        "options": {},
        "promptType": "define"
      }
    }
