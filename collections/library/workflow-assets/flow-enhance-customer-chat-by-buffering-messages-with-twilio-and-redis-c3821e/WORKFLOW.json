              },
              "rightValue": {
                "expression": "{{ steps[\"step-6\"].record.Body }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
