            },
            "Posted Date": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.postingDate }}"
            },
            "Agency Email": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.agencyContactEmail }}"
            },
            "Agency Phone": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.agencyContactPhone }}"
            },
            "Eligibility?": {
              "expression": "{{ record.output.eligibility_matches.length > 0 ? 'Yes' : 'No' }}"
            },
            "Award Ceiling": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.awardCeiling }}"
            },
            "Response Date": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.responseDate }}"
            },
            "Success Criteria": {
              "expression": "{{ record.output.success_criteria.join('\\n') }}"
            },
            "Eligibility Notes": {
              "expression": "{{ record.output.eligibility_matches.join('\\n') }}"
            },
            "Opportunity Number": {
              "expression": "{{ steps[\"step-2\"].record.opportunityNumber }}"
