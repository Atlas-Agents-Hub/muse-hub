            },
            "Goal": {
              "expression": "{{ record.output.goal }}"
            },
            "Notes": {
              "expression": "{{ record.output.good_to_know.join('\\n') }}"
            },
            "Title": {
              "expression": "{{ steps[\"step-2\"].record.opportunityTitle }}"
            },
            "Agency": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.agencyContactName }}"
            },
            "Status": "New",
            "Funding": {
              "expression": "{{ steps[\"step-2\"].record.synopsis.estimatedFunding }}"
            },
            "Duration": {
