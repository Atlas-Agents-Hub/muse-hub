{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-flux-dev-image-generation-fal-ai-to-google-drive-9b30e8",
  "title": "Flux Dev Image Generation (Fal.ai) to Google Drive",
  "nodes": [
    {
      "id": "step-1",
      "label": "Fal Flux",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-1-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"prompt\": \"{{ record.Prompt }}\",\n \"image_size\": {\n \"width\": {{ record.Width }},\n \"height\": {{ record.Height }}\n},\n \"num_inference_steps\": {{ record.Steps }},\n \"guidance_scale\": {{ record.Guidance }},\n \"num_images\": 1,\n \"enable_safety_checker\": true\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-2",
      "label": "Get Image Result URL",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://queue.fal.run/fal-ai/flux/requests/{{ record.request_id }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Download Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.images[0].url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "name": {
          "expression": "{{ $binary.data.fileName }}"
        },
        "driveId": {
          "configuration_input": "step-4-driveid"
        },
        "options": {},
        "folderId": {
          "configuration_input": "step-4-folderid"
        }
      }
    },
    {
      "id": "step-5",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-6",
      "label": "Wait 3 Sec",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 3
      }
    },
    {
      "id": "step-7",
      "label": "Check Status",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://queue.fal.run/fal-ai/flux/requests/{{ record.request_id }}/status"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Completed?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "name": "filter.operator.equals",
                "type": "string",
                "operation": "equals"
              },
              "leftValue": {
                "expression": "{{ record.status }}"
              },
              "rightValue": "COMPLETED"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Edit Fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "Prompt",
              "type": "string",
              "value": "Thai young woman net idol 25 yrs old, walking on the street"
            },
            {
              "name": "Width",
              "type": "number",
              "value": 1024
            },
            {
              "name": "Height",
              "type": "number",
              "value": 768
            },
            {
              "name": "Steps",
              "type": "number",
              "value": 30
            },
            {
              "name": "Guidance",
              "type": "number",
              "value": 3.5
            }
          ]
        }
      }
    }
  ],
  "edges": [
