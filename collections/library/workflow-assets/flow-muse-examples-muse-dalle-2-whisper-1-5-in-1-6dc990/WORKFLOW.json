      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "davinci-003-complete",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "{{ record.text }}\n\nTl;dr:"
        },
        "options": {
          "maxTokens": 500
        }
      }
    },
    {
      "id": "step-3",
      "label": "Model-ex2",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": {
                "expression": "You are an assistant. Always add 5 emojis to the end of your answer."
              }
            },
            {
              "content": {
                "expression": "Write tl;dr of the wollowing text: {{ record.text}}"
              }
            }
          ]
        },
        "options": {
          "maxTokens": 500,
          "temperature": 0.8
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-4",
      "label": "davinci-003-edit",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "input": {
          "expression": "{{ record.text }}"
        },
        "options": {},
        "operation": "edit",
        "instruction": "translate to German"
      }
    },
    {
      "id": "step-5",
      "label": "Model-ex1.1",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "content": {
                "expression": "Write a Tl;dr of the followint text: {{ record.text }}"
              }
            }
          ]
        },
        "options": {
          "maxTokens": 500
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-6",
      "label": "Model-ex1.2",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "content": {
                "expression": "Translate to German the following text: {{ record.message.content }}"
              }
            }
          ]
        },
        "options": {
          "maxTokens": 500
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-7",
      "label": "Text-example",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "return [\n {\n \"text\": \"Science Underground with your host, Anissa Ramirez. In this episode, how to stop your bathroom mirror from fogging up with a little dash of science. I'm Anissa Ramirez and this is Science Underground. We've all been there. You come out of the shower and you go to the mirror and you can't see yourself because the mirror is fogged up. You can't see anything until you first clear off the surface. Every morning it's the same thing. Shower, fog, shower, fog, shower, fog. There's gotta be a better way. Well, there is. Before you take the next shower, wipe a bit of shaving cream on the surface of the mirror and keep it there for about 30 seconds. Then wipe it off. The next time you take a shower, that part of the mirror that was covered with shaving cream will be amazingly fog free. And the shaving cream will keep the water from fogging up for a few weeks. So what's going on? Well, the fog on your mirror is made out of little itty bitty water droplets. If you were to look at the surface of the mirror under the microscope, you will see that the surface looks like a newly waxed car. The water forms beads, preventing you from seeing yourself in the mirror. When you add shaving cream to the surface of the mirror, the water droplets are no longer beads. They are a thin, smoothed out layer of water. Just like the surface of an old car that hasn't been waxed. Scientists would say that the shaving cream has changed the surface tension of the mirror. So there you have it. There's the answer. The secret to fogless mirrors is shaving cream. A little dab of science will do you. I'm Anissa Ramirez, and this was Science Underground.\"\n }\n];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Code-ex3.1",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "var intext = records[0].json;\n\nvar messages = [\n {\"role\": \"system\", \"content\": \"You are a helpful assistant. Write a Tl;dr of each user message\"},\n {\"role\": \"user\", \"content\": intext.text}\n];\n\nreturn {\"messages\":messages};",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Model-ex3.1",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-9-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-3.5-turbo"
            },
            {
              "name": "temperature",
              "value": {
                "expression": "{{ parseFloat(0.8) }}"
              }
            },
            {
              "name": "n",
              "value": {
                "expression": "{{ Number(1) }}"
              }
            },
            {
              "name": "max_tokens",
              "value": {
                "expression": "{{ Number(500) }}"
              }
            },
            {
              "name": "messages",
              "value": {
                "expression": "{{ record.messages }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Model-ex3.2",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": {
                "expression": "You are now a DALLE-2 prompt generation tool that will generate a suitable prompt. Write a promt to create a cover image relevant to the user input. The image should be in a comic style of the 60-s."
              }
            },
            {
              "content": {
                "expression": "{{ record.choices[0].message.content }}"
              }
            }
          ]
        },
        "options": {
          "maxTokens": 500,
          "temperature": 0.8
        },
        "resource": "chat"
      }
    },
    {
      "id": "step-11",
      "label": "DALLE-ex3.3",
      "operation": "generate",
      "adapter": "model",
