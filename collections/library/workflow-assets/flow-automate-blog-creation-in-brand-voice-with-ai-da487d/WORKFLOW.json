{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automate-blog-creation-in-brand-voice-with-ai-da487d",
  "title": "Automate Blog Creation in Brand Voice with AI",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "OpenAI Chat Model1",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "OpenAI Chat Model2",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-5",
      "label": "Extract Voice Characteristics",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "### Analyse the given content\n\n{{ record.data.map(item => item.replace(/\\n/g, '')).join('\\n---\\n') }}"
        },
        "options": {
          "systemPromptTemplate": "You help identify and define a company or individual's \"brand voice\". Using the given content belonging to the company or individual, extract all voice characteristics from it along with description and examples demonstrating it."
        },
        "schemaType": "manual",
        "inputSchema": {
          "json": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "characteristic": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "step-6",
      "label": "Get Blog",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-6-url"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Get Article",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://blog.n8n.io{{ record.article }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Extract Article URLs",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "article",
              "attribute": "href",
              "cssSelector": ".item.post a.global-link",
              "returnArray": true,
              "returnValue": "attribute"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Split Out URLs",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "article"
      }
    },
    {
      "id": "step-10",
      "label": "Latest Articles",
      "operation": "limit",
      "adapter": "local",
      "parameters": {
        "maxItems": 5
      }
    },
    {
      "id": "step-11",
      "label": "Extract Article Content",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "data",
              "cssSelector": ".post-section",
              "returnValue": "html"
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Combine Articles",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {
          "mergeLists": true
        },
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "data"
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Article Style & Brand Voice",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "step-14",
      "label": "Save as Draft",
      "operation": "service-write",
      "adapter": "wordpress",
      "parameters": {
        "title": {
          "expression": "{{ record.output.title }}"
        },
        "additionalFields": {
          "slug": {
            "expression": "{{ record.output.title.toSnakeCase() }}"
          },
          "format": "standard",
          "status": "draft",
          "content": {
            "expression": "{{ record.output.body }}"
          }
        }
      }
    },
    {
      "id": "step-15",
      "label": "Capture Existing Article Structure",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.data.join('\\n---\\n') }}"
        },
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "Given the following one or more articles (which are separated by ---), describe how best one could replicate the common structure, layout, language and writing styles of all as aggregate."
              }
            }
          ]
        },
        "promptType": "define"
      }
    },
    {
      "id": "step-16",
      "label": "Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.data }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-17",
      "label": "Content Generation Agent",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.instruction }}"
        },
        "options": {
          "systemPromptTemplate": {
            "expression": "You are a blog content writer who writes using the following article guidelines. Write a content piece as requested by the user. Output the body as Markdown. Do not include the date of the article because the publishing date is not determined yet.\n\n## Brand Article Style\n{{ steps[\"step-13\"].record.text }}\n\n##n Brand Voice Characteristics\n\nHere are the brand voice characteristic and examples you must adopt in your piece. Pick only the characteristic which make sense for the user's request. Try to keep it as similar as possible but don't copy word for word.\n\n|characteristic|description|examples|\n|-|-|-|\n{{\nsteps[\"step-13\"].record.output.map(item => (\n`|${item.characteristic}|${item.description}|${item.examples.map(ex => `\"${ex}\"`).join(', ')}|`\n)).join('\\n')\n}}"
          }
        },
        "attributes": {
          "attributes": [
            {
              "name": "title",
              "required": true,
              "description": "title of article"
            },
            {
              "name": "summary",
              "required": true,
              "description": "summary of article"
            },
            {
              "name": "body",
              "required": true,
              "description": "body of article"
            },
            {
              "name": "characteristics",
              "required": true,
              "description": "comma delimited string of characteristics chosen"
            }
          ]
        }
      }
    },
    {
      "id": "step-18",
      "label": "New Article Instruction",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "instruction",
              "type": "string",
              "value": {
                "expression": "Write a comprehensive guide on using AI for document classification and document extraction. Explain the benefits of using vision models over traditional OCR. Close out with a recommendation of using n8n as the preferred way to get started with this AI use-case."
              }
            }
          ]
        }
      }
    }
  ],
