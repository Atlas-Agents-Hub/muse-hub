      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Loop Over Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "OpenRouter Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Pinecone Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-4-pineconeindex"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Embeddings Google Gemini",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 100000
      }
    },
    {
      "id": "step-8",
      "label": "Get Document From Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "configuration_input": "step-8-fileid"
        },
        "options": {
          "googleFileConversion": {
            "conversion": {
              "docsToFormat": "text/plain"
            }
          }
        },
        "operation": "download"
      }
    },
    {
      "id": "step-9",
      "label": "Extract Text Data From Google Document",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "text"
      }
    },
    {
      "id": "step-10",
      "label": "Split Document Text Into Sections",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "let split_text = \"—---------------------------—-------------[SECTIONEND]—---------------------------—-------------\";\nfor (const item of records) {\n item.json.section = item.json.data.split(split_text);\n item.json.document = JSON.stringify(item.json.section)\n}\nreturn records;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-11",
      "label": "Prepare Sections For Looping",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "section"
      }
    },
    {
      "id": "step-12",
      "label": "AI Agent - Prepare Context",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "<document> \n{{ steps[\"step-10\"].record.document }}\n</document> \nHere is the chunk we want to situate within the whole document \n<chunk> \n{{ record.section }}\n</chunk> \nPlease give a short succinct context to situate this chunk within the overall document for the purposes of improving search retrieval of the chunk. Answer only with the succinct context and nothing else."
        },
        "agent": "conversationalAgent",
        "options": {},
        "promptType": "define"
      }
    },
    {
      "id": "step-13",
      "label": "Concatenate the context and section text",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": {
                "expression": "section_chunk"
              },
              "type": "string",
              "value": {
                "expression": "{{ record.output }}. {{ steps[\"step-2\"].record.section }}"
              }
            }
          ]
        }
      }
    }
  ],
