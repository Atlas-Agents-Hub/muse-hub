          "expression": "https://api.cloud.llamaindex.ai/api/parsing/job/{{ record.id }}/result/markdown"
        },
        "options": {
          "redirect": {
            "redirect": {}
          }
        }
      }
    },
    {
      "id": "step-11",
      "label": "Map Output",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{{ record.output }}"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Apply Data Extraction Rules",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Given the following invoice in the <invoice> xml tags, extract the following information as listed below.\nIf you cannot the information for a specific item, then leave blank and skip to the next. \n\n* Invoice date\n* invoice number\n* Purchase order number\n* Supplier name\n* Supplier address\n* Supplier VAT identification number\n* Customer name\n* Customer address\n* Customer VAT identification number\n* Shipping addresses\n* Line items, including a description of the goods or services rendered\n* Price with and without VAT\n* Total price\n\n<invoice>{{ record.markdown }}</invoice>"
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-13",
      "label": "Should Process Email?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "name": "filter.operator.equals",
                "type": "string",
                "operation": "equals"
              },
              "leftValue": {
                "expression": "{{ record.binary.attachment_0.mimeType }}"
              },
              "rightValue": "application/pdf"
            },
            {
              "operator": {
                "type": "array",
                "operation": "notContains",
                "rightType": "any"
              },
              "leftValue": {
                "expression": "{{ record.labels }}"
              },
              "rightValue": "invoice synced"
            }
          ]
        }
      }
    },
    {
      "id": "step-14",
      "label": "Split Out Labels",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "labelIds"
      }
    },
    {
      "id": "step-15",
      "label": "Get Labels Names",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "labelId": {
          "expression": "{{ record.labelIds }}"
        },
        "resource": "label",
        "operation": "get"
      }
    },
    {
      "id": "step-16",
      "label": "Combine Label Names",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "renameField": true,
              "outputFieldName": "labels",
              "fieldToAggregate": "name"
            }
          ]
        }
      }
    },
    {
      "id": "step-17",
      "label": "Email with Label Names",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "multiplex"
      }
    }
