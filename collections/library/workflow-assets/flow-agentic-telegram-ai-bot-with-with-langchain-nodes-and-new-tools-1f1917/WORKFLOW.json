{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-agentic-telegram-ai-bot-with-with-langchain-nodes-and-new-tools-1f1917",
  "title": "Agentic Telegram AI bot with with LangChain nodes and new tools",
  "nodes": [
    {
      "id": "step-1",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.7,
          "frequencyPenalty": 0.2
        }
      }
    },
    {
      "id": "step-2",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {
        "sessionKey": {
          "expression": "chat_with_{{ steps[\"step-3\"].records[0].message.chat.id }}"
        },
        "contextWindowLength": 10
      }
    },
    {
      "id": "step-3",
      "label": "Listen for incoming events",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "*"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-4",
      "label": "Send final reply",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ record.output }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-3\"].records[0].message.from.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-5",
      "label": "Send back an image",
      "operation": "service-read",
      "adapter": "telegram",
      "parameters": {
        "file": {
          "expression": "{{ $fromAI(\"url\", \"a valid url of an image\", \"string\", \" \") }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-3\"].records[0].message.from.id }}"
        },
        "operation": "sendDocument",
        "additionalFields": {}
      }
    },
    {
      "id": "step-6",
      "label": "Generate image in Dalle",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-6-url"
        },
        "method": "POST",
        "sendBody": true,
        "parametersBody": {
          "values": [
            {
              "name": "model",
              "value": "dall-e-3",
              "valueProvider": "fieldValue"
            },
            {
              "name": "prompt"
            }
          ]
        },
        "toolDescription": "Call this tool to request a Dall-E-3 model, when the user asks to draw something. If you gеt a response from this tool, forward it to the Telegram tool."
      }
    },
    {
      "id": "step-7",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "{{ record.message.text }}"
        },
        "options": {
          "systemMessage": {
            "expression": "You are a helpful assistant. You are communicating with a user named {{ record.message.from.first_name }}. Address the user by name every time. If the user asks for an image, always send the link to the image in the final reply."
          }
        },
        "promptType": "define"
      }
    }
  ],
  "edges": [
    {
      "from": "step-7",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-7",
