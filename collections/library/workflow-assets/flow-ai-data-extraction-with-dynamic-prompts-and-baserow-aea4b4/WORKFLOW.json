        "options": {
          "pagination": {
            "pagination": {
              "nextURL": {
                "expression": "{{ $response.body.next || `https://api.baserow.io/api/database/rows/table/${record.table_id}/?user_field_names=true&size=20&page=9999` }}"
              },
              "maxRequests": 3,
              "paginationMode": "responseContainsNextURL",
              "requestInterval": 1000,
              "limitPagesFetched": true,
              "completeExpression": {
                "expression": "{{ $response.body.isEmpty() || $response.statusCode >= 400 }}"
              },
              "paginationCompleteWhen": "other"
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_field_names",
              "value": "true"
