{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-ai-generated-summary-block-for-wordpress-posts-c117d5",
  "title": "AI-Generated Summary Block for WordPress Posts",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Text Classifier",
      "operation": "classify",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemPromptTemplate": "Analyze the provided text and classify it into one of the following categories: {categories}. \n- If the text contains an 'AI Summary', classify it as \"summarized\".\n- If the text does not contain an 'AI Summary', classify it as \"not_summarized\".\n\nFollow these instructions strictly:\n- Provide the result in JSON format.\n- Do not include any explanations, comments, or additional text.\n"
        },
        "inputText": {
          "expression": "{{ record.data }}"
        },
        "categories": {
          "categories": [
            {
              "category": "not_summarized",
              "description": "Content that does not contain an 'AI Summary'."
            },
            {
              "category": {
                "expression": "summarized"
              },
              "description": "Content that contains an 'AI Summary'."
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Loop Over Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.post_id }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Webhook",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "bypass": true,
        "instruction": "Pass the incoming records to the next connected operation."
      }
    },
    {
      "id": "step-7",
      "label": "Schedule Trigger",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "bypass": true,
        "instruction": "Pass the incoming records to the next connected operation."
      }
    },
    {
      "id": "step-8",
      "label": "Wordpress - Update Post",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://<your-domain.com>/wp-json/wp/v2/posts/{{ steps[\"step-4\"].record.id }}"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": {
                "expression": "content"
              },
              "value": {
                "expression": "{{ `${record.message.content} ${steps[\"step-2\"].record.content.raw}` }}"
              }
            },
            {
              "name": "excerpt",
              "value": {
                "expression": "{{ steps[\"step-2\"].record.excerpt.rendered }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Google Sheets - Get rows",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupValue": {
                "expression": "{{ record.id }}"
              },
              "lookupColumn": "post_id"
            }
          ]
        },
        "sheetName": {
          "configuration_input": "step-9-sheetname"
        },
        "documentId": {
          "configuration_input": "step-9-documentid"
        }
      }
    },
    {
      "id": "step-10",
      "label": "HTML to Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.content.rendered }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Model",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-11-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "{{ record.data }}"
              }
            },
            {
              "role": "system",
              "content": {
                "expression": "You are an expert in content summarization and web-optimized writing. \nYour mission is to analyze the HTML content of an article from a website focused on electric vehicles and green mobility and extract the key information. \n\nGenerate only an HTML block containing a concise summary in bullet point format, strictly following this structure:\n\n\n<!-- wp:html -->\n<div class=\"wp-block-group has-background\" style=\"background-color:#f8faff; border-radius:4px; padding:10px;\">\n <p style=\"font-style:normal; font-weight:1000; font-size:1.1em; margin:0 0 10px 0;\">\n <strong>✨ AI Summary</strong> :\n </p>\n\n <li>[Key point 1]</li>\n <li>[Key point 2]</li>\n <li>[Key point 3]</li>\n <li>[Key point 4]</li>\n\n</div>\n<!-- /wp:html -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n## Important: Strict Guidelines to Follow\n\n- Ensure the summary is **clear, concise, and informative**, focusing only on key points. \n- **Avoid unnecessary introductions**, such as \"This article presents\" or similar phrases. \n- **Output only the required HTML block**, without any additional explanations or commentary. \n- The output must **start with** the `<!-- wp:html -->` tag and **end with** the closing separator tag. \n- The summary must be **in the user's language**, including the phrase `\"✨ AI Summary\"`, which should also be translated accordingly. \n- **Do not add** any extra text, comments, or formatting outside the specified HTML block. \n\n\n## Example of a GOOD output:\n\n<!-- wp:html -->\n<div class=\"wp-block-group has-background\" style=\"background-color:#f8faff; border-radius:4px; padding:10px;\">\n <p style=\"font-style:normal; font-weight:1000; font-size:1.1em; margin:0 0 10px 0;\">\n <strong>✨ AI Summary</strong> :\n </p>\n\n <li>In March 2022, France had 43,700 public charging points for electric vehicles.</li>\n <li>Half of the highway service areas are equipped with ultra-fast charging stations.</li>\n <li>France is among the most equipped European countries, with 20% of the charging points in Europe.</li>\n <li>The goal is to reach 100,000 charging stations to support future demand for electric vehicles.</li>\n\n</div>\n<!-- /wp:html -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n## Example of a BAD output:\n```html\n<!-- wp:html -->\n<div class=\"wp-block-group has-background\" style=\"background-color:#f8faff; border-radius:4px; padding:10px;\">\n <p style=\"font-style:normal; font-weight:1000; font-size:1.1em; margin:0 0 10px 0;\">\n <strong>✨ AI Summary</strong> :\n </p>\n\n <li>In March 2022, France had 43,700 public charging points for electric vehicles.</li>\n <li>Half of the highway service areas are equipped with ultra-fast charging stations.</li>\n <li>France is among the most equipped European countries, with 20% of the charging points in Europe.</li>\n <li>The goal is to reach 100,000 charging stations to support future demand for electric vehicles.</li>\n\n</div>\n<!-- /wp:html -->\n```"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-12",
      "label": "Google Sheets - Add Row",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "post_id": {
              "expression": "{{ record.id }}"
            },
            "summary": {
              "expression": "{{record.ai_summary}}"
            },
            "edit_link": {
              "expression": "{{ record.edit_link }}"
            },
            "post_link": {
              "expression": "{{ record.link }}"
            },
            "summarized_date": {
              "expression": "{{current_time}}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "post_id",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "summary",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "post_link",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "edit_link",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "summarized_date",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "autoMapInputData",
          "matchingColumns": [
            "post_id"
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {},
        "operation": "append",
        "sheetName": {
          "configuration_input": "step-12-sheetname"
        },
        "documentId": {
          "configuration_input": "step-12-documentid"
        }
      }
    },
    {
      "id": "step-13",
      "label": "Slack - Notify Channel",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": "📄🔔 *New WordPress Post Updated with AI Summary*\n\nThe post *{{ steps[\"step-16\"].record.title }}* has been updated with an AI-generated summary at the top of the article. \nYou can view it here: {{ steps[\"step-16\"].record.post_link }}\n\n• *Post ID*: {{ steps[\"step-16\"].record.post_id }}\n• *Edit Link*: {{ steps[\"step-16\"].record.edit_link }}"
        },
        "select": "channel",
        "channelId": {
          "configuration_input": "step-13-channelid"
        },
        "otherOptions": {
          "mrkdwn": true
        }
      }
    },
    {
      "id": "step-14",
      "label": "Set fields - From Webhook input",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "post_id",
              "type": "string",
              "value": {
                "expression": "{{ record.body.post_id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-15",
      "label": "Date & Time - Substract",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "options": {},
        "duration": 30,
        "timeUnit": "seconds",
        "magnitude": {
          "expression": "{{ record.timestamp }}"
        },
        "operation": "subtractFromDate",
        "outputFieldName": "last_execution_date"
      }
    },
    {
      "id": "step-16",
      "label": "Set fields - Prepare data for Gsheets & Slack",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "post_id",
              "type": "string",
              "value": {
                "expression": "{{ record.id }}"
              }
            },
            {
              "name": "title",
              "type": "string",
              "value": {
                "expression": "{{ record.title.rendered }}"
              }
            },
            {
              "name": "post_link",
              "type": "string",
              "value": {
                "expression": "{{ record.link }}"
              }
            },
            {
              "name": "edit_link",
              "type": "string",
              "value": {
                "expression": "https://<your-domain.com>/wp-admin/post.php?post={{ record.id }}&action=edit"
              }
            },
            {
              "name": "summary",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-11\"].record.message.content }}"
              }
            },
            {
              "name": "summary_date",
              "type": "string",
              "value": {
                "expression": "{{ current_time }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-17",
      "label": "WordPress - Get Post2",
      "operation": "service-read",
      "adapter": "wordpress",
      "parameters": {
        "postId": {
          "expression": "{{ steps[\"step-4\"].record.id }}"
        },
        "options": {
          "context": "edit"
        },
        "operation": "get"
      }
    },
    {
      "id": "step-18",
      "label": "No Operation, do nothing",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-19",
      "label": "WordPress - Get Last Posts",
      "operation": "service-read",
      "adapter": "wordpress",
      "parameters": {
        "options": {
          "after": {
            "expression": "{{ record.last_execution_date }}"
          },
          "context": "edit"
        },
        "operation": "getAll"
      }
    },
    {
      "id": "step-20",
      "label": "WordPress - Get Post1",
      "operation": "service-read",
      "adapter": "wordpress",
      "parameters": {
        "postId": {
          "expression": "{{ record.post_id }}"
        },
        "options": {
          "context": "edit"
        },
        "operation": "get"
      }
    },
    {
      "id": "step-21",
      "label": "WordPress - Get All Posts",
      "operation": "service-read",
      "adapter": "wordpress",
      "parameters": {
        "options": {
          "order": "desc",
          "context": "edit",
          "orderBy": "date"
        },
        "operation": "getAll"
      }
    }
