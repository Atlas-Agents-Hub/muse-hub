      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-5",
      "channel": "main",
      "branch": 1,
