{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-check-a-company-in-seven-eu-business-registers-from-a-form-5360fd",
  "title": "Check a company in seven EU business registers from a form",
  "nodes": [
    {
      "id": "step-1",
      "label": "Someone submits the form",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "formTitle": "Company check",
        "formDescription": "Enter a company name or a registration number. The official register of the country is read directly.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Company name or registration number",
              "placeholder": "Bolt, or cz:27074358",
              "requiredField": true
            },
            {
              "fieldLabel": "Country",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "cz"
                  },
                  {
                    "option": "ee"
                  },
                  {
                    "option": "fi"
                  },
                  {
                    "option": "fr"
                  },
                  {
                    "option": "no"
                  },
                  {
                    "option": "pl"
                  },
                  {
                    "option": "sk"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Look up the official register",
      "operation": "service-read",
      "adapter": "apify",
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": "gubidonius~company-registry-lookup",
        "customBody": {
          "expression": "{{ JSON.stringify({ queries: [record['Company name or registration number']], countries: [record['Country']], maxResultsPerQuery: 5, onlyActive: false }) }}"
        },
        "timeout": 600,
        "memory": 1024,
        "build": ""
      }
    },
    {
      "id": "step-3",
      "label": "Is the company still active",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.status }}"
              },
              "rightValue": "active",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Passed, keep the register fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "verdict",
              "value": "ok",
              "type": "string"
            },
            {
              "name": "company",
              "value": {
                "expression": "{{ record.name }}"
              },
              "type": "string"
            },
            {
              "name": "registrationNumber",
              "value": {
                "expression": "{{ record.registrationNumber }}"
              },
              "type": "string"
            },
            {
              "name": "country",
              "value": {
                "expression": "{{ record.countryName }}"
              },
              "type": "string"
            },
            {
              "name": "legalForm",
              "value": {
                "expression": "{{ record.legalFormCode }}"
              },
              "type": "string"
            },
            {
              "name": "address",
              "value": {
                "expression": "{{ record.address }}"
              },
              "type": "string"
            },
            {
              "name": "vatNumber",
              "value": {
                "expression": "{{ record.vatNumber }}"
              },
              "type": "string"
            },
            {
              "name": "registryUrl",
              "value": {
                "expression": "{{ record.registryUrl }}"
              },
              "type": "string"
            },
            {
              "name": "registryUpdatedAt",
              "value": {
                "expression": "{{ record.registryUpdatedAt }}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Not active, send it to a human",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "verdict",
              "value": "check by hand",
              "type": "string"
            },
            {
              "name": "company",
              "value": {
                "expression": "{{ record.name }}"
              },
              "type": "string"
            },
            {
              "name": "status",
              "value": {
                "expression": "{{ record.status }}"
              },
              "type": "string"
            },
            {
              "name": "statusRaw",
              "value": {
                "expression": "{{ record.statusRaw }}"
              },
              "type": "string"
            },
            {
              "name": "dissolvedAt",
              "value": {
                "expression": "{{ record.dissolvedAt }}"
              },
              "type": "string"
            },
            {
              "name": "registryUrl",
              "value": {
                "expression": "{{ record.registryUrl }}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
