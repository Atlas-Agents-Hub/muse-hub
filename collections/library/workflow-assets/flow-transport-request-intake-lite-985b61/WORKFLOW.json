{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-transport-request-intake-lite-985b61",
  "title": "Transport Request Intake Lite",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "transport-intake-lite",
        "responseMode": "responseNode"
      }
    },
    {
      "id": "step-2",
      "label": "Normalize Fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "pickup_postcode",
              "value": {
                "expression": "{{ record.pickup_postcode != null ? String(record.pickup_postcode).trim() : '' }}"
              },
              "type": "string"
            },
            {
              "name": "delivery_postcode",
              "value": {
                "expression": "{{ record.delivery_postcode != null ? String(record.delivery_postcode).trim() : '' }}"
              },
              "type": "string"
            },
            {
              "name": "pickup_date",
              "value": {
                "expression": "{{ record.pickup_date != null ? String(record.pickup_date).trim() : '' }}"
              },
              "type": "string"
            },
            {
              "name": "weight_kg",
              "value": {
                "expression": "{{ record.weight_kg != null ? parseFloat(String(record.weight_kg).replace(/\\s/g, '').replace(',', '.')) : NaN }}"
              },
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Validate Required Fields",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "missing_fields",
              "value": {
                "expression": "{{ [\n  (record.pickup_postcode === '' ? 'pickup_postcode' : null),\n  (record.delivery_postcode === '' ? 'delivery_postcode' : null),\n  (record.pickup_date === '' ? 'pickup_date' : null),\n  (isNaN(record.weight_kg) ? 'weight_kg' : null)\n].filter(f => f !== null) }}"
              },
              "type": "array"
            },
            {
              "name": "status",
              "value": {
                "expression": "{{ [\n  (record.pickup_postcode === '' ? 'pickup_postcode' : null),\n  (record.delivery_postcode === '' ? 'delivery_postcode' : null),\n  (record.pickup_date === '' ? 'pickup_date' : null),\n  (isNaN(record.weight_kg) ? 'weight_kg' : null)\n].filter(f => f !== null).length === 0 ? 'ready' : 'needs_review' }}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Build Result",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "status",
              "value": {
                "expression": "{{ record.status }}"
              },
              "type": "string"
            },
            {
              "name": "missing_fields",
              "value": {
                "expression": "{{ record.missing_fields }}"
              },
              "type": "array"
            },
            {
              "name": "normalized_request",
              "value": {
                "expression": "{{ {\n  pickup_postcode: record.pickup_postcode,\n  delivery_postcode: record.delivery_postcode,\n  pickup_date: record.pickup_date,\n  weight_kg: isNaN(record.weight_kg) ? null : record.weight_kg\n} }}"
              },
              "type": "object"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Respond to Webhook",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "responseCode": 200,
        "body": {
          "expression": "{{ JSON.stringify({\n  status: record.status,\n  missing_fields: record.missing_fields,\n  normalized_request: record.normalized_request\n}, null, 2) }}"
        },
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        }
      }
    }
