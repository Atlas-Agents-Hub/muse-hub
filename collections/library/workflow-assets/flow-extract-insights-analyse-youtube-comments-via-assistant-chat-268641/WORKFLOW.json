    {
      "id": "step-2",
      "label": "get_channel_details",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "get_channel_details",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": {
                "expression": "get_channel_details"
              }
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-2-workflowid"
        },
        "description": "Get channel_id, title and description by handle/username.\nChannel_id is required to find videos and details about this channel.\nIf Youtube link to channel provided - parse handle from there or return channel_id. (e.g. https://www.youtube.com/@example_handle - example_handle)\n\n\nExample Input:\nexample_handle\n\nExample Output:\nid:UCOgz_YflAsYnGbdvzXuKNCA\ntitle:Daniel Simmons\ndescription:Digital Diary 🤎\\n\\n\\nWeekly videos around fashion...",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string",
                "description": "Handle/username of channel"
              }
            },
            "required": [
              "handle"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-3",
      "label": "get_video_description",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "get_video_description",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": "video_details"
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-3-workflowid"
        },
        "description": "Fetch video details - the full description, title, and publish date of a video using its video_id.\n\nExample input:\nvideo_id:dQw4w9WgXcQ\n\nExample Output:\ntitle:Never Gonna Give You Up\ndescription: \"The official video for “Never Gonna Give You Up” by Rick Astley.\nduration:4 min\nviewCount:154\nlikeCount:6\nthumbnails: urls",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "video_id": {
                "type": "string",
                "description": "The ID of the video to fetch details for"
              }
            },
            "required": [
              "video_id"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-4",
      "label": "get_list_of_videos",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "get_list_of_videos",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": "videos"
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-4-workflowid"
        },
        "description": "Retrieve a list of videos from a channel using channel_id. Supports sorting by date, relevance, or view count.\n\nExample Input:\nchannel_id\": \"UCxxxxxxxxxxxxxxxx\"\nnumber_of_videos\": 5\norder: \"date\"\npublishedAfter: \"timestamp\"\n\nExample Output:\nvideo_id:abc123\ntitle:Latest Video\nshort cut description:Latest Video\npublished_at:2023-12-05T10:00:00Z",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "channel_id": {
                "type": "string",
                "description": "The ID of the channel to fetch videos from"
              },
              "number_of_videos": {
                "type": "integer",
                "description": "The maximum number of videos to retrieve (max 50)"
              },
              "order": {
                "type": "string",
                "enum": [
                  "date",
                  "relevance",
                  "viewCount"
                ],
                "description": "Order in which to fetch videos"
              },
              "publishedAfter": {
                "type": "string",
                "description": "Timestamp for filtering like 2023-11-03T15:28:05Z."
              }
            },
            "required": [
              "channel_id",
              "number_of_videos",
              "order"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-5",
      "label": "get_list_of_comments",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "get_list_of_comments",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": "comments"
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-5-workflowid"
        },
        "description": "Retrieve a list of comments from a video using video_id.\n\nInput:\n \"video_id\": \"dQw4w9WgXcQ\"\n\nOutput:\n \"author\": \"John Doe\",\n \"comment\": \"This is an amazing video!\",\n \"published_at\": \"2023-12-04T12:00:00Z\"",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "video_id": {
                "type": "string",
                "description": "The ID of the video to fetch comments from"
              }
            },
            "required": [
              "video_id"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-6",
      "label": "search",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "search",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": "search"
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-6-workflowid"
        },
        "description": "Search for videos or channels using a query. Supports filtering by type (video or channel) and sorting (date, viewCount, relevance). Use | for OR and - to exclude terms in the query.\n\nInput:\ntype: video or channel\nquery: search query\nsorting: date, viewCount, relevance\npublishedAfter: timestamp\n\nOutput:\n- id, title, short cut description, and published_at.",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "video",
                  "channel"
                ],
                "description": "Type of results to retrieve: video or channel"
              },
              "query": {
                "type": "string",
                "description": "Search query. Supports | for OR and - to exclude terms"
              },
              "sorting": {
                "type": "string",
                "enum": [
                  "date",
                  "viewCount",
                  "relevance"
                ],
                "description": "Sorting criteria for search results"
              },
              "publishedAfter": {
                "type": "string",
                "description": "Timestamp for filtering like 2023-11-03T15:28:05Z"
              }
            },
            "required": [
              "type",
              "query",
              "sorting"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-7",
      "label": "analyze_thumbnail",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "analyze_thumbnail",
        "fields": {
          "values": [
            {
              "name": "command",
              "stringValue": "analyze_thumbnail"
            }
          ]
        },
        "schemaType": "manual",
        "workflowId": {
          "configuration_input": "step-7-workflowid"
        },
        "description": "Analyze a thumbnail image based on a given prompt. The prompt can be customized for specific analysis needs, such as design critique, color scheme evaluation, or content assessment.\nUse link of maxRes thumbnail. \n\nInput:\n- url: URL of the thumbnail image.\n- prompt: Customizable instruction for the analysis.\n\nOutput:\n- Results of the analysis based on the given prompt.",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "description": "URL of the thumbnail image to analyze"
              },
              "prompt": {
                "type": "string",
                "description": "Customizable instruction to guide the image analysis"
              }
            },
            "required": [
              "url",
              "prompt"
            ]
          }
        },
        "specifyInputSchema": true
      }
    },
    {
