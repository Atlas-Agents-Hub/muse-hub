{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-qualify-replies-from-pipedrive-persons-with-ai-c7d721",
  "title": "Qualify replies from Pipedrive persons with AI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Search Person in CRM",
      "operation": "service-read",
      "adapter": "pipedrive",
      "parameters": {
        "term": {
          "expression": "{{ record.from.value[0].address }}"
        },
        "limit": 1,
        "resource": "person",
        "operation": "search",
        "additionalFields": {
          "includeFields": ""
        }
      }
    },
    {
      "id": "step-2",
      "label": "In campaign?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": {
                "expression": "{{ record.in_campaign }}"
              },
              "value2": "True"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Get person from CRM",
      "operation": "service-read",
      "adapter": "pipedrive",
      "parameters": {
        "personId": {
          "expression": "{{ record.id }}"
        },
        "resource": "person",
        "operation": "get",
        "resolveProperties": true
      }
    },
    {
      "id": "step-4",
      "label": "Is interested?",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "model": {
          "configuration_input": "step-4-model"
        },
        "prompt": {
          "messages": [
            {
              "content": {
                "expression": "You are the best sales development representative in the world. You send cold email messages daily to CEOs and founders of companies. You do this to persuade them to make contact. This could be a phone call or a video meeting. \n\nYour task is to assess whether someone is interested in meeting up or calling sometime. You do this by attentively evaluating their response.\n\nThis is the email:\n{{ steps[\"step-5\"].record.text }}\n\nThe response format should be:\n{\"interested\": [yes/no],\n\"reason\": reason\n}\n\nJSON:"
              }
            }
          ]
        },
        "options": {},
        "resource": "chat"
      }
    },
    {
      "id": "step-5",
      "label": "Get email",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "email",
              "stringValue": {
                "expression": "{{ record.text }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Create deal in CRM",
      "operation": "service-read",
      "adapter": "pipedrive",
      "parameters": {
        "title": {
          "expression": "{{ steps[\"step-3\"].record.Name }} Deal"
        },
        "additionalFields": {}
      }
    },
    {
      "id": "step-7",
      "label": "IF interested",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": {
                "expression": "{{ record.interested }}"
              },
              "value2": "yes"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Get response",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "let interested = JSON.parse(record[\"message\"][\"content\"]).interested\nlet reason = JSON.parse(record[\"message\"][\"content\"]).reason\n\nreturn {json:{\n interested: interested,\n reason: reason\n}}",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Email box 1",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "filters": {
          "labelIds": []
        },
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Email box 2",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "filters": {
          "labelIds": []
        },
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    }
  ],
