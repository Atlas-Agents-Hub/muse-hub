{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-voiceagent-lite-phone-call-logger-cd22bb",
  "title": "VoiceAgent Lite - Phone Call Logger",
  "nodes": [
    {
      "id": "step-1",
      "label": "Call Received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "voiceagent-lite",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Parse Call",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "try {\n  const b = records[0].json.body || records[0].json;\n  return [{ json: { callId: b.call_id || require('crypto').randomUUID(), caller: b.caller_name || b.from || 'Unknown', phone: b.caller_phone || b.from || '', duration: b.duration || 0, transcript: b.transcript || '', summary: b.summary || '', receivedAt: new Date().toISOString() } }];\n} catch (e) { throw new Error('Parse failed: ' + e.message); }",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Log to Sheets",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "operation": "append",
        "documentId": {
          "expression": "{{ $env.VOICEAGENT_SHEET_ID }}"
        },
        "sheetName": {
          "configuration_input": "step-3-sheetname"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Call ID": {
              "expression": "{{ record.callId }}"
            },
            "Date": {
              "expression": "{{ record.receivedAt }}"
            },
            "Caller": {
              "expression": "{{ record.caller }}"
            },
            "Phone": {
              "expression": "{{ record.phone }}"
            },
            "Duration": {
              "expression": "{{ record.duration }}"
            },
            "Summary": {
              "expression": "{{ record.summary }}"
            },
            "Transcript": {
              "expression": "{{ record.transcript.substring(0,500) }}"
            }
          }
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Respond",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "expression": "{{ JSON.stringify({ success: true, callId: record.callId, caller: record.caller }) }}"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
  "configuration": [
    {
      "id": "step-3-sheetname",
      "purpose": "Select the sheetName for this task.",
      "required": true
    }
  ],
