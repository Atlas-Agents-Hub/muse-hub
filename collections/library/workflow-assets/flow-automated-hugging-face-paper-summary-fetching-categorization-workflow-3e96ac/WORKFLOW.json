{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automated-hugging-face-paper-summary-fetching-categorization-workflow-3e96ac",
  "title": "Automated Hugging Face Paper Summary Fetching & Categorization Workflow",
  "nodes": [
    {
      "id": "step-1",
      "label": "Embed image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-1-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"inputs\": [\n {\n \"content\": [\n {\n \"type\": \"image_url\",\n \"image_url\": steps[\"step-8\"].records[0].imageURL\n }\n ]\n }\n ],\n \"model\": \"voyage-multimodal-3\",\n \"input_type\": \"document\"\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-2",
      "label": "Get similarity of medoids",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-4\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-4\"].records[0].collectionName }}/points/query"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"query\": record.data[0].embedding,\n \"using\": \"voyage\",\n \"limit\": steps[\"step-5\"].records[0].cropsNumber,\n \"with_payload\": true,\n \"filter\": {\n \"must\": [\n { \n \"key\": steps[\"step-4\"].records[0].clusterCenterType,\n \"match\": {\n \"value\": true\n }\n }\n ]\n }\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-3",
      "label": "Compare scores",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "language": "python",
        "pythonCode": {
          "language": "python",
          "reference": "points = _input.first()['json']['result']['points']\nthreshold_type = _('Variables for medoids').first()['json']['clusterThresholdCenterType']\n\nmax_score = -1\ncrop_with_max_score = None\nundefined = True\n\nfor center in points:\n if center['score'] >= center['payload'][threshold_type]:\n undefined = False\n if center['score'] > max_score:\n max_score = center['score']\n crop_with_max_score = center['payload']['crop_name']\n\nif undefined:\n result_message = \"ALERT, we might have a new undefined crop!\"\nelse:\n result_message = f\"Looks similar to {crop_with_max_score}\"\n\nreturn [{\n \"json\": {\n \"result\": result_message\n }\n}]",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Variables for medoids",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "clusterCenterType",
              "type": "string",
              "value": "is_medoid"
            },
            {
              "name": "qdrantCloudURL",
              "type": "string",
              "value": {
                "configuration_input": "step-4-assignments-1-value"
              }
            },
            {
              "name": "collectionName",
              "type": "string",
              "value": {
                "expression": "agricultural-crops"
              }
            },
            {
              "name": "clusterThresholdCenterType",
              "type": "string",
              "value": "is_medoid_cluster_threshold"
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "Info About Crop Labeled Clusters",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": {
                "expression": "cropsNumber"
              },
              "type": "number",
              "value": {
                "expression": "{{ record.result.hits.length }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Total Points in Collection",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.qdrantCloudURL }}/collections/{{ record.collectionName }}/points/count"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"exact\": true\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-7",
      "label": "Each Crop Counts",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ steps[\"step-4\"].records[0].qdrantCloudURL }}/collections/{{ steps[\"step-4\"].records[0].collectionName }}/facet"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"key\": \"crop_name\",\n \"limit\": record.result.count,\n \"exact\": true\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-8",
      "label": "Image URL hardcode",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "imageURL",
              "type": "string",
              "value": {
                "expression": "{{ record.query.imageURL }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    }
  ],
