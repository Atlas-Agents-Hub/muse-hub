  "title": "RAG Chatbot for Company Documents using Google Drive and Muse",
  "nodes": [
    {
      "id": "step-1",
      "label": "Pinecone Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-1-pineconeindex"
        }
      }
    },
    {
      "id": "step-2",
      "label": "Embeddings Model",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "dataType": "binary",
        "binaryMode": "specificField"
      }
    },
    {
      "id": "step-4",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkOverlap": 100
      }
    },
    {
      "id": "step-5",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful HR assistant designed to answer employee questions based on company policies.\n\nRetrieve relevant information from the provided internal documents and provide a concise, accurate, and informative answer to the employee's question.\n\nUse the tool called \"company_documents_tool\" to retrieve any information from the company's documents.\n\nIf the answer cannot be found in the provided documents, respond with \"I cannot find the answer in the available resources.\""
        }
      }
    },
    {
      "id": "step-6",
      "label": "Vector Store Tool",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "name": "company_documents_tool",
        "description": "Retrieve information from any company documents"
      }
    },
    {
      "id": "step-7",
      "label": "Pinecone Vector Store (Retrieval)",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "options": {},
        "pineconeIndex": {
          "configuration_input": "step-7-pineconeindex"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Embeddings Model (retrieval)",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-9",
      "label": "Download File From Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ record.id }}"
        },
        "options": {
          "fileName": {
            "expression": "{{ record.name }}"
          }
        },
        "operation": "download"
      }
    },
    {
      "id": "step-10",
      "label": "Google Drive File Updated",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "fileUpdated",
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "configuration_input": "step-10-foldertowatch"
        }
      }
    },
    {
      "id": "step-11",
      "label": "Google Drive File Created",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "fileCreated",
        "options": {
          "fileType": "all"
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "configuration_input": "step-11-foldertowatch"
        }
      }
    },
    {
