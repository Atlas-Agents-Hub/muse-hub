{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-process-store-orders-from-webhook-to-supplier-shipping-crm-and-erp-with-stock-2a62d3",
  "title": "Process store orders from webhook to supplier, shipping, CRM and ERP with stock checks",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook: store order paid (Shopify / WooCommerce / Salla)",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "shopify-order",
        "responseMode": "lastNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "step-2",
      "label": "Config",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-2-assignments-0-value"
              },
              "type": "string"
            },
            {
              "id": {
                "configuration_input": "step-2-assignments-1-id"
              },
              "name": "webhook_secret",
              "value": {
                "configuration_input": "step-2-assignments-1-value"
              },
              "type": "string"
            },
            {
              "name": "sku_map",
              "value": {
                "json": {
                  "Walnut floating shelf 120x25cm": "SHELF-WAL-120",
                  "White Oak floating shelf 150x30cm": "SHELF-OAK-150",
                  "Maple floating shelf 90x25cm": "SHELF-MAP-90"
                }
              },
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Verify HMAC, normalise, idempotency",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// 1) Verify the store's HMAC signature on the raw body before trusting anything.\nconst crypto = require('crypto');\nconst cfg = steps[\"step-2\"].records[0];\nconst item = steps[\"step-1\"].first();\nconst headers = item.json.headers || {};\nconst raw = item.binary?.data ? Buffer.from(item.binary.data.data, 'base64').toString() : JSON.stringify(item.json.body || {});\nconst expected = crypto.createHmac('sha256', cfg.webhook_secret).update(raw).digest('base64');\nconst given = headers['x-shopify-hmac-sha256'] || headers['x-sample-hmac'] || '';\nif (given !== expected) throw new Error('Webhook signature mismatch, request dropped');\nconst o = item.json.body || JSON.parse(raw);\n// 2) Normalise\nconst map = JSON.parse(cfg.sku_map);\nconst li = (o.line_items || [])[0] || {};\nconst order = {\n  order_id: 'SH-' + (o.order_number || o.id), channel: o.channel || 'Shopify',\n  customer: [o.customer?.first_name, o.customer?.last_name].filter(Boolean).join(' ') || o.customer?.name || 'Unknown',\n  email: (o.email || o.customer?.email || '').toLowerCase(), phone: o.phone || o.customer?.phone || '',\n  product: li.title, sku: li.sku || map[li.title] || 'UNMAPPED', qty: Number(li.quantity || 1), amount: Number(o.total_price || 0),\n  ship_to: o.shipping_address || {}, base: cfg.base, received_at: new Date().toISOString()\n};\nif (!order.email) throw new Error('Order without customer email');\n// 3) Idempotency: same order id twice = second delivery ignored\nconst seen = $getWorkflowStaticData('global'); seen.orders = seen.orders || {};\norder.duplicate = !!seen.orders[order.order_id]; seen.orders[order.order_id] = Date.now();\nreturn [{ json: order }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "First delivery?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.duplicate }}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Supplier API: stock check",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.base }}/supplier/stock"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ sku: record.sku, qty: record.qty }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "In stock?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.ok }}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Supplier API: place PO",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/supplier/orders"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ order_id: steps[\"step-3\"].records[0].order_id, sku: steps[\"step-3\"].records[0].sku, qty: steps[\"step-3\"].records[0].qty, ship_to: steps[\"step-3\"].records[0].ship_to }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Shipping API: create label + tracking",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/shipping/label"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ order_id: steps[\"step-3\"].records[0].order_id, po_number: record.po_number }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Customer: shipping email",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: 'email', to: steps[\"step-3\"].records[0].email, body: 'Hi ' + steps[\"step-3\"].records[0].customer.split(' ')[0] + ', your ' + steps[\"step-3\"].records[0].product + ' is on its way. ' + record.carrier + ' tracking: ' + record.tracking }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "CRM: upsert customer + order",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/crm/contacts/upsert"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ email: steps[\"step-3\"].records[0].email, name: steps[\"step-3\"].records[0].customer, last_order: steps[\"step-3\"].records[0].order_id, ltv_add: steps[\"step-3\"].records[0].amount, status: 'shipped', tracking: steps[\"step-8\"].records[0].tracking }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "ERP: inventory sync",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/erp/inventory/upsert"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ sku: steps[\"step-3\"].records[0].sku, qty: steps[\"step-5\"].records[0].available - steps[\"step-3\"].records[0].qty }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-12",
      "label": "CRM: tag BACKORDER",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/crm/contacts/upsert"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ email: steps[\"step-3\"].records[0].email, name: steps[\"step-3\"].records[0].customer, last_order: steps[\"step-3\"].records[0].order_id, status: 'backorder', eta_days: record.lead_days }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-13",
      "label": "Customer: backorder email",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/messages/send"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: 'email', to: steps[\"step-3\"].records[0].email, body: 'Hi ' + steps[\"step-3\"].records[0].customer.split(' ')[0] + ', your ' + steps[\"step-3\"].records[0].product + ' is on backorder; current lead time ' + steps[\"step-5\"].records[0].lead_days + ' days. Reply if you would like to change or cancel.' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-14",
      "label": "Ops alert (Slack)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-3\"].records[0].base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#ops-backorders', text: 'BACKORDER ' + steps[\"step-3\"].records[0].order_id + ' ' + steps[\"step-3\"].records[0].sku + ' x' + steps[\"step-3\"].records[0].qty + ', supplier lead ' + steps[\"step-5\"].records[0].lead_days + 'd' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-15",
      "label": "Respond to webhook",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const o = steps[\"step-3\"].records[0];\nconst stock = steps[\"step-5\"].records[0];\nlet tracking = null; try { tracking = steps[\"step-8\"].records[0].tracking; } catch (e) {}\nreturn [{ json: { ok: true, order_id: o.order_id, sku: o.sku, route: stock.ok ? 'fulfilled' : 'backorder', tracking, lead_days: stock.lead_days } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-16",
      "label": "Skip duplicate delivery",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "return [{ json: { ok: true, skipped: 'duplicate webhook delivery', order_id: record.order_id } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-17",
      "label": "Every 6 h: ERP to CRM inventory sync",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      }
    },
    {
      "id": "step-18",
      "label": "ERP: read inventory",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "GET",
        "url": {
          "expression": "{{ steps[\"step-23\"].records[0].base }}/erp/inventory"
        },
        "options": {}
      }
    },
    {
      "id": "step-19",
      "label": "Low-stock rule (≤5)",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const items = records[0].json.items || [];\nconst low = items.filter(i => i.qty <= 5);\nreturn [{ json: { checked: items.length, low_stock: low, text: low.length ? 'Low stock: ' + low.map(i => i.sku + '=' + i.qty).join(', ') : 'All SKUs above threshold' } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-20",
      "label": "Post inventory digest",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-23\"].records[0].base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#ops-inventory', text: record.text }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-21",
      "label": "Error trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-22",
      "label": "Alert ops",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-24\"].records[0].base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#ops-alerts', text: 'Order integration failed: ' + (record.execution?.error?.message || 'unknown') }) }}"
        },
        "options": {}
      }
    },
