              "value": {
                "expression": "{{ \n{\n \"renditionsToExtract\": [\n \"tables\"\n ],\n \"elementsToExtract\": [\n \"text\",\n \"tables\"\n ]\n }\n}}"
              }
            }
          ]
        }
      }
    },
