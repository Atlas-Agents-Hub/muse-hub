{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-latchshot-capture-a-public-webpage-90cc09",
  "title": "Latchshot — capture a public webpage",
  "nodes": [
    {
      "id": "step-1",
      "label": "Run workflow",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Set capture input",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "url",
              "value": {
                "configuration_input": "step-2-assignments-0-value"
              },
              "type": "string"
            },
            {
              "name": "width",
              "value": 1440,
              "type": "number"
            },
            {
              "name": "height",
              "value": 900,
              "type": "number"
            },
            {
              "name": "fullPage",
              "value": false,
              "type": "boolean"
            },
            {
              "name": "delayMs",
              "value": 250,
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Capture public page",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ { url: record.url, kind: 'screenshot', format: 'png', width: record.width, height: record.height, fullPage: record.fullPage, delayMs: record.delayMs } }}"
        },
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "capture"
            }
          }
        }
      }
    }
  ],
