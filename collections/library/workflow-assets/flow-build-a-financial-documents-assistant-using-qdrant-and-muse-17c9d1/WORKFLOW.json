{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-build-a-financial-documents-assistant-using-qdrant-and-muse-17c9d1",
  "title": "Build a Financial Documents Assistant using Qdrant and Mistral.ai",
  "nodes": [
    {
      "id": "step-1",
      "label": "Local File Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "path": "/home/node/host_mount/local_file_search",
        "events": [
          "add",
          "change",
          "unlink"
        ],
        "options": {
          "awaitWriteFinish": true
        },
        "triggerOn": "folder"
      }
    },
    {
      "id": "step-2",
      "label": "When clicking \"Test workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-3",
      "label": "Set Variables",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "directory",
              "type": "string",
              "value": "/home/node/BankStatements"
            },
            {
              "name": "file_added",
              "type": "string",
              "value": {
                "expression": "{{ record.event === 'add' && record.path || ''}}"
              }
            },
            {
              "name": "file_changed",
              "type": "string",
              "value": {
                "expression": "{{ record.event === 'change' && record.path || '' }}"
              }
            },
            {
              "name": "file_deleted",
              "type": "string",
              "value": {
                "expression": "{{ record.event === 'unlink' && record.path || '' }}"
              }
            },
            {
              "name": "qdrant_collection",
              "type": "string",
              "value": "local_file_search"
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Read File",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fileSelector": {
          "expression": "{{ record.file_added }}"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Embeddings Mistral Cloud",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "filter_by_filename",
                "value": {
                  "expression": "{{ record.file_location }}"
                }
              },
              {
                "name": "filter_by_created_month",
                "value": {
                  "expression": "{{ current_time.year + '-' + current_time.monthShort }}"
                }
              },
              {
                "name": "filter_by_created_week",
                "value": {
                  "expression": "{{ current_time.year + '-' + current_time.monthShort + '-W' + current_time.weekNumber }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ record.data }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-7",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Prepare Embedding Document",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "data",
              "type": "string",
              "value": {
                "expression": "## file location\n{{ [record.directory, record.fileName].join('/') }}\n## file created\n{{ current_time.toISO() }}\n## file contents\n{{ record.binary.data.data.base64Decode() }}"
              }
            },
            {
              "name": "file_location",
              "type": "string",
              "value": {
                "expression": "{{ [record.directory, record.fileName].join('/') }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Chat Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-10",
      "label": "Question and Answer Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {}
    },
    {
      "id": "step-11",
      "label": "Mistral Cloud Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-12",
      "label": "Vector Store Retriever",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {}
    },
    {
      "id": "step-13",
      "label": "Embeddings Mistral Cloud1",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-14",
      "label": "Remap for File_Added Flow",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "file_added",
              "type": "string",
              "value": {
                "expression": "{{ steps[\"step-3\"].record.file_changed }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-15",
      "label": "Search For Existing Point",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "http://qdrant:6333/collections/{{ steps[\"step-3\"].record.qdrant_collection }}/points/scroll"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"filter\": {\n \"must\": [\n {\n \"key\": \"metadata.filter_by_filename\",\n \"match\": {\n \"value\": \"{{ record.file_changed }}\"\n }\n }\n ]\n },\n \"limit\": 1,\n \"with_payload\": false,\n \"with_vector\": false\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-16",
      "label": "Has Existing Point?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "array",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.result.points }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-17",
      "label": "Delete Existing Point",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "http://qdrant:6333/collections/{{ steps[\"step-3\"].record.qdrant_collection }}/points/delete"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "points",
              "value": {
                "expression": "{{ record.result.points.map(point => point.id) }}"
              }
            }
          ]
        }
      }
    },
