{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-classify-lemlist-replies-using-muse-and-automate-reply-handling-b5c982",
  "title": "Classify lemlist replies using Muse and automate reply handling",
  "nodes": [
    {
      "id": "step-1",
      "label": "Format text with Markdown",
      "operation": "file",
      "adapter": "local",
      "parameters": {
        "html": {
          "expression": "{{ record.text }}"
        },
        "options": {},
        "destinationKey": "textClean"
      }
    },
    {
      "id": "step-2",
      "label": "Lemlist Trigger - On new reply",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "emailsReplied",
        "options": {
          "isFirst": true
        }
      }
    },
    {
      "id": "step-3",
      "label": "Model Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-4",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "schemaType": "manual",
        "inputSchema": {
          "json": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "id": "step-5",
      "label": "Send alert to Slack",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": ""
        },
        "select": "channel",
        "blocksUi": {
          "expression": "{\n\t\"blocks\": [\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"text\": {\n\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\"text\": \":raised_hands: New reply in lemlist!\\n\"\n\t\t\t}\n\t\t},\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"fields\": [\n\t\t\t\t{\n\t\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\t\"text\": \"*Categorized as:*\\n{{ record[\"output\"][\"category\"] }}\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\t\"text\": \"*Campaign:*\\n<https://app.lemlist.com/teams/{{ record[\"teamId\"] }}/reports/campaigns/{{ record[\"campaignId\"] }}|{{ record[\"campaignName\"] }}>\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\t\"text\": \"*Sender Email:*\\n{{ record[\"sendUserEmail\"] }}\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\t\"text\": \"*Lead Email:*\\n{{ record[\"leadEmail\"] }}\"\n\t\t\t\t},\n\t\t\t\t{\n\t\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\t\"text\": \"*Linkedin URL:*\\n{{ record[\"linkedinUrl\"] }}\"\n\t\t\t\t}\n\t\t\t]\n\t\t},\n\t\t{\n\t\t\t\"type\": \"section\",\n\t\t\t\"text\": {\n\t\t\t\t\"type\": \"mrkdwn\",\n\t\t\t\t\"text\": \"*Reply preview*:\\n{{ JSON.stringify(record[\"textClean\"]).replace(/^\"(.+(?=\"$))\"$/, '$1').substring(0, 100) }}\"\n\t\t\t}\n\t\t}\n\t]\n}"
        },
        "channelId": {
          "configuration_input": "step-5-channelid"
        },
        "messageType": "block",
        "otherOptions": {
          "botProfile": {
            "imageValues": {
              "icon_emoji": ":fire:",
              "profilePhotoType": "emoji"
            }
          },
          "unfurl_links": false,
          "includeLinkToWorkflow": false
        }
      }
    },
    {
      "id": "step-6",
      "label": "Lemlist - Unsubscribe",
      "operation": "service-read",
      "adapter": "lemlist",
      "parameters": {
        "email": {
          "expression": "{{ record[\"leadEmail\"] }}"
        },
        "resource": "lead",
        "operation": "unsubscribe",
        "campaignId": {
          "expression": "{{record[\"campaignId\"]}}"
        }
      }
    },
    {
      "id": "step-7",
      "label": "lemlist - Mark as interested",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.lemlist.com/api/campaigns/{{record[\"campaignId\"]}}/leads/{{record[\"leadEmail\"]}}/interested"
        },
        "options": {},
        "requestMethod": "POST"
      }
    },
    {
      "id": "step-8",
      "label": "Categorize lemlist reply",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Classify the [email_content] in one only of the following categories: \n\nCategories=[\"Interested\", \"Out of office\", \"Unsubscribe\", \"Not interested\", \"Other\"] \n\n- Interested is when the reply is positive, and the person want more information or a meeting \n\nDon't output quotes like in the next example: \nemail_content_example:Hey I would like to know more \ncategory:Interested\n\nemail_content:\"{{ record.textClean }}\" \n\nOnly answer with JSON in the following format:\n{\"replyStatus\":category}\n\nJSON:"
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    },
    {
      "id": "step-9",
      "label": "Merge data",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-10",
      "label": "Route reply to the right branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "Send all replies to Slack",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "exists",
                      "singleValue": true
                    },
                    "leftValue": {
                      "expression": "{{ record.output.category }}"
                    },
                    "rightValue": ""
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Unsubscribe",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "name": "filter.operator.equals",
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ record.output.category }}"
                    },
                    "rightValue": "Unsubscribe"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "Interested",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "name": "filter.operator.equals",
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ record.output.category }}"
                    },
                    "rightValue": "Interested"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {
          "allMatchingOutputs": true
        }
      }
    }
  ],
