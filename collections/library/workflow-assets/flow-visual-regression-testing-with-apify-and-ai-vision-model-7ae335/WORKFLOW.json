{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-visual-regression-testing-with-apify-and-ai-vision-model-7ae335",
  "title": "Visual Regression Testing with Apify and AI Vision Model",
  "nodes": [
    {
      "id": "step-1",
      "label": "Base Image",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "expression": "{{ record.base }}"
        },
        "options": {
          "binaryPropertyName": "data_1"
        },
        "operation": "download"
      }
    },
    {
      "id": "step-2",
      "label": "Google Gemini Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Structured Output Parser",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "schemaType": "manual",
        "inputSchema": {
          "json": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "type of regression. One of text, number, image, color or position."
                },
                "description": {
                  "type": "string"
                },
                "previous_state": {
                  "type": "string"
                },
                "current_state": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "step-4",
      "label": "Loop Over Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Wait",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 2
      }
    },
    {
      "id": "step-6",
      "label": "Download Screenshot",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.screenshotUrl }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Upload to Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "name": {
          "expression": "{{ steps[\"step-9\"].record.url.urlEncode() }}"
        },
        "driveId": {
          "configuration_input": "step-7-driveid"
        },
        "options": {
          "simplifyOutput": true
        },
        "folderId": {
          "configuration_input": "step-7-folderid"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Update Base Image",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "url": {
              "expression": "{{ steps[\"step-9\"].record.url }}"
            },
            "base": {
              "expression": "{{ record.id }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "service",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "url",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "base",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "url"
          ]
        },
        "options": {},
        "operation": "appendOrUpdate",
        "sheetName": {
          "configuration_input": "step-8-sheetname"
        },
        "documentId": {
          "configuration_input": "step-8-documentid"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "step-10",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 6
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Get URLs with Missing Base Images",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "sheetName": {
          "configuration_input": "step-11-sheetname"
        },
        "documentId": {
          "configuration_input": "step-11-documentid"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Run Webpage Screenshot",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-12-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"delay\": 0,\n \"format\": \"png\",\n \"proxy\": {\n \"useApifyProxy\": true\n },\n \"scrollToBottom\": false,\n \"urls\": [\n {\n \"url\": record.url\n }\n ],\n \"viewportWidth\": 1280,\n \"waitUntil\": \"domcontentloaded\",\n \"waitUntilNetworkIdleAfterScroll\": false\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-13",
      "label": "Run Webpage Screenshot1",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-13-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{{\n{\n \"delay\": 0,\n \"format\": \"png\",\n \"proxy\": {\n \"useApifyProxy\": true\n },\n \"scrollToBottom\": false,\n \"urls\": [\n {\n \"url\": record.url\n }\n ],\n \"viewportWidth\": 1280,\n \"waitUntil\": \"domcontentloaded\",\n \"waitUntilNetworkIdleAfterScroll\": false\n}\n}}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-14",
      "label": "Has Changes",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "array",
                "operation": "lengthGt",
                "rightType": "number"
              },
              "leftValue": {
                "expression": "{{ record.output }}"
              },
              "rightValue": 0
            }
          ]
        }
      }
    },
    {
      "id": "step-15",
      "label": "Combine Row and Result",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "mode": "raw",
        "options": {},
        "jsonOutput": {
          "expression": "{{\n{\n ...steps[\"step-20\"].record,\n output: record.output\n}\n}}"
        }
      }
    },
    {
      "id": "step-16",
      "label": "Wait1",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 1
      }
    },
    {
      "id": "step-17",
      "label": "Aggregate",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "aggregate": "aggregateAllItemData"
      }
    },
    {
      "id": "step-18",
      "label": "Create Report",
      "operation": "service-read",
      "adapter": "linear",
      "parameters": {
        "title": {
          "expression": "Visual Regression Report {{ current_time.format('yyyy-MM-dd') }}"
        },
        "teamId": {
          "configuration_input": "step-18-teamid"
        },
        "additionalFields": {
          "description": {
            "expression": "Visual Regression Workflow picked up the following changes:\n\n{{\nrecord.data.map(row =>\n`### ${row.url}\n${row.output.map(issue =>\n`* **${issue.description}** - expected \"${issue.previous_state}\" but got \"${issue.current_state}\"`\n).join('\\n')}`\n).join('\\n');\n}}"
          }
        }
      }
    },
    {
      "id": "step-19",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-20",
      "label": "Get Webpages List",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "filtersUI": {
          "values": [
            {
              "lookupValue": "2",
              "lookupColumn": {
                "expression": "row_number"
              }
            }
          ]
        },
        "sheetName": {
          "configuration_input": "step-20-sheetname"
        },
        "documentId": {
          "configuration_input": "step-20-documentid"
        }
      }
    },
    {
      "id": "step-21",
      "label": "For Each Webpage...",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-22",
      "label": "Download New Screenshot",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.screenshotUrl }}"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data_2"
            }
          }
        }
      }
    },
    {
      "id": "step-23",
      "label": "Combine Screenshots",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combineBy": "combineByPosition"
      }
    },
    {
      "id": "step-24",
      "label": "Visual Regression Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Identify changes between the base image and test image.",
        "messages": {
          "messageValues": [
            {
              "message": {
                "expression": "You help with visual regression testing for websites. Identify changes to text content, images, colors, position and layouts of the elements in the screenshots. Ignore text styling or casing changes.\nThe first image will be the base image and the second image will be the test. Note all changes to the test image which differ from the base. If there are no changes, it is okay to return an empty array."
              }
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "data_1"
            },
            {
              "type": "HumanMessagePromptTemplate",
              "messageType": "imageBinary",
              "binaryImageDataKey": "data_2"
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      }
    }
  ],
