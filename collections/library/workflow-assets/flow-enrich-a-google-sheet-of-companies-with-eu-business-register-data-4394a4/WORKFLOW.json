{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-enrich-a-google-sheet-of-companies-with-eu-business-register-data-4394a4",
  "title": "Enrich a Google Sheet of companies with EU business register data",
  "nodes": [
    {
      "id": "step-1",
      "label": "Run it",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Read the sheet",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "documentId": {
          "configuration_input": "step-2-documentid"
        },
        "sheetName": {
          "configuration_input": "step-2-sheetname"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Look up the official register",
      "operation": "service-read",
      "adapter": "apify",
      "parameters": {
        "resource": "Actors",
        "operation": "Run actor and get dataset",
        "actorSource": "store",
        "actorId": "gubidonius~company-registry-lookup",
        "customBody": {
          "expression": "{{ JSON.stringify({ queries: [record.company], countries: ['cz','ee','fi','fr','no','pl','sk'], maxResultsPerQuery: 1, onlyActive: true }) }}"
        },
        "timeout": 600,
        "memory": 1024,
        "build": ""
      }
    },
    {
      "id": "step-4",
      "label": "Keep the columns worth writing back",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "company",
              "value": {
                "expression": "{{ record.name }}"
              },
              "type": "string"
            },
            {
              "name": "registrationNumber",
              "value": {
                "expression": "{{ record.registrationNumber }}"
              },
              "type": "string"
            },
            {
              "name": "vatNumber",
              "value": {
                "expression": "{{ record.vatNumber }}"
              },
              "type": "string"
            },
            {
              "name": "country",
              "value": {
                "expression": "{{ record.countryName }}"
              },
              "type": "string"
            },
            {
              "name": "registry",
              "value": {
                "expression": "{{ record.registry }}"
              },
              "type": "string"
            },
            {
              "name": "status",
              "value": {
                "expression": "{{ record.status }}"
              },
              "type": "string"
            },
            {
              "name": "incorporatedAt",
              "value": {
                "expression": "{{ record.incorporatedAt }}"
              },
              "type": "string"
            },
            {
              "name": "address",
              "value": {
                "expression": "{{ record.address }}"
              },
              "type": "string"
            },
            {
              "name": "city",
              "value": {
                "expression": "{{ record.city }}"
              },
              "type": "string"
            },
            {
              "name": "website",
              "value": {
                "expression": "{{ record.website }}"
              },
              "type": "string"
            },
            {
              "name": "registryUrl",
              "value": {
                "expression": "{{ record.registryUrl }}"
              },
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Write it back to the sheet",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "configuration_input": "step-5-documentid"
        },
        "sheetName": {
          "configuration_input": "step-5-sheetname"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "matchingColumns": [
            "company"
          ],
          "value": {}
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
