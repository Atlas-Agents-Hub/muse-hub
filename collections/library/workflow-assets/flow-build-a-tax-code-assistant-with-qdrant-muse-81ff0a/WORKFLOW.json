{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-build-a-tax-code-assistant-with-qdrant-muse-81ff0a",
  "title": "Build a Tax Code Assistant with Qdrant, Mistral.ai and OpenAI",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Embeddings Mistral Cloud",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-3",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "chapter",
                "value": {
                  "expression": "{{ steps[\"step-15\"].record.chapter }}"
                }
              },
              {
                "name": "section",
                "value": {
                  "expression": "{{ steps[\"step-15\"].record.label }}"
                }
              },
              {
                "name": {
                  "expression": "title"
                },
                "value": {
                  "expression": "{{ steps[\"step-15\"].record.title }}"
                }
              },
              {
                "name": "content_order",
                "value": {
                  "expression": "{{ record_index }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ record.content }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-4",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {},
        "chunkSize": 2000
      }
    },
    {
      "id": "step-5",
      "label": "Get Tax Code Zip File",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      }
    },
    {
      "id": "step-6",
      "label": "Extract Zip Files",
      "operation": "file",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-7",
      "label": "Files as Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "include": "allOtherFields",
        "options": {},
        "fieldToSplitOut": "$binary"
      }
    },
    {
      "id": "step-8",
      "label": "Extract PDF Contents",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "pdf",
        "binaryPropertyName": {
          "expression": "file_{{ record_index }}"
        }
      }
    },
    {
      "id": "step-9",
      "label": "Extract From Chapter",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "contents",
              "type": "array",
              "value": {
                "expression": "{{\n record.text\n .substring(record.text.search(/\\nSec\\.\\nA[0-9]{1,4}\\.[0-9]{1,5}\\.AA/), record.text.length)\n .split(/\\nSec\\.\\nA[0-9]{1,2}\\.[0-9]{1,2}\\.AA/g)\n .filter(text => !text.isEmpty())\n .map(text => {\n const output = text.replaceAll('AA', ' ').replaceAll('\\nA', ' ');\n const title = output.substring(0, output.indexOf('.'));\n const content = output.substring(output.indexOf('.')+1, output.length).replaceAll('\\n', ' ').trim();\n return { title, content };\n })\n}}"
              }
            },
            {
              "name": "labels",
              "type": "array",
              "value": {
                "expression": "{{\n record.text\n .match(/\\nSec\\.\\nA[0-9]{1,4}\\.[0-9]{1,5}\\.AA/g)\n .map(text => ({\n label: text.replaceAll('AA', ' ')\n .replaceAll('\\nA', ' ')\n .replaceAll('\\n', '')\n .trim()\n }))\n}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Map To Sections",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "section",
              "type": "array",
              "value": {
                "expression": "{{\n record.labels.map((label, idx) => ({\n label: label.label.match(/\\d.+/)[0].replace(/\\.$/, ''),\n title: record.contents[idx].title,\n content: record.contents[idx].content,\n chapter: steps[\"step-8\"].records[0].info.Title,\n }))\n}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-12",
      "label": "Get Mistral Embeddings",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-12-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "mistral-embed"
            },
            {
              "name": "encoding_format",
              "value": "float"
            },
            {
              "name": "input",
              "value": {
                "expression": "{{ record.query }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-13",
      "label": "Content Chunking @ 50k Chars",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": {
                "expression": "content"
              },
              "type": "array",
              "value": {
                "expression": "{{ new Array(Math.round(record.content.length / Math.min(record.content.length, 30000))).fill('').map((_,idx) => record.content.substring(idx * 30000, idx * 50000 + 30000)) }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-14",
      "label": "Split Out Chunks",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "content"
      }
    },
    {
      "id": "step-15",
      "label": "For Each Section...",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "batchSize": 5
      }
    },
    {
      "id": "step-16",
      "label": "Sections To List",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "section"
      }
    },
    {
      "id": "step-17",
      "label": "Only Valid Sections",
      "operation": "filter",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "or",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.content }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-18",
      "label": "Use Qdrant Search API1",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "http://qdrant:6333/collections/texas_tax_codes/points/search"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": {
                "expression": "{{ 4 }}"
              }
            },
            {
              "name": "vector",
              "value": {
                "expression": "{{ record.data[0].embedding }}"
              }
            },
            {
              "name": "with_payload",
              "value": {
                "expression": "{{ true }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-19",
      "label": "Use Qdrant Scroll API",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "http://qdrant:6333/collections/texas_tax_codes/points/scroll"
        },
        "method": "POST",
        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "name": "next_page_offset",
                    "type": "body",
                    "value": {
                      "expression": "{{ $response.body.result.next_page_offset }}"
                    }
                  }
                ]
              },
              "completeExpression": {
                "expression": "{{ $response.body.result.next_page_offset === null }}"
              },
              "paginationCompleteWhen": "other"
            }
          }
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": {
                "expression": "{{ 100 }}"
              }
            },
            {
              "name": "with_payload",
              "value": {
                "expression": "{{ true }}"
              }
            },
            {
              "name": "filter",
              "value": {
                "expression": "{{\n{\n \"must\": [\n (record.query.section\n ? { \"key\": \"metadata.section\", \"match\": { \"value\": record.query.section } }\n : { \"key\": \"metadata.chapter\", \"match\": { \"value\": record.query.chapter } }\n )\n ]\n}\n}}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-20",
      "label": "Get Search Response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "string",
              "value": {
                "expression": "---\nchapter: {{ record.result.points.first().payload.metadata.chapter }}\nsection: {{ record.result.points.first().payload.metadata.section }}\ntitle: {{ record.result.points.first().payload.metadata.title }}\n---\n{{ record.result.points\n .toSorted((a,b) => (a.payload.metadata.content_order || 0) - (b.payload.metadata.content_order || 0))\n .map(point => point.payload.content).join('\\n') }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-21",
      "label": "Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "qdrantCollection": {
          "configuration_input": "step-21-qdrantcollection"
        }
      }
    },
    {
      "id": "step-22",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemMessage": "You are a helpful assistant answering user questions on the tax code legistration for the state of Texas, united states of america.\n\nAlong with your response also note in which chapter and section number the information was found. "
        }
      }
    },
    {
      "id": "step-23",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-24",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "public": true,
        "options": {
          "loadPreviousSession": "memory"
        },
        "initialMessages": ""
      }
    },
    {
      "id": "step-25",
      "label": "Window Buffer Memory1",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-26",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-27",
      "label": "1sec",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 1
      }
    },
    {
      "id": "step-28",
      "label": "Ask Tool",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": {
          "configuration_input": "step-28-name"
        },
        "fields": {
          "values": [
            {
              "name": "route",
              "stringValue": "ask_tool"
            }
          ]
        },
        "workflowId": {
          "expression": "{{ workflow_id }}"
        },
        "description": "Call this tool to query the tax code database for information. Structure your query in the form of a question for best results."
      }
    },
    {
      "id": "step-29",
      "label": "Search Tool",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "get_tax_code_section",
        "fields": {
          "values": [
            {
              "name": "route",
              "stringValue": "search_tool"
            }
          ]
        },
        "workflowId": {
          "expression": "{{ workflow_id }}"
        },
        "description": "Call this tool to search for specific sections of the tax code document. Pass in either a known section number/id to get the section's text or a known chapter name to return all sections for the chapter.",
        "jsonSchemaExample": {
          "json": {
            "chapter": "some_value",
            "section": "Sec 1.01"
          }
        },
        "specifyInputSchema": true
      }
    },
    {
      "id": "step-30",
      "label": "Switch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "ask_tool",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ record.route }}"
                    },
                    "rightValue": "ask_tool"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "search_tool",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "name": "filter.operator.equals",
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": {
                      "expression": "{{ record.route }}"
                    },
                    "rightValue": "search_tool"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-31",
      "label": "Get Ask Response",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "response",
              "type": "string",
              "value": {
                "expression": "|chapter|section|title|content|\n|-|-|-|-|\n{{\n record.result.map(row => [\n '',\n row.payload.metadata.chapter,\n row.payload.metadata.section,\n row.payload.metadata.title,\n row.payload.content,\n ''\n ].join('|')).join('\\n')\n}}"
              }
            }
          ]
        }
      }
    }
