            },
            {
              "name": "qdrantCloudURL",
              "type": "string",
              "value": {
                "expression": "https://152bc6e2-832a-415c-a1aa-fb529f8baf8d.eu-central-1-0.aws.cloud.qdrant.io"
              }
            },
            {
              "name": "collectionName",
              "type": "string",
              "value": {
                "expression": "land-use"
              }
            },
            {
              "name": "limitKNN",
