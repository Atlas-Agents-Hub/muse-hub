  "nodes": [
    {
      "id": "step-1",
      "label": "Code",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of records) {\n item.json.myNewField = 1;\n}\n\nreturn records;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-2",
      "label": "ApplicantData",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "body",
              "type": "object",
              "value": {
                "expression": "{{ record.body }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "ERPNext - Reject if Resume not Attached",
      "operation": "service-write",
