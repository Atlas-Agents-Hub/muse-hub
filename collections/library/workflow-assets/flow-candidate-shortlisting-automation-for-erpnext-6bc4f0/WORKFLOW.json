        "documentName": {
          "expression": "{{ steps[\"step-2\"].record.body.name }}"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Applied Against Job",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {
          "ignoreCase": true
        },
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": false,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.body.Job_opening }}"
              },
              "rightValue": "None"
            }
          ]
        }
      }
    },
    {
      "id": "step-5",
      "label": "ERPNext - Hold Applicant",
      "operation": "service-write",
      "adapter": "erpnext",
      "parameters": {
        "docType": "Job%20Applicant",
        "operation": "update",
        "properties": {
          "customProperty": [
            {
              "field": "status",
              "value": "Hold"
            }
