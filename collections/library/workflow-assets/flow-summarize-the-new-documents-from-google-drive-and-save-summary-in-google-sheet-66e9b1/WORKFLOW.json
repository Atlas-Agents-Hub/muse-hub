{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-summarize-the-new-documents-from-google-drive-and-save-summary-in-google-sheet-66e9b1",
  "title": "Summarize the New Documents from Google Drive and Save Summary in Google Sheet",
  "nodes": [
    {
      "id": "step-1",
      "label": "Google Docs",
      "operation": "service-read",
      "adapter": "googledocs",
      "parameters": {
        "operation": "get",
        "documentURL": {
          "expression": "{{ record.id }}"
        }
      }
    },
    {
      "id": "step-2",
      "label": "Wikipedia",
      "operation": "service-read",
      "adapter": "toolwikipedia",
      "parameters": {}
    },
    {
      "id": "step-3",
      "label": "Calculator",
      "operation": "transform",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Google Sheets",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "Name": {
              "expression": "{{ steps[\"step-5\"].record.lastModifyingUser.displayName }}"
            },
            "Email ": {
              "expression": "{{ steps[\"step-5\"].record.lastModifyingUser.emailAddress }}"
            },
            "Summarise Conetent data ": {
              "expression": "{{ record.message.content }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "Email ",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "Name",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "Summarise Conetent data ",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": []
        },
        "options": {},
        "operation": "append",
        "sheetName": {
          "configuration_input": "step-4-sheetname"
        },
        "documentId": {
          "configuration_input": "step-4-documentid"
        }
      }
    },
    {
      "id": "step-5",
      "label": "Google Drive",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "fileCreated",
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "configuration_input": "step-5-foldertowatch"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Generate Summary AI",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-6-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "content": {
                "expression": "Summarise the below content\n {{ record.content }}"
              }
            }
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-2",
      "to": "step-6",
