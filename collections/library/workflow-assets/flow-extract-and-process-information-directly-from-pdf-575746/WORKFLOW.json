{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-extract-and-process-information-directly-from-pdf-575746",
  "title": "Extract and process information directly from PDF",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking 'Test workflow'",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Extract from File",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "binaryToPropery"
      }
    },
    {
      "id": "step-3",
      "label": "Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "configuration_input": "step-3-fileid"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-4",
      "label": "Call Model 2.0 Flash with PDF Capabilities",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-4-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"contents\": [\n {\n \"parts\": [\n {\n \"inline_data\": {\n \"mime_type\": \"application/pdf\",\n \"data\": \"{{ record.data }}\"\n }\n },\n {\n \"text\": \"{{ steps[\"step-6\"].record.prompt }}\"\n }\n ]\n }\n ]\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-5",
      "label": "Call Model 3.5 Sonnet with PDF Capabilities",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"model\": \"claude-3-5-sonnet-20241022\",\n \"max_tokens\": 1024,\n \"messages\": [{\n \"role\": \"user\",\n \"content\": [{\n \"type\": \"document\",\n \"source\": {\n \"type\": \"base64\",\n \"media_type\": \"application/pdf\",\n \"data\": \"{{record.data}}\"\n }\n },\n {\n \"type\": \"text\",\n \"text\": \"{{ steps[\"step-6\"].record.prompt }}\"\n }]\n }]\n}"
        },
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": {
                "configuration_input": "step-5-parameters-0-value"
              }
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Define Prompt",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "prompt",
              "type": "string",
              "value": "Extract the VAT numbers for each country"
            }
          ]
        }
      }
    }
  ],
