    {
      "id": "step-17",
      "label": "Calculate Options",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "// Get the input data from the previous node\nconst inputData = record[\"number_of_options\"]; // Fetch the \"number_of_options\" field\n\n// Convert the input to an integer\nconst initialValue = parseInt(inputData, 10);\n\n// Add 1 to retain the initial value and calculate the new value\nconst numberOfOptions = initialValue + 1;\nconst result = numberOfOptions - 1;\n\n// Return both values\nreturn {\n number_of_options: numberOfOptions,\n result,\n};",
          "inputs": "records, record, and named steps"
        }
      }
