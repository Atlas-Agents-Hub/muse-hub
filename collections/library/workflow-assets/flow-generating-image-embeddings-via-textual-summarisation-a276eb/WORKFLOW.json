{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-generating-image-embeddings-via-textual-summarisation-a276eb",
  "title": "Generating Image Embeddings via Textual Summarisation",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking \"Test workflow\"",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Google Drive",
      "operation": "service-read",
      "adapter": "googledrive",
      "parameters": {
        "fileId": {
          "configuration_input": "step-2-fileid"
        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-3",
      "label": "Get Color Information",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "operation": "information"
      }
    },
    {
      "id": "step-4",
      "label": "Resize Image",
      "operation": "image",
      "adapter": "local",
      "parameters": {
        "width": 512,
        "height": 512,
        "options": {},
        "operation": "resize",
        "resizeOption": "onlyIfLarger"
      }
    },
    {
      "id": "step-5",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "source",
                "value": {
                  "expression": "{{ steps[\"step-8\"].record.metadata.source }}"
                }
              },
              {
                "name": "format",
                "value": {
                  "expression": "{{ steps[\"step-8\"].record.metadata.format }}"
                }
              },
              {
                "name": "backgroundColor",
                "value": {
                  "expression": "{{ steps[\"step-8\"].record.metadata.backgroundColor }}"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "step-6",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Combine Image Analysis",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-8",
      "label": "Document for Embedding",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "data",
              "type": "string",
              "value": {
                "expression": "## keywords\\n\n{{ record.content }}\\n\n## color information:\\n\n{{ JSON.stringify(record[\"Channel Statistics\"]) }}"
              }
            },
            {
              "name": "metadata",
              "type": "object",
              "value": {
                "expression": "{ \"format\": \"{{ record.format }}\", \"backgroundColor\": \"{{ record[\"Background Color\"] }}\", \"source\": \"{{ $binary.data.fileName }}\" }"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Embeddings OpenAI1",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-10",
      "label": "Get Image Keywords",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Extract all possible semantic keywords which describe the image. Be comprehensive and be sure to identify subjects (if applicable) such as biological and non-biological objects, lightning, mood, tone, color, special effects, camera and/or techniques used if known. Respond with a comma-separated list.",
        "options": {
          "detail": "high"
        },
        "resource": "image",
        "inputType": "base64",
        "operation": "analyze"
      }
    },
    {
      "id": "step-11",
      "label": "In-Memory Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "memoryKey": "image_embeddings"
      }
    },
    {
      "id": "step-12",
      "label": "Embeddings OpenAI",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-13",
      "label": "Search for Image",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "load",
        "prompt": "student having fun",
        "memoryKey": "image_embeddings"
      }
    }
  ],
