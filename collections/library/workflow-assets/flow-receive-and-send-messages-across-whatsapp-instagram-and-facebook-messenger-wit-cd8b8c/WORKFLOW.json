{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-receive-and-send-messages-across-whatsapp-instagram-and-facebook-messenger-wit-cd8b8c",
  "title": "Receive and Send Messages Across WhatsApp, Instagram and Facebook Messenger with Fiwano",
  "nodes": [
    {
      "id": "step-1",
      "label": "Fiwano Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "autoSetup": "all"
      }
    },
    {
      "id": "step-2",
      "label": "Example — route by message type",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.data.type }}"
              },
              "rightValue": "text",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Example — send text reply",
      "operation": "service-read",
      "adapter": "fiwano",
      "parameters": {
        "channelId": {
          "expression": "{{ record.channel_id }}"
        },
        "recipient": {
          "expression": "{{ record.data.from }}"
        },
        "text": {
          "expression": "You said: \"{{ record.data.text }}\" 👋"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Example — send attachment reply",
      "operation": "service-read",
      "adapter": "fiwano",
      "parameters": {
        "channelId": {
          "expression": "{{ record.channel_id }}"
        },
        "recipient": {
          "expression": "{{ record.data.from }}"
        },
        "text": {
          "expression": "Got your {{ record.data.type }} 📎 — {{ (record.data.media || {}).mime_type || 'attachment' }}. Thanks!"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-2",
      "to": "step-4",
      "channel": "main",
      "branch": 1,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
