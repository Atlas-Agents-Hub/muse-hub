        },
        "options": {},
        "operation": "download"
      }
    },
    {
      "id": "step-9",
      "label": "Binary to Document",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "loader": "pdfLoader",
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
