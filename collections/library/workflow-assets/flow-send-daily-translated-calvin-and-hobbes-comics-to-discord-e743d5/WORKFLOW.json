{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-send-daily-translated-calvin-and-hobbes-comics-to-discord-e743d5",
  "title": "Send daily translated Calvin and Hobbes Comics to Discord",
  "nodes": [
    {
      "id": "step-1",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "OpenAI",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "text": "Please write the original language and Korean together. \n\nEXAMPLE)\nCalvin: \"YOU'VE NEVER HAD AN OBLIGATION, AN ASSIGNMENT, OR A DEADLINE IN ALL YOUR LIFE! YOU HAVE NO RESPONSIBILITIES AT ALL! IT MUST BE NICE!\" (너는 평생 한 번도 의무, 과제, 혹은 마감일 없었잖아! 전혀 책임이 없다니! 정말 좋겠다!)\nHobbes: \"WIPE THAT INSOLENT SMIRK OFF YOUR FACE!\" (그 뻔뻔한 미소를 그만 지어!)\n",
        "modelId": {
          "configuration_input": "step-2-modelid"
        },
        "options": {},
        "resource": "image",
        "imageUrls": {
          "expression": "{{ record.output.cartoon_image }}"
        },
        "operation": "analyze"
      }
    },
    {
      "id": "step-3",
      "label": "param",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "year",
              "type": "string",
              "value": {
                "expression": "{{ current_time.format('yyyy') }}"
              }
            },
            {
              "name": "month",
              "type": "string",
              "value": {
                "expression": "{{ current_time.format('MM') }}"
              }
            },
            {
              "name": "day",
              "type": "string",
              "value": {
                "expression": "{{ current_time.format('dd') }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Discord",
      "operation": "service-write",
      "adapter": "discord",
      "parameters": {
        "content": {
          "expression": "Daily Cartoon ({{ steps[\"step-3\"].record.year }}/{{ steps[\"step-3\"].record.month }}/{{ steps[\"step-3\"].record.day }})\n{{ steps[\"step-6\"].record.output.cartoon_image }}\n\n{{ record.content }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-6",
      "label": "Information Extractor",
      "operation": "extract-fields",
      "adapter": "model",
      "parameters": {
        "text": {
          "expression": "Please just extract the src value in the <img class=\"img-fluid Lazyloaded\"> tag from HTML below. I don't need anything other than the value.\n\ne.g.)\nEXAMPLE INPUT)\n<img class=\"img-fluid lazyloaded\" srcset=\"https://assets.amuniversal.com/5ed526b06e94013bda88005056a9545d 900w\" data-srcset=\"https://assets.amuniversal.com/5ed526b06e94013bda88005056a9545d 900w\" sizes=\"\n (min-width: 992px) 900px,\n (min-width: 768px) 600px,\n (min-width: 576px) 300px,\n 900px\" width=\"100%\" alt=\"Calvin and Hobbes Comic Strip for March 03, 2023 \" src=\"https://assets.amuniversal.com/5ed526b06e94013bda88005056a9545d\">\n\n\nEXAMPLE OUTPUT)\nhttps://assets.amuniversal.com/5ed526b06e94013bda88005056a9545d\n\n--\n(INPUT)\n{{ record.data }}"
        },
        "options": {},
        "attributes": {
          "attributes": [
            {
              "name": "cartoon_image",
              "description": "EXAMPLE OUTPUT) https://assets.amuniversal.com/***"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "HTTP Request",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://www.gocomics.com/calvinandhobbes/{{ record.year }}/{{ record.month }}/{{ record.day }}"
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-3",
      "to": "step-7",
