{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-qualify-new-leads-in-google-sheets-via-muse-s-muse-83acf8",
  "title": "Qualify new leads in Google Sheets via OpenAI s GPT-4",
  "nodes": [
    {
      "id": "step-1",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {
        "mode": "combine",
        "options": {},
        "combinationMode": "mergeByPosition"
      }
    },
    {
      "id": "step-2",
      "label": "Update lead status",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "Rating": {
              "expression": "{{ record.reply.rating }}"
            },
            "Timestamp": {
              "expression": "{{ record.Timestamp }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "removed": false,
              "required": false,
              "displayName": "Timestamp",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "required": false,
              "displayName": "Email Address",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "required": false,
              "displayName": "Your name",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "required": false,
              "displayName": "Your business area",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "required": false,
              "displayName": "Your team size",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "Rating",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": true,
              "readOnly": true,
              "required": false,
              "displayName": "row_number",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "Timestamp"
          ]
        },
        "options": {},
        "operation": "update",
        "sheetName": {
          "configuration_input": "step-2-sheetname"
        },
        "documentId": {
          "configuration_input": "step-2-documentid"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Extract JSON reply",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "reply",
              "type": "objectValue",
              "objectValue": {
                "expression": "{{ JSON.parse(record.message.content) }}"
              }
            }
          ]
        },
        "include": "selected",
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Qualify leads with GPT",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "Your task is to qualify incoming leads. Leads are form submissions to a closed community group. Use the following criteria for a quality lead:\n\n1. We are looking for decision makers who run companies or who have some teams. The bigger the team - the better. Basically, everyone with some level of responsibility should be accepted. This is the main criterion.\n2. Email from a non-standard domain. Ideally this should be a corporate domain, but this is a secondary criterion.\n\nPlease thing step by step whether a lead is quality or not?\n\nIf at least one of the criteria satisfy, reply with \"qualified\" in response. Otherwise reply \"not qualified\". Reply with a JSON of the following structure: {\"rating\":\"string\",\"explanation\":\"string\"}. Reply only with with the JSON and nothing more!"
            },
            {
              "content": {
                "expression": "Here's a lead info:\nName: {{ record['Your name'] }}\nEmail: {{ record['Email Address'] }}\nBusiness area: {{ record['Your business area'] }}\nSize of the team: {{ record['Your team size'] }}"
              }
            }
          ]
        },
        "options": {
          "temperature": 0.3
        },
        "resource": "chat",
        "chatModel": "gpt-4-turbo-preview"
      }
    },
    {
      "id": "step-5",
      "label": "Check for new entries",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "event": "rowAdded",
        "options": {},
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "sheetName": {
          "configuration_input": "step-5-sheetname"
        },
        "documentId": {
          "configuration_input": "step-5-documentid"
        }
      }
    }
  ],
  "edges": [
