{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-detect-toxic-language-in-telegram-messages-e9b593",
  "title": "Detect toxic language in Telegram messages",
  "nodes": [
    {
      "id": "step-1",
      "label": "Telegram Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message",
          "edited_message",
          "channel_post",
          "edited_channel_post"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "Google Perspective",
      "operation": "service-read",
      "adapter": "googleperspective",
      "parameters": {
        "text": {
          "expression": "{{record[\"message\"][\"text\"]}}"
        },
        "options": {
          "languages": "en"
        },
        "requestedAttributesUi": {
          "requestedAttributesValues": [
            {
              "attributeName": "identity_attack"
            },
            {
              "attributeName": "threat"
            },
            {
              "attributeName": "profanity"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": {
                "expression": "{{record[\"attributeScores\"][\"PROFANITY\"][\"summaryScore\"][\"value\"]}}"
              },
              "value2": 0.7,
              "operation": "larger"
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": "I don't tolerate toxic language!",
        "chatId": {
          "expression": "{{steps[\"step-1\"].json[\"message\"][\"chat\"][\"id\"]}}"
        },
        "additionalFields": {
          "reply_to_message_id": {
            "expression": "{{steps[\"step-1\"].json[\"message\"][\"message_id\"]}}"
          }
        }
      }
    },
    {
      "id": "step-5",
      "label": "NoOp",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    }
  ],
  "edges": [
    {
      "from": "step-3",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
