    {
      "id": "step-22",
      "label": "Qdrant Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "qdrantCollection": {
          "expression": "trustpilot_reviews"
        }
      }
