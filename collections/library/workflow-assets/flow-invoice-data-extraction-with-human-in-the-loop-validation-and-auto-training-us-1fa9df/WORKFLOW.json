{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-invoice-data-extraction-with-human-in-the-loop-validation-and-auto-training-us-1fa9df",
  "title": "Invoice data extraction with human-in-the-loop validation and auto-training using Cradl AI",
  "nodes": [
    {
      "id": "step-1",
      "label": "Gmail Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "simple": false,
        "filters": {
          "q": "has:attachment subject:invoice",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true
        },
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Filter PDF attachments",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "let results = [];\n\nfor (const item of records) {\n  for (key of Object.keys(item.binary)) {\n     if (item.binary[key].fileExtension === \"pdf\") { \n      results.push({\n            json: {\n                fileName: item.binary[key].fileName,\n            },\n            binary: {\n                data: item.binary[key],\n            }\n        });\n       } \n    }\n  \n}\n\nreturn results;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Add invoice line to Google Sheets",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "operation": "append",
        "sheetName": {
          "configuration_input": "step-3-sheetname"
        },
        "documentId": {
          "configuration_input": "step-3-documentid"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Mark a message as read",
      "operation": "service-write",
      "adapter": "gmail",
      "parameters": {
        "messageId": {
          "expression": "{{ steps[\"step-1\"].record.id }}"
        },
        "operation": "markAsRead"
      }
    },
    {
      "id": "step-5",
      "label": "Extract invoice details with AI",
      "operation": "service-read",
      "adapter": "cradlai",
      "parameters": {
        "agentId": {
          "configuration_input": "step-5-agentid"
        },
        "documentBinaryData": "data"
      }
    },
    {
      "id": "step-6",
      "label": "Split out each invoice line",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "include": "allOtherFields",
        "options": {},
        "fieldToSplitOut": "body.output.invoice_lines"
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
