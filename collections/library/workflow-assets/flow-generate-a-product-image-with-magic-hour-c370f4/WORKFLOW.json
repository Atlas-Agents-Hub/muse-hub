{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-generate-a-product-image-with-magic-hour-c370f4",
  "title": "Generate a product image with Magic Hour",
  "nodes": [
    {
      "id": "step-1",
      "label": "Run manually",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Magic Hour",
      "operation": "service-read",
      "adapter": "magichour",
      "parameters": {
        "resource": "image",
        "operation": "generate",
        "imagePrompt": "A cobalt blue ceramic coffee mug on a plain cream studio background, clean ecommerce product photograph, no text.",
        "imageModel": "flux-2-klein",
        "imageResolution": "640px",
        "imageCount": 1,
        "imageAspectRatio": "1:1",
        "waitForCompletion": true,
        "additionalOptions": {
          "pollingInterval": 10,
          "maxWaitTime": 600
        }
      }
    },
    {
      "id": "step-3",
      "label": "Require complete",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.status }}"
              },
              "rightValue": "complete",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Download result",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ record.downloads[0].url }}"
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "step-5",
      "label": "Stop incomplete job",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "errorMessage": {
          "expression": "{{ \"Generation is \" + record.status + \". Keep project ID \" + record.id + \" and resume with Get Details. Do not create another generation to retrieve it.\" }}"
        }
      }
    }
  ],
