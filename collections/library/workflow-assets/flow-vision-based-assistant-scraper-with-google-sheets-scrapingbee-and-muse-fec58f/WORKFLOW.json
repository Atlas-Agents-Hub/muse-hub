      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-8-url"
        },
        "options": {},
        "sendQuery": true,
        "sendHeaders": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": {
                "configuration_input": "step-8-parameters-0-value"
