{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-muse-smart-webhook-ai-router-b23126",
  "title": "Muse Smart Webhook AI Router",
  "nodes": [
    {
      "id": "step-1",
      "label": "Incoming Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-router",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Model Classifier",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-2-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": {
                "configuration_input": "step-2-parameters-0-value"
              }
            },
            {
              "name": "anthropic-version",
              "value": {
                "configuration_input": "step-2-parameters-1-value"
              }
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"model\": \"claude-haiku-4-5\",\n  \"max_tokens\": 100,\n  \"system\": \"You are a request classifier. Analyze the incoming request and respond with ONLY a JSON object: {\\\"route\\\": \\\"<route_name>\\\", \\\"priority\\\": \\\"high|medium|low\\\", \\\"summary\\\": \\\"<one sentence>\\\"}\\n\\nAvailable routes: support, sales, technical, general\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Classify this request: {{ JSON.stringify(record.body || record) }}\"\n    }\n  ]\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Parse Classification",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Parse Claude's classification response\nconst rawText = records[0].json.content[0].text;\nlet classification;\n\ntry {\n  // Extract JSON from response\n  const jsonMatch = rawText.match(/\\{[^}]+\\}/);\n  classification = JSON.parse(jsonMatch[0]);\n} catch (e) {\n  classification = { route: 'general', priority: 'medium', summary: 'Unable to classify' };\n}\n\nreturn [{\n  json: {\n    route: classification.route || 'general',\n    priority: classification.priority || 'medium',\n    summary: classification.summary || '',\n    originalPayload: steps[\"step-1\"].records[0]\n  }\n}];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Route Switch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": {
                      "expression": "{{ record.route }}"
                    },
                    "rightValue": "support",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "support"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": {
                      "expression": "{{ record.route }}"
                    },
                    "rightValue": "technical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "technical"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": {
                      "expression": "{{ record.route }}"
                    },
                    "rightValue": "sales",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "sales"
            }
          ]
        },
        "fallbackOutput": "extra"
      }
    },
    {
      "id": "step-5",
      "label": "Return Route Result",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "expression": "{\n  \"received\": true,\n  \"route\": \"{{ steps[\"step-3\"].records[0].route }}\",\n  \"priority\": \"{{ steps[\"step-3\"].records[0].priority }}\",\n  \"summary\": \"{{ steps[\"step-3\"].records[0].summary }}\"\n}"
        },
        "options": {}
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
