      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-3",
      "channel": "data",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-3",
      "to": "step-5",
      "channel": "data",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
