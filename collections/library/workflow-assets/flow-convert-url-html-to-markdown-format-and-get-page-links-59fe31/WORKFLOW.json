{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-convert-url-html-to-markdown-format-and-get-page-links-59fe31",
  "title": "Convert URL HTML to Markdown Format and Get Page Links",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Wait",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 45
      }
    },
    {
      "id": "step-3",
      "label": "Connect to your own data source",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Get urls from own data source",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Example fields from data source",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "Page",
              "type": "array",
              "value": {
                "json": [
                  {
                    "configuration_input": "step-5-value-body-0"
                  },
                  {
                    "configuration_input": "step-5-value-body-1"
                  }
                ]
              }
            }
          ]
        },
        "includeOtherFields": true
      }
    },
    {
      "id": "step-6",
      "label": "40 items at a time",
      "operation": "limit",
      "adapter": "local",
      "parameters": {
        "maxItems": 40
      }
    },
    {
      "id": "step-7",
      "label": "10 at a time",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "batchSize": 10
      }
    },
    {
      "id": "step-8",
      "label": "Markdown data and Links",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "title",
              "type": "string",
              "value": {
                "expression": "{{ record.data.metadata.title }}"
              }
            },
            {
              "name": "description",
              "type": "string",
              "value": {
                "expression": "{{ record.data.metadata.description }}"
              }
            },
            {
              "name": "content",
              "type": "string",
              "value": {
                "expression": "{{ record.data.markdown }}"
              }
            },
            {
              "name": "links",
              "type": "string",
              "value": {
                "expression": "{{ record.data.links }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Split out page URLs",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "Page"
      }
    },
    {
      "id": "step-10",
      "label": "Retrieve Page Markdown and Links",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-10-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"url\": \"{{ record.Page }}\",\n \"formats\" : [\"markdown\", \"links\"]\n}"
        },
        "sendBody": true,
        "sendHeaders": true,
        "specifyBody": "json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      }
    }
  ],
