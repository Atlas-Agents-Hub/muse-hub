{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-telegram-bot-with-supabase-memory-and-muse-assistant-integration-dfbd31",
  "title": "Telegram Bot with Supabase memory and Muse assistant integration",
  "nodes": [
    {
      "id": "step-1",
      "label": "Get New Message",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      }
    },
    {
      "id": "step-2",
      "label": "Model - Create thread",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-2-url"
        },
        "method": "POST",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Beta",
              "value": "assistants=v2"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Create User",
      "operation": "service-read",
      "adapter": "supabase",
      "parameters": {
        "tableId": {
          "configuration_input": "step-3-tableid"
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "telegram_id",
              "fieldValue": {
                "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
              }
            },
            {
              "fieldId": "openai_thread_id",
              "fieldValue": {
                "expression": "{{ steps[\"step-2\"].record.id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Merge",
      "operation": "join",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Model - Send message",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.openai.com/v1/threads/{{ steps[\"step-4\"].record.openai_thread_id }}/messages"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "role",
              "value": "user"
            },
            {
              "name": "content",
              "value": {
                "expression": "{{ steps[\"step-1\"].record.message.text }}"
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Beta",
              "value": "assistants=v2"
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Model - Run assistant",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.openai.com/v1/threads/{{ steps[\"step-4\"].record.openai_thread_id }}/runs"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "sendHeaders": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "assistant_id",
              "value": {
                "configuration_input": "step-6-parameters-0-value"
              }
            },
            {
              "name": "stream",
              "value": {
                "expression": "{{true}}"
              }
            }
          ]
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Beta",
              "value": "assistants=v2"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Model - Get messages",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.openai.com/v1/threads/{{ steps[\"step-4\"].record.openai_thread_id }}/messages"
        },
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "OpenAI-Beta",
              "value": "assistants=v2"
            }
          ]
        }
      }
    },
    {
      "id": "step-8",
      "label": "Send Message to User",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "text": {
          "expression": "{{ steps[\"step-7\"].record.data[0].content[0].text.value }}"
        },
        "chatId": {
          "expression": "{{ steps[\"step-1\"].record.message.chat.id }}"
        },
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "step-9",
      "label": "If User exists",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record.id }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Find User",
      "operation": "service-read",
      "adapter": "supabase",
      "parameters": {
        "filters": {
          "conditions": [
            {
              "keyName": "telegram_id",
              "keyValue": {
                "expression": "{{ record.message.chat.id }}"
              },
              "condition": "eq"
            }
          ]
        },
        "tableId": {
          "configuration_input": "step-10-tableid"
        },
        "operation": "getAll"
      }
    }
  ],
