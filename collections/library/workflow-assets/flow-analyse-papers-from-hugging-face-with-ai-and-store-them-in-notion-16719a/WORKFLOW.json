{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-analyse-papers-from-hugging-face-with-ai-and-store-them-in-notion-16719a",
  "title": "Analyse papers from Hugging Face with AI and store them in Notion",
  "nodes": [
    {
      "id": "step-1",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1,
                2,
                3,
                4,
                5
              ],
              "triggerAtHour": 8
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "object",
                "operation": "empty",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ record }}"
              },
              "rightValue": ""
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Loop Over Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {
          "reset": false
        }
      }
    },
    {
      "id": "step-4",
      "label": "Split Out",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldToSplitOut": "url, url"
      }
    },
    {
      "id": "step-5",
      "label": "Request Hugging Face Paper",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "date",
              "value": {
                "expression": "{{ current_time.minus(1,'days').format('yyyy-MM-dd') }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-6",
      "label": "Extract Hugging Face Paper",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "url",
              "attribute": "href",
              "cssSelector": ".line-clamp-3",
              "returnArray": true,
              "returnValue": "attribute"
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Check Paper URL Existed",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "filters": {
          "conditions": [
            {
              "key": "URL|url",
              "urlValue": {
                "expression": "{{ 'https://huggingface.co'+record.url }}"
              },
              "condition": "equals"
            }
          ]
        },
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "configuration_input": "step-7-databaseid"
        },
        "filterType": "manual"
      }
    },
    {
      "id": "step-8",
      "label": "Request Hugging Face Paper Detail",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "{{ 'https://huggingface.co'+steps[\"step-4\"].record.url }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-9",
      "label": "Model Analysis Abstract",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-9-modelid"
        },
        "options": {},
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Extract the following key details from the paper abstract:\n\nCore Introduction: Summarize the main contributions and objectives of the paper, highlighting its innovations and significance.\nKeyword Extraction: List 2-5 keywords that best represent the research direction and techniques of the paper.\nKey Data and Results: Extract important performance metrics, comparison results, and the paper's advantages over other studies.\nTechnical Details: Provide a brief overview of the methods, optimization techniques, and datasets mentioned in the paper.\nClassification: Assign an appropriate academic classification based on the content of the paper.\n\n\nOutput as json：\n{\n \"Core_Introduction\": \"PaSa is an advanced Paper Search agent powered by large language models that can autonomously perform a series of decisions (including invoking search tools, reading papers, and selecting relevant references) to provide comprehensive and accurate results for complex academic queries.\",\n \"Keywords\": [\n \"Paper Search Agent\",\n \"Large Language Models\",\n \"Reinforcement Learning\",\n \"Academic Queries\",\n \"Performance Benchmarking\"\n ],\n \"Data_and_Results\": \"PaSa outperforms existing baselines (such as Google, GPT-4, chatGPT) in tests using AutoScholarQuery (35k academic queries) and RealScholarQuery (real-world academic queries). For example, PaSa-7B exceeds Google with GPT-4o by 37.78% in recall@20 and 39.90% in recall@50.\",\n \"Technical_Details\": \"PaSa is optimized using reinforcement learning with the AutoScholarQuery synthetic dataset, demonstrating superior performance in multiple benchmarks.\",\n \"Classification\": [\n \"Artificial Intelligence (AI)\",\n \"Academic Search and Information Retrieval\",\n \"Natural Language Processing (NLP)\",\n \"Reinforcement Learning\"\n ]\n}\n```"
            },
            {
              "content": {
                "expression": "{{ record.abstract }}"
              }
            }
          ]
        },
        "jsonOutput": true
      }
    },
    {
      "id": "step-10",
      "label": "Store Abstract Notion",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "options": {},
        "resource": "databasePage",
        "databaseId": {
          "configuration_input": "step-10-databaseid"
        },
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "URL|url",
              "urlValue": {
                "expression": "{{ 'https://huggingface.co'+steps[\"step-4\"].record.url }}"
              }
            },
            {
              "key": "title|title",
              "title": {
                "expression": "{{ steps[\"step-11\"].record.title }}"
              }
            },
            {
              "key": "abstract|rich_text",
              "textContent": {
                "expression": "{{ steps[\"step-11\"].record.abstract.substring(0,2000) }}"
              }
            },
            {
              "key": "scrap-date|date",
              "date": {
                "expression": "{{ current_date.format('yyyy-MM-dd') }}"
              },
              "includeTime": false
            },
            {
              "key": "Classification|rich_text",
              "textContent": {
                "expression": "{{ record.message.content.Classification.join(',') }}"
              }
            },
            {
              "key": "Technical_Details|rich_text",
              "textContent": {
                "expression": "{{ record.message.content.Technical_Details }}"
              }
            },
            {
              "key": "Data_and_Results|rich_text",
              "textContent": {
                "expression": "{{ record.message.content.Data_and_Results }}"
              }
            },
            {
              "key": "keywords|rich_text",
              "textContent": {
                "expression": "{{ record.message.content.Keywords.join(',') }}"
              }
            },
            {
              "key": "Core Introduction|rich_text",
              "textContent": {
                "expression": "{{ record.message.content.Core_Introduction }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-11",
      "label": "Extract Hugging Face Paper Abstract",
      "operation": "parse",
      "adapter": "local",
      "parameters": {
        "options": {},
        "operation": "extractHtmlContent",
        "extractionValues": {
          "values": [
            {
              "key": "abstract",
              "cssSelector": ".text-gray-700"
            },
            {
              "key": "title",
              "cssSelector": ".text-2xl"
            }
          ]
        }
      }
    }
  ],
