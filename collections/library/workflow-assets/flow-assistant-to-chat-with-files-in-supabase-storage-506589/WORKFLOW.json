  "title": "Assistant To Chat With Files In Supabase Storage",
  "nodes": [
    {
      "id": "step-1",
      "label": "Get All files",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://yqtvdcvjboenlblgcivl.supabase.co/storage/v1/object/list/private"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"prefix\": \"\",\n \"limit\": 100,\n \"offset\": 0,\n \"sortBy\": {\n \"column\": \"name\",\n \"order\": \"asc\"\n }\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    },
    {
      "id": "step-2",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": {
                  "expression": "file_id"
                },
                "value": {
                  "expression": "{{ record.id }}"
                }
              }
            ]
          }
        },
        "jsonData": {
          "expression": "{{ steps[\"step-20\"].record.data ?? steps[\"step-20\"].record.text }}"
        },
        "jsonMode": "expressionData"
      }
    },
    {
      "id": "step-3",
      "label": "Recursive Character Text Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
