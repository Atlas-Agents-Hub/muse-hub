          "configuration_input": "step-6-tableid"
        },
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "name",
              "fieldValue": {
                "expression": "{{ steps[\"step-10\"].record.name }}"
              }
            },
            {
              "fieldId": "storage_id",
              "fieldValue": {
                "expression": "{{ steps[\"step-10\"].record.id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Choose the next branch",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": {
                "expression": "{{ \n !steps[\"step-12\"].record.data || \n !Array.isArray(steps[\"step-12\"].record.data) || \n !steps[\"step-12\"].record.data.some(item => \n item.storage_id === steps[\"step-10\"].record.id \n ) \n}}"
              },
              "rightValue": ""
            },
            {
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "leftValue": {
                "expression": "{{ record.name }}"
              },
              "rightValue": ".emptyFolderPlaceholder"
