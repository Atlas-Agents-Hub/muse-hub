          "expression": "{{\n steps[\"step-23\"].record.path.replace(\n steps[\"step-23\"].record.path.split('/').last(),\n steps[\"step-23\"].record.filename.substring(0,21) + '...' + steps[\"step-11\"].record.title + '.md'\n )\n}}"
