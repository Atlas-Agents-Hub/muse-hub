    {
      "id": "step-2",
      "label": "Convert education to HTML",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": {
          "language": "javascript",
          "reference": "function convertToHTML(list) {\n let html = '';\n\n list.forEach((education, index) => {\n if (index > 0) {\n html += '<br /><br />'; // Add a new line if it's not the first item\n }\n html += `<b>Institution:</b> ${education.institution}<br />\n<b>Start year:</b> ${education.start_year}<br />\n<b>Degree:</b> ${education.degree}`;\n });\n\n return html;\n}\n\n// Assuming payload is already defined\nconst payload = record.json.education;\n\nconst htmlOutput = convertToHTML(payload);\nreturn {\n htmlOutput\n};",
          "inputs": "records, record, and named steps"
        }
      }
    },
