{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-query-perplexity-ai-from-your-muse-workflows-289137",
  "title": "Query Perplexity AI from your Muse workflows",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Set Params",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "system_prompt",
              "type": "string",
              "value": "You are an n8n fanboy."
            },
            {
              "name": "user_prompt",
              "type": "string",
              "value": "What are the differences between n8n and Make?"
            },
            {
              "name": "domains",
              "type": "string",
              "value": "n8n.io, make.com"
            }
          ]
        }
      }
    },
    {
      "id": "step-3",
      "label": "Clean Output",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "output",
              "type": "string",
              "value": {
                "expression": "{{ record.choices[0].message.content }}"
              }
            },
            {
              "name": "citations",
              "type": "array",
              "value": {
                "expression": "{{ record.citations }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Perplexity Request",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-4-url"
        },
        "method": "POST",
        "options": {},
        "jsonBody": {
          "expression": "{\n \"model\": \"sonar\",\n \"messages\": [\n {\n \"role\": \"system\",\n \"content\": \"{{ record.system_prompt }}\"\n },\n {\n \"role\": \"user\",\n \"content\": \"{{ record.user_prompt }}\"\n }\n ],\n \"temperature\": 0.2,\n \"top_p\": 0.9,\n \"search_domain_filter\": {{ (JSON.stringify(record.domains.split(','))) }},\n \"return_images\": false,\n \"return_related_questions\": false,\n \"search_recency_filter\": \"month\",\n \"top_k\": 0,\n \"stream\": false,\n \"presence_penalty\": 0,\n \"frequency_penalty\": 1,\n \"response_format\": null\n}"
        },
        "sendBody": true,
        "specifyBody": "json"
      }
    }
  ],
  "edges": [
    {
      "from": "step-2",
      "to": "step-4",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-4",
      "to": "step-3",
      "channel": "main",
      "branch": 0,
      "input": 0
    },
    {
      "from": "step-1",
      "to": "step-2",
      "channel": "main",
      "branch": 0,
      "input": 0
    }
  ],
  "terminal_branches": [],
  "entrypoints": [
    "step-1"
  ],
  "configuration": [
    {
      "id": "step-4-url",
      "purpose": "Set the url endpoint or source URL for this operation.",
      "required": true,
      "endpoint_template": "https://api.perplexity.ai/chat/completions"
    }
  ],
