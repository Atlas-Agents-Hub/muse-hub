  "id": "flow-upsert-huge-documents-in-a-vector-store-with-supabase-and-notion-7fbd53",
  "title": "Upsert huge documents in a vector store with Supabase and Notion",
  "nodes": [
    {
      "id": "step-1",
      "label": "Embeddings OpenAI",
      "operation": "embed",
      "adapter": "embedding",
      "parameters": {
        "capability": "text embeddings",
        "settings": {}
      }
    },
    {
      "id": "step-2",
      "label": "Token Splitter",
      "operation": "chunk",
      "adapter": "local",
      "parameters": {
        "chunkSize": 500
      }
    },
    {
      "id": "step-3",
      "label": "Loop Over Items",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Question and Answer Chain",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Vector Store Retriever",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {}
    },
    {
      "id": "step-6",
      "label": "OpenAI Chat Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {}
      }
    },
    {
      "id": "step-7",
      "label": "When chat message received",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "public": true,
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Schedule Trigger",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Limit",
      "operation": "limit",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-10",
      "label": "Limit1",
      "operation": "limit",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-11",
      "label": "Delete old embeddings if exist",
      "operation": "service-write",
      "adapter": "supabase",
      "parameters": {
        "tableId": {
          "configuration_input": "step-11-tableid"
        },
        "operation": "delete",
        "filterType": "string",
        "filterString": {
          "expression": "metadata->>id=eq.{{ steps[\"step-14\"].record.id }}"
        }
      }
    },
    {
      "id": "step-12",
      "label": "Get page blocks",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "blockId": {
          "expression": "{{ steps[\"step-14\"].record.id }}"
        },
        "resource": "block",
        "operation": "getAll",
        "returnAll": true,
        "fetchNestedBlocks": true
      }
    },
    {
      "id": "step-13",
      "label": "Default Data Loader",
      "operation": "extract-document",
      "adapter": "local",
      "parameters": {
        "options": {
          "metadata": {
            "metadataValues": [
              {
                "name": "id",
                "value": {
                  "expression": "{{ steps[\"step-14\"].record.id }}"
                }
              },
              {
                "name": "name",
                "value": {
                  "expression": "{{ steps[\"step-14\"].record.name }}"
                }
              }
            ]
          }
        }
      }
    },
    {
      "id": "step-14",
      "label": "Input Reference",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {}
    },
    {
      "id": "step-15",
      "label": "Notion Trigger",
      "operation": "inspect",
      "adapter": "local",
      "parameters": {
        "bypass": true,
        "instruction": "Pass the incoming records to the next connected operation."
      }
    },
    {
      "id": "step-16",
      "label": "Get updated pages",
      "operation": "service-read",
      "adapter": "notion",
      "parameters": {
        "filters": {
          "conditions": [
            {
              "key": "Last edited time|last_edited_time",
              "condition": "equals",
              "lastEditedTime": {
                "expression": "{{ current_time.minus(1, 'minutes').toISO() }}"
              }
            }
          ]
        },
        "options": {},
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "configuration_input": "step-16-databaseid"
        },
        "filterType": "manual"
      }
    },
    {
      "id": "step-17",
      "label": "Supabase Vector Store1",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "options": {},
        "tableName": {
          "configuration_input": "step-17-tablename"
        }
      }
    },
    {
      "id": "step-18",
      "label": "Supabase Vector Store",
      "operation": "retrieve",
      "adapter": "vector-store",
      "parameters": {
        "mode": "insert",
        "options": {},
        "tableName": {
          "configuration_input": "step-18-tablename"
        }
      }
    },
    {
      "id": "step-19",
      "label": "Concatenate to single string",
      "operation": "aggregate",
      "adapter": "local",
      "parameters": {
        "options": {},
        "fieldsToSummarize": {
          "values": [
            {
              "field": "content",
              "separateBy": "\n",
              "aggregation": "concatenate"
            }
          ]
        }
      }
    }
  ],
