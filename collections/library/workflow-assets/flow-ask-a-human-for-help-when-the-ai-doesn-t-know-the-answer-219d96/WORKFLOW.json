{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-ask-a-human-for-help-when-the-ai-doesn-t-know-the-answer-219d96",
  "title": "Ask a human for help when the AI doesn t know the answer",
  "nodes": [
    {
      "id": "step-1",
      "label": "Window Buffer Memory",
      "operation": "session",
      "adapter": "session-store",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Not sure?",
      "operation": "service-read",
      "adapter": "workflow",
      "parameters": {
        "name": "dont_know_tool",
        "fields": {
          "values": [
            {
              "name": "chatInput",
              "stringValue": {
                "expression": "{{ steps[\"step-4\"].record.chatInput }}"
              }
            }
          ]
        },
        "workflowId": {
          "expression": "{{ workflow_id}}"
        },
        "description": "Use this tool if you don't know the answer to the user's question, or if you're not very confident about your answer."
      }
    },
    {
      "id": "step-3",
      "label": "Execute Workflow Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-4",
      "label": "Chat Trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-5",
      "label": "Prompt the user to provide an email",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "response = {\"response\":\"I'm sorry I don't know the answer. Please repeat your question and include your email address so I can request help.\"};\nreturn response;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-6",
      "label": "Confirm that we've messaged a human",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "response = {\"response\": \"Thank you for getting in touch. I've messaged a human to help.\"}\nreturn response;",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-7",
      "label": "AI Agent",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "options": {
          "systemMessage": "Try to answer the user's question. When you can't answer, or you're not confident of the answer, use the appropriate tool. When you use the dont_know_tool, respond with the message from the tool."
        }
      }
    },
    {
      "id": "step-8",
      "label": "Check if user has provided email",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "options": {},
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "string",
                "operation": "regex"
              },
              "leftValue": {
                "expression": "{{ steps[\"step-3\"].record.chatInput }}"
              },
              "rightValue": "/([a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+\\.[a-zA-Z0-9_-]+)/gi"
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Message Slack for help",
      "operation": "service-write",
      "adapter": "slack",
      "parameters": {
        "text": {
          "expression": "{{ \"A user had a question the bot couldn't answer. Here's their message: \" + steps[\"step-3\"].record.chatInput }}"
        },
        "select": "channel",
        "channelId": {
          "configuration_input": "step-9-channelid"
        },
        "otherOptions": {}
      }
    },
    {
      "id": "step-10",
      "label": "Model",
      "operation": "model",
      "adapter": "model",
      "parameters": {
        "capability": "text generation",
        "settings": {
          "temperature": 0.2
        }
      }
    }
  ],
