{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-generate-content-with-ai-agents-through-a-qa-gate-and-human-approval-before-pu-2663eb",
  "title": "Generate content with AI agents through a QA gate and human approval before publishing",
  "nodes": [
    {
      "id": "step-1",
      "label": "Webhook / weekly schedule: topics",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "content-run",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Config",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-2-assignments-0-value"
              },
              "type": "string"
            },
            {
              "name": "auto_approve_in_test",
              "value": true,
              "type": "boolean"
            },
            {
              "name": "min_words",
              "value": 120,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "One item per topic",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const body = records[0].json.body || records[0].json;\nconst topics = Array.isArray(body.topics) ? body.topics : String(body.topics || '').split(',').map(s => s.trim()).filter(Boolean);\nif (!topics.length) throw new Error('No topics supplied');\nconst cfg = steps[\"step-2\"].records[0];\nreturn topics.map(t => ({ json: { topic: t, run_id: body.run_id || ('run-' + Date.now()), base: cfg.base, auto_approve: cfg.auto_approve_in_test, min_words: cfg.min_words } }));",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Loop topics",
      "operation": "batch",
      "adapter": "local",
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Agent 1 · Research (search API)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.base }}/search"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ query: record.topic, recency_days: 90 }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Agent 2 · Outline (LLM)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-4\"].record.base }}/llm/complete"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ task: 'outline', input: { topic: steps[\"step-4\"].record.topic, sources: record.results } }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-7",
      "label": "Agent 3 · Draft (LLM)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-4\"].record.base }}/llm/complete"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ task: 'draft', input: { topic: steps[\"step-4\"].record.topic, title: record.output.title, sections: record.output.sections, sources: steps[\"step-5\"].record.results } }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-8",
      "label": "Agent 4 · QA gate (deterministic checks)",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Deterministic QA gate, the model writes, code checks. Never publish on the model's say-so alone.\nconst d = records[0].json.output;\nconst cfg = steps[\"step-4\"].record;\nconst body = d.body || '';\nconst issues = [];\nconst words = body.split(/\\s+/).filter(Boolean).length;\nif (words < cfg.min_words) issues.push(`too short (${words} < ${cfg.min_words})`);\nif (!/Sources:/.test(body)) issues.push('no sources section');\nfor (const bad of ['guaranteed', 'risk-free', '100%', 'best in the world']) if (body.toLowerCase().includes(bad)) issues.push('banned claim: ' + bad);\nconst required = ['Why it matters now', 'What to do this quarter'];\nfor (const r of required) if (!body.includes('## ' + r)) issues.push('missing section: ' + r);\nconst srcCount = (body.match(/https?:\\/\\//g) || []).length;\nif (srcCount < 2) issues.push('fewer than 2 source links');\nconst usage = [steps[\"step-6\"].record.usage, records[0].json.usage].reduce((a,u)=>({input_tokens:a.input_tokens+(u?.input_tokens||0), output_tokens:a.output_tokens+(u?.output_tokens||0)}), {input_tokens:0, output_tokens:0});\nreturn [{ json: { topic: cfg.topic, run_id: cfg.run_id, title: d.title, body, words, qa_pass: issues.length === 0, issues, usage, est_cost_usd: +((usage.input_tokens*3 + usage.output_tokens*15)/1e6).toFixed(4), base: cfg.base, auto_approve: cfg.auto_approve } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-9",
      "label": "QA passed?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.qa_pass }}"
              },
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-10",
      "label": "Human approval (Slack)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#content-approvals', text: 'APPROVE? ' + record.title + ' (' + record.words + ' words, est. $' + record.est_cost_usd + ')', approval: record.auto_approve ? 'auto-approved' : 'awaiting human' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-11",
      "label": "Publish as draft (Google Docs / CMS)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-8\"].record.base }}/publish/doc"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ title: steps[\"step-8\"].record.title, body: steps[\"step-8\"].record.body, status: 'draft' }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-12",
      "label": "Send back with reasons (no publish)",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ record.base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#content-qa-failed', text: 'QA FAILED: ' + record.title + ', ' + record.issues.join('; ') }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-13",
      "label": "Run log row",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const q = steps[\"step-8\"].record;\nconst pub = records[0].json;\nreturn [{ json: { topic: q.topic, title: q.title, words: q.words, qa_pass: q.qa_pass, issues: q.issues, published_url: pub.url || null, est_cost_usd: q.est_cost_usd, tokens: q.usage } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-14",
      "label": "Run summary (respond)",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "const rows = records.map(i => i.json);\nreturn [{ json: { run_id: rows[0]?.run_id, topics: rows.length, published: rows.filter(r => r.published_url).length, failed_qa: rows.filter(r => !r.qa_pass).map(r => ({ title: r.title, issues: r.issues })), est_cost_usd: +rows.reduce((a,r)=>a+(r.est_cost_usd||0),0).toFixed(4), results: rows } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-15",
      "label": "Error trigger",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-16",
      "label": "Alert ops",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "expression": "{{ steps[\"step-17\"].records[0].base }}/alerts"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{{ JSON.stringify({ channel: '#ops-alerts', text: 'Content pipeline failed: ' + (record.execution?.error?.message || 'unknown') }) }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-17",
      "label": "Config (errors)",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "base",
              "value": {
                "configuration_input": "step-17-assignments-0-value"
              },
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    }
  ],
