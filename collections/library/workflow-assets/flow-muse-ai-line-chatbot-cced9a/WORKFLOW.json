{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-muse-ai-line-chatbot-cced9a",
  "title": "Claude AI LINE Chatbot",
  "nodes": [
    {
      "id": "step-1",
      "label": "LINE Webhook",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "claude-line-bot",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Extract Message",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Validate LINE signature and extract message\nconst body = records[0].json;\nconst events = body.events || [];\n\nconst textEvent = events.find(\n  e => e.type === 'message' && e.message?.type === 'text'\n);\n\nif (!textEvent) {\n  // Non-text event (sticker, image, etc.) — skip\n  return [];\n}\n\nreturn [{\n  json: {\n    userId: textEvent.source.userId,\n    replyToken: textEvent.replyToken,\n    userMessage: textEvent.message.text\n  }\n}];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Ask Claude",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-3-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": {
                "configuration_input": "step-3-parameters-0-value"
              }
            },
            {
              "name": "anthropic-version",
              "value": {
                "configuration_input": "step-3-parameters-1-value"
              }
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"model\": \"claude-opus-4-5\",\n  \"max_tokens\": 500,\n  \"system\": \"You are a helpful assistant. Reply concisely in the same language the user writes in.\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ record.userMessage }}\"\n    }\n  ]\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-4",
      "label": "Reply via LINE",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-4-url"
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": {
                "configuration_input": "step-4-parameters-0-value"
              }
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"replyToken\": \"{{ steps[\"step-2\"].records[0].replyToken }}\",\n  \"messages\": [\n    {\n      \"type\": \"text\",\n      \"text\": \"{{ record.content[0].text }}\"\n    }\n  ]\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Return 200",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "text",
        "responseBody": "OK",
        "options": {}
      }
    }
  ],
