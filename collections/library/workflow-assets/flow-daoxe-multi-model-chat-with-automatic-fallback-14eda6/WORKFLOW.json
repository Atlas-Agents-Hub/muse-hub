        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"model\": {{ JSON.stringify(record.primary_model) }},\n  \"messages\": [\n    { \"role\": \"system\", \"content\": {{ JSON.stringify(record.system) }} },\n    { \"role\": \"user\", \"content\": {{ JSON.stringify(record.prompt) }} }\n  ]\n}"
        },
        "options": {}
