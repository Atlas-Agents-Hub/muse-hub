{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-automate-content-generator-for-wordpress-with-muse-r1-c70bb3",
  "title": "Automate Content Generator for WordPress with DeepSeek R1",
  "nodes": [
    {
      "id": "step-1",
      "label": "When clicking ‘Test workflow’",
      "operation": "input",
      "adapter": "muse",
      "parameters": {}
    },
    {
      "id": "step-2",
      "label": "Get Ideas",
      "operation": "service-read",
      "adapter": "googlesheets",
      "parameters": {
        "options": {},
        "sheetName": {
          "expression": "Sheet1"
        },
        "documentId": {
          "configuration_input": "step-2-documentid"
        }
      }
    },
    {
      "id": "step-3",
      "label": "Set your prompt",
      "operation": "map-fields",
      "adapter": "local",
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "name": "prompt",
              "type": "string",
              "value": {
                "expression": "{{ record.PROMPT }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-4",
      "label": "Create post on Wordpress",
      "operation": "service-write",
      "adapter": "wordpress",
      "parameters": {
        "title": {
          "expression": "{{ record.message.content }}"
        },
        "additionalFields": {
          "status": "draft",
          "content": {
            "expression": "{{ steps[\"step-8\"].record.message.content }}"
          }
        }
      }
    },
    {
      "id": "step-5",
      "label": "Upload image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "configuration_input": "step-5-url"
        },
        "method": "POST",
        "options": {},
        "sendBody": true,
        "contentType": "binaryData",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Disposition",
              "value": {
                "expression": "attachment; filename=\"copertina-{{ steps[\"step-4\"].record.id }}.jpg\""
              }
            }
          ]
        },
        "inputDataFieldName": "data"
      }
    },
    {
      "id": "step-6",
      "label": "Set Image",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://wp.test.7hype.com/wp-json/wp/v2/posts/{{ steps[\"step-4\"].record.id }}"
        },
        "method": "POST",
        "options": {},
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "featured_media",
              "value": {
                "expression": "{{ record.id }}"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-7",
      "label": "Update Sheet",
      "operation": "service-write",
      "adapter": "googlesheets",
      "parameters": {
        "columns": {
          "value": {
            "DATA": {
              "expression": "{{ current_time.format('dd/LL/yyyy') }}"
            },
            "TITOLO": {
              "expression": "{{ steps[\"step-9\"].record.message.content }}"
            },
            "ID POST": {
              "expression": "{{ steps[\"step-4\"].record.id }}"
            },
            "row_number": {
              "expression": "{{ steps[\"step-2\"].record.row_number }}"
            }
          },
          "schema": [
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "DATA",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "PROMPT",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "TITOLO",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "required": false,
              "displayName": "ID POST",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            },
            {
              "type": "string",
              "display": true,
              "removed": false,
              "readOnly": true,
              "required": false,
              "displayName": "row_number",
              "defaultMatch": false,
              "canBeUsedToMatch": true
            }
          ],
          "mappingMode": "defineBelow",
          "matchingColumns": [
            "row_number"
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {},
        "operation": "update",
        "sheetName": {
          "configuration_input": "step-7-sheetname"
        },
        "documentId": {
          "configuration_input": "step-7-documentid"
        }
      }
    },
    {
      "id": "step-8",
      "label": "Generate article with DeepSeek",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "expression": "deepseek-reasoner"
        },
        "options": {
          "maxTokens": 2048
        },
        "messages": {
          "values": [
            {
              "content": {
                "expression": "You are an SEO expert, write an article based on this topic:\n{{ record.prompt }}\n\nInstructions:\n- In the introduction, introduce the topic that will be explored in the rest of the text\n- The introduction should be about 120 words\n- The conclusions should be about 120 words\n- Use the conclusions to summarize everything said in the article and offer a conclusion to the reader\n- Write a maximum of 4-5 chapters and argue them.\n- The chapters should follow a logical flow and not repeat the same concepts.\n- The chapters should be related to each other and not isolated blocks of text. The text should flow and follow a linear logic.\n- Do not start chapters with \"Chapter 1\", \"Chapter 2\", \"Chapter 3\" ... write only the chapter title\n- For the text, use HTML for formatting, but limit yourself to bold, italics, paragraphs and lists.\n- Don't put the output in ```html but only text\n- Don't use markdown for formatting.\n- Go deeper into the topic you're talking about, don't just throw superficial information there\n- In output I want only the HTML format"
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-9",
      "label": "Generate title with DeepSeek",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "expression": "deepseek-reasoner"
        },
        "options": {
          "maxTokens": 2048
        },
        "messages": {
          "values": [
            {
              "content": {
                "expression": "You are an SEO Copywriter and you need to think of a title of maximum 60 characters for the following article:\n{{ record.message.content }}\n\nInstructions:\n- Use keywords contained in the article\n- Do not use any HTML characters\n- Output only the string containing the title.\n- Do not use quotation marks. The only special characters allowed are \":\" and \",\""
              }
            }
          ]
        }
      }
    },
    {
      "id": "step-10",
      "label": "Generate Image with DALL-E",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "prompt": {
          "expression": "Generate a real photographic image used as a cover for a blog post:\n\nImage prompt:\n{{ steps[\"step-9\"].record.message.content }}, photography, realistic, sigma 85mm f/1.4"
        },
        "options": {
          "size": "1792x1024",
          "style": "natural",
          "quality": "hd"
        },
        "resource": "image"
      }
    }
  ],
