{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-tunova-generate-a-song-via-webhook-6c70c0",
  "title": "Tunova - Generate a song via webhook",
  "nodes": [
    {
      "id": "step-1",
      "label": "POST /generate-song",
      "operation": "input",
      "adapter": "muse",
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-song",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "step-2",
      "label": "Tunova: start generation",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "method": "POST",
        "url": {
          "configuration_input": "step-2-url"
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "expression": "{\n  \"prompt\": {{ JSON.stringify(record.body.prompt) }},\n  \"instrumental\": {{ record.body.instrumental === true }}\n}"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Wait for render",
      "operation": "wait",
      "adapter": "local",
      "parameters": {
        "amount": 150,
        "unit": "seconds"
      }
    },
    {
      "id": "step-4",
      "label": "Tunova: get result",
      "operation": "http",
      "adapter": "http",
      "parameters": {
        "url": {
          "expression": "https://api.tunova.ai/api/jobs/{{ steps[\"step-2\"].record.job_id }}"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Return audio URL",
      "operation": "respond",
      "adapter": "muse",
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "expression": "{\n  \"status\": {{ JSON.stringify(record.status) }},\n  \"audio_url\": {{ JSON.stringify(record.clips?.[0]?.audio_url ?? null) }},\n  \"title\": {{ JSON.stringify(record.clips?.[0]?.title ?? null) }}\n}"
        },
        "options": {}
      }
    }
  ],
