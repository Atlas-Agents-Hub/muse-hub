{
  "schema": "muse-workflow-graph/v1",
  "id": "flow-daily-ai-digest-of-unread-emails-to-telegram-italian-fbd8af",
  "title": "Daily AI digest of unread emails to Telegram (Italian)",
  "nodes": [
    {
      "id": "step-1",
      "label": "Ogni mattina alle 8 (lun-ven)",
      "operation": "schedule",
      "adapter": "scheduler",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "step-2",
      "label": "Prendi email non lette",
      "operation": "service-read",
      "adapter": "gmail",
      "parameters": {
        "operation": "getAll",
        "returnAll": false,
        "limit": 25,
        "filters": {
          "q": "is:unread newer_than:1d -category:promotions -category:social"
        },
        "options": {}
      }
    },
    {
      "id": "step-3",
      "label": "Prepara testo per AI",
      "operation": "transform",
      "adapter": "local",
      "parameters": {
        "jsCode": {
          "language": "javascript",
          "reference": "// Compatta le email in un unico testo per l'AI\nconst righe = [];\n\nfor (const item of records) {\n  const e = item.json;\n  const da = e.from?.value?.[0]?.name || e.from?.value?.[0]?.address || e.From || 'Sconosciuto';\n  const oggetto = e.subject || e.Subject || '(senza oggetto)';\n  const anteprima = String(e.snippet || e.text || '').slice(0, 200).replace(/\\s+/g, ' ');\n  righe.push(`DA: ${da}\\nOGGETTO: ${oggetto}\\nANTEPRIMA: ${anteprima}\\n---`);\n}\n\nif (righe.length === 0) {\n  return [{ json: { vuoto: true, testoEmail: '' } }];\n}\n\nreturn [{ json: { vuoto: false, totale: righe.length, testoEmail: righe.join('\\n') } }];",
          "inputs": "records, record, and named steps"
        }
      }
    },
    {
      "id": "step-4",
      "label": "Ci sono email?",
      "operation": "branch",
      "adapter": "local",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": {
                "expression": "{{ record.vuoto }}"
              },
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "step-5",
      "label": "Riassumi con AI",
      "operation": "generate",
      "adapter": "model",
      "parameters": {
        "modelId": {
          "configuration_input": "step-5-modelid"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Sei l'assistente di un imprenditore italiano. Ricevi l'elenco delle email non lette e produci una rassegna mattutina in italiano, breve e pratica, in questo formato:\n\n🔴 URGENTI (rispondere oggi):\n- [mittente]: [cosa vuole in max 10 parole]\n\n🟡 IMPORTANTI (questa settimana):\n- ...\n\n⚪ IL RESTO:\n- una riga sola che raggruppa il resto\n\nSii sintetico. Se qualcosa sembra un cliente arrabbiato o un'opportunità di vendita, segnalalo per primo."
            },
            {
              "content": {
                "expression": "Ecco le {{ record.totale }} email non lette:\n\n{{ record.testoEmail }}"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "step-6",
      "label": "Invia rassegna su Telegram",
      "operation": "service-write",
      "adapter": "telegram",
      "parameters": {
        "chatId": {
          "configuration_input": "step-6-chatid"
        },
        "text": {
          "expression": "☕ *Rassegna email del {{ current_time.format('dd/MM') }}*\n\n{{ record.message?.content || record.output || record.text }}"
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      }
    }
  ],
  "edges": [
    {
      "from": "step-1",
      "to": "step-2",
