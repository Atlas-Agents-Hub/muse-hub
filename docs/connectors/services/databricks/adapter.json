          "type": "ProviderField"
        },
        {
          "description": "",
          "label": "Warehouse Id",
          "name": "warehouseId",
          "required": null,
          "source_expression": "databricksProps.warehouseId({ required: false, description: 'The SQL warehouse that runs COPY INTO. Required when Load into Table is set.', })",
          "type": "ProviderField"
        },
        {
          "description": "How the file is read when it is loaded into the table.",
          "label": "File Format",
          "name": "fileFormat",
          "required": false,
          "type": "StaticDropdown"
        },
        {
          "description": "When the file has columns the table does not, add them to the table instead of failing.",
          "label": "Add New Columns",
          "name": "shouldMergeSchema",
          "required": false,
          "type": "Checkbox"
        }
      ],
