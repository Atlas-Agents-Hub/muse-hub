      "description": "Uploads a file to a Unity Catalog volume and, optionally, loads it into a table with COPY INTO.",
      "id": "upload_file_to_volume",
      "inputs": [
        {
          "description": "",
          "label": "Catalog Name",
          "name": "catalogName",
          "required": null,
          "source_expression": "databricksProps.catalogName({ required: true })",
          "type": "ProviderField"
        },
        {
          "description": "",
          "label": "Schema Name",
          "name": "schemaName",
          "required": null,
          "source_expression": "databricksProps.schemaName({ required: true })",
          "type": "ProviderField"
        },
        {
          "description": "",
          "label": "Volume Name",
          "name": "volumeName",
          "required": null,
          "source_expression": "databricksProps.volumeName({ required: true })",
          "type": "ProviderField"
        },
        {
          "description": "The file to upload, e.g. a CSV or JSON file from an FTP, email or HTTP step.",
          "label": "File",
          "name": "file",
          "required": true,
          "type": "File"
        },
        {
          "description": "Optional folder inside the volume, e.g. imports/orders. It is created if it does not exist.",
          "label": "Folder",
          "name": "folder",
          "required": false,
          "type": "ShortText"
        },
        {
          "description": "",
          "label": "Table Name",
          "name": "tableName",
          "required": null,
