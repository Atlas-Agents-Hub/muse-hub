    {
      "description": "Triggers when a new lead or opportunity is created in Odoo CRM.",
      "id": "new_lead",
      "inputs": [
        {
          "description": "Leads only exist when \"Leads\" is turned on in CRM settings; otherwise every record is an opportunity. For leads, the type and team are checked while the record is new (until a record created more than 5 minutes later exists), so later changes do not fire. \"Opportunities only\" also fires when a lead is converted to an opportunity after the trigger was turned on, and checks the team on every poll, so an opportunity moved into the chosen team later fires then (once; the last 2,000 fired opportunities are remembered).",
          "label": "Type",
          "name": "lead_type",
          "required": false,
          "type": "StaticDropdown"
        },
        {
          "description": "",
          "label": "Team_Id",
          "name": "team_id",
          "required": null,
          "source_expression": "odooProps.fixedModelDropdown({ model: 'crm.team', displayName: 'Sales Team', description: 'Optional. Only fire for this sales team.', required: false, })",
          "type": "ProviderField"
        }
      ],
      "kind": "trigger",
      "name": "New Lead or Opportunity",
      "source_path": "odoo/src/lib/triggers/new-lead.ts",
      "source_sha256": "915c61ed418f5344aa03156f85e9525b954a1abdaf9a05af08a1b57a5d52ebbb",
      "source_url": "https://github.com/activepieces/activepieces/blob/5110199059649227b42a805020ab03ef429103aa/packages/pieces/community/odoo/src/lib/triggers/new-lead.ts"
    },
    {
      "description": "Triggers when a record is created or changed in any Odoo model. Odoo also counts automatic updates (computed fields, scheduled actions) as changes.",
      "id": "new_or_updated_record",
      "inputs": [
        {
          "description": "",
          "label": "Model",
          "name": "model",
          "required": null,
          "source_expression": "odooProps.modelDropdown()",
          "type": "ProviderField"
        },
        {
          "description": "Optional. Only fire for created or updated records that match this Odoo domain, for example [[\"is_company\", \"=\", true]]. Leave empty for every change. Archived records are included (so archiving a record fires it) unless the domain mentions active.",
          "label": "Filter domain",
          "name": "domain",
          "required": false,
          "type": "Json"
        },
        {
          "description": "Optional. Field names to return, for example name, email. Leave empty for all fields except files and images.",
          "label": "Fields",
          "name": "fields",
          "required": false,
          "type": "Array"
        }
      ],
      "kind": "trigger",
