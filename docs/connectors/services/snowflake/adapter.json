        "name": "role",
        "required": false,
        "type": "ShortText"
      }
    ],
    "method": "OAuth 2.0 account connection; Provider connection fields; API key or access token",
    "scopes": [
      "refresh_token"
    ],
    "token_urls": [
      "https://{account}.snowflakecomputing.com/oauth/token-request"
    ]
  },
