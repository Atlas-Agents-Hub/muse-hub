    {
      "description": "Execute a SQL query against your Snowflake database and return the results as rows.",
      "id": "runQuery",
      "inputs": [
        {
          "description": "The SQL statement to execute. Use `:1`, `:2`… or `?` as placeholders for the **Parameters** values below to safely pass dynamic values without SQL injection risk.",
          "label": "SQL Query",
          "name": "sqlText",
          "required": true,
          "type": "LongText"
        },
        {
          "description": "Values to bind to the placeholders (`:1`, `:2`…, or `?`) in the SQL query. Provide them in the same order they appear in the query. Using parameters is the safe way to pass dynamic values — never concatenate user input directly into the SQL.",
          "label": "Parameters",
          "name": "binds",
          "required": false,
          "type": "Array"
        },
        {
          "description": "Maximum time in milliseconds the query may run before Snowflake cancels it (applied as STATEMENT_TIMEOUT_IN_SECONDS, capped at 540 seconds). Defaults to 30 000 ms (30 seconds).",
          "label": "Query Timeout (ms)",
          "name": "timeout",
          "required": false,
          "type": "Number"
        },
        {
          "description": "An optional label sent to Snowflake to identify this client. Visible in query history under **Monitoring → Query History → Client Application**. Useful for auditing which automation triggered a query.",
          "label": "Application Name",
          "name": "application",
          "required": false,
          "type": "ShortText"
        }
      ],
