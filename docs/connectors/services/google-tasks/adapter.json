          "name": "previous_task_id",
          "required": false,
          "type": "ShortText"
        },
        {
          "description": "Move the task to this task list. Omit to keep it in the current list. Recurring tasks cannot be moved between lists.",
          "label": "Destination Task List ID",
          "name": "destination_tasklist_id",
          "required": false,
          "type": "ShortText"
        }
